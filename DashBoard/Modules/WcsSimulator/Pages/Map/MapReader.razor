@namespace Dashboard.Modules.WcsSimulator.Pages
@page "/wcs-simulator/map-reader"
@inject WcsApiClient WcsApi
@inherits Dashboard.Modules.WcsSimulator.Components.PageStateBase
@using System.Text.Json
@using System.IO.Compression
@using Dashboard.Modules.WcsSimulator.Models
@using Microsoft.JSInterop
@implements IDisposable

@* ════════════════════════════════════════════════
   页面职责：WCS 模拟器的「地图信息」页 —— 地图数据的中转站
   ① 接口读取：GET /api/Map/GetMap?sceneName=&getTypes=feMap 下载 zip，
      解压出 map.json 解析；文件读取：直接选择本地 map.json
   ② 解析后把全量 MapFileData 精简为 MapStationLite 列表，连同筛选状态
      一起写入 localStorage 键 grcs_map_stations（MapStationCache），
      供任务下发/车辆移动/自动化任务等页面恢复复用，无需重复读文件
   ── 交互服务 ──
   HttpClient：直连 GRCS 下载地图 zip
   LocalStoreService：站点缓存与共享地址（场景名/GRCS/WCS 地址）的持久化
   ════════════════════════════════════════════════ *@
<PageTitle>地图信息</PageTitle>

<style>
    .map-builder-layout { display:grid; grid-template-columns:132px minmax(0,1fr) 248px; gap:14px; min-height:680px; }
    .map-builder-tools, .map-builder-properties { border:1px solid #263650; border-radius:14px; background:linear-gradient(180deg,#111d32,#0c1526); padding:14px; box-shadow:0 12px 28px rgba(0,0,0,.16); }
    .map-builder-caption { color:#64748b; font-size:.68rem; text-transform:uppercase; letter-spacing:.14em; margin-bottom:11px; font-weight:700; }
    .map-tool { display:flex; align-items:center; gap:9px; width:100%; margin-bottom:8px; padding:11px 10px; border:1px solid #334155; border-radius:10px; background:#16243a; color:#cbd5e1; cursor:pointer; transition:.16s ease; font-size:.78rem; }
    .map-tool:first-letter { color:#67e8f9; font-size:1.1rem; }
    .map-tool:hover, .map-tool.active { border-color:#22d3ee; background:linear-gradient(135deg,#164e63,#172554); color:#ecfeff; box-shadow:0 0 0 1px #22d3ee22,0 8px 18px #02061755; }
    .map-tool.align-tool { color:#c4b5fd; }
    .map-tool.align-tool.active { border-color:#a78bfa; background:linear-gradient(135deg,#312e81,#1e1b4b); color:#ede9fe; }
    .map-builder-divider { height:1px; background:#263650; margin:16px 0; }
    .map-builder-count { color:#94a3b8; font-size:.75rem; margin-top:16px; padding:10px; border:1px solid #263650; border-radius:10px; background:#0b1425; }
    .map-builder-count b { display:block; color:#67e8f9; font-size:1.45rem; line-height:1.15; }
    .map-builder-count small { color:#64748b; font-size:.68rem; }
    .map-builder-stage { min-width:0; border:1px solid #263650; border-radius:14px; background:#08111f; overflow:hidden; box-shadow:0 16px 32px rgba(0,0,0,.2); }
    .map-builder-stagebar { position:relative; display:flex; align-items:center; justify-content:space-between; gap:10px; min-height:48px; padding:10px 15px; border-bottom:1px solid #263650; background:#101c30; color:#e2e8f0; font-size:.82rem; }
    .map-builder-stagebar strong { color:#f8fafc; font-size:.86rem; }
    .map-builder-hint { color:#67e8f9; font-size:.7rem; }
    .map-builder-legend { position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); display:flex; align-items:center; gap:7px; color:#94a3b8; font-size:.74rem; white-space:nowrap; pointer-events:none; }
    .map-legend-title { color:#94a3b8; font-size:.72rem; font-weight:700; margin-right:2px; }
    .map-legend-item { display:inline-flex; align-items:center; gap:5px; color:#e2e8f0; }
    .map-legend-icon-box { display:inline-flex; align-items:center; justify-content:center; width:28px; height:26px; border:1px solid #3b506f; border-radius:7px; background:#16243a; box-shadow:0 2px 8px rgba(0,0,0,.16); }
    .map-legend-item .mud-icon-root { width:20px; height:20px; font-size:20px; }
    .map-legend-storage .mud-icon-root { color:#22d3ee; }
    .map-legend-transfer .mud-icon-root { color:#4ade80; }
    .map-legend-people .mud-icon-root { color:#f472b6; }
    .map-legend-sorting .mud-icon-root { color:#a78bfa; }
    .map-align-hint { margin-top:10px; padding:9px; border:1px solid #4c1d95; border-radius:9px; background:#2e106522; color:#c4b5fd; font-size:.7rem; line-height:1.45; }
    .map-builder-zoom { display:flex; align-items:center; gap:4px; margin-left:auto; }
    .map-zoom-btn { width:28px; height:26px; padding:0; border:1px solid #3b506f; border-radius:7px; background:#16243a; color:#cbd5e1; cursor:pointer; font-size:1rem; line-height:1; }
    .map-zoom-btn:hover { border-color:#22d3ee; color:#ecfeff; background:#164e63; }
    .map-create-canvas-host { position:relative; width:100%; height:min(720px,72vh); min-height:600px; overflow:hidden; background:#08111f; }
    .map-create-canvas { display:block; width:100%; height:100%; cursor:crosshair; background:#08111f; }
    .map-create-overlay { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; overflow:visible; }
    .map-property-empty { color:#64748b; font-size:.78rem; line-height:1.65; padding:12px 4px; text-align:center; border:1px dashed #334155; border-radius:10px; }
    .map-selected-title { color:#67e8f9; font-weight:700; margin-bottom:14px; padding-bottom:10px; border-bottom:1px solid #263650; }
    .map-builder-properties input, .map-builder-properties select { background:#0b1425; border-color:#334155; }
    .map-builder-properties .form-group { gap:5px; margin-bottom:10px; }
    .map-builder-properties label { color:#94a3b8; font-size:.7rem; }
    .map-save-btn { border-color:#22c55e !important; color:#4ade80 !important; background:rgba(34,197,94,.08) !important; }
    .map-save-btn:hover { border-color:#4ade80 !important; color:#dcfce7 !important; background:rgba(34,197,94,.2) !important; box-shadow:0 0 0 1px rgba(74,222,128,.25),0 6px 16px rgba(22,101,52,.25); }
    .matrix-overlay { position:fixed; inset:0; z-index:900; display:flex; align-items:center; justify-content:center; padding:20px; background:rgba(2,6,23,.72); backdrop-filter:blur(4px); }
    .matrix-dialog { width:min(560px,96vw); border:1px solid #334155; border-top:2px solid #22d3ee; border-radius:14px; background:linear-gradient(155deg,#111d32,#0b1425); box-shadow:0 24px 70px rgba(0,0,0,.55); padding:20px; }
    .matrix-dialog-head { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; padding-bottom:14px; border-bottom:1px solid #263650; margin-bottom:16px; }
    .matrix-dialog-title { color:#f8fafc; font-size:1rem; font-weight:700; }
    .matrix-dialog-sub { color:#64748b; font-size:.7rem; margin-top:4px; }
    .matrix-dialog-close { border:1px solid #334155; border-radius:8px; background:transparent; color:#94a3b8; width:28px; height:28px; cursor:pointer; }
    .matrix-dialog-close:hover { color:#f87171; border-color:#f87171; }
    .matrix-form-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
    .matrix-form-grid .form-group { margin:0; }
    .matrix-form-grid .form-group.full { grid-column:1/-1; }
    .matrix-form-grid input, .matrix-form-grid select { background:#0b1425; border-color:#334155; }
    .matrix-coordinate { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
    .matrix-dialog-actions { display:flex; justify-content:flex-end; gap:8px; margin-top:20px; padding-top:14px; border-top:1px solid #263650; }
    .matrix-preview { margin-top:14px; padding:9px 11px; border-radius:9px; background:#0b1425; color:#94a3b8; font-size:.72rem; }
    @@media (max-width: 900px) { .map-builder-layout { grid-template-columns:90px minmax(0,1fr); } .map-builder-properties { grid-column:1/-1; } }
    @@media (max-width: 620px) { .map-builder-layout { grid-template-columns:1fr; } .map-builder-tools { display:flex; align-items:center; gap:8px; flex-wrap:wrap; } .map-builder-caption, .map-builder-divider, .map-builder-count { margin:0; } .map-tool { width:auto; margin:0; } .map-create-canvas-host { height:500px; min-height:0; } .map-builder-stagebar { flex-wrap:wrap; min-height:86px; } .map-builder-legend { position:static; transform:none; order:4; width:100%; justify-content:center; flex-wrap:wrap; white-space:normal; } .map-builder-zoom { margin-left:auto; } }
</style>


@* ════════════════════════════════════════════════
   系统设置：GRCS 地址 + 场景名称 + WCS 后端地址（全局唯一配置入口）
   ── 说明 ── 保存后写入后端（/api/wcs/auto/settings，SQLite 持久化），
   所有页面（任务下发/车辆移动/库存/信号/自动化）的 GRCS 调用与场景名
   都以后端这份设置为准；未保存用默认值（http://localhost:8224 / Show）。
   保存后重读一次刷新显示。WCS 后端地址为本页自身的访问地址（localStorage）。
   ════════════════════════════════════════════════ *@
<CascadingValue Value="this">
    <MapLoad
        Collapsed='@IsCollapsed("mr_file")'
        OverviewCollapsed='@IsCollapsed("mr_overview")'
        Toggle="ToggleFile"
        Loading="@_loading"
        LoadFromApi="LoadFromApi"
        OnFileSelected="OnFileSelected"
        ErrorMessage="@_mapError"
        Loaded="@_mapLoaded"
        StationCount="@_stations.Count"
        PathsCount="@_pathsCount"
        ToggleOverview="ToggleOverview"
        Stations="@_stations"
        Filtered="@_filtered"
        TypeFilter="@_typeFilter"
        Search="@_search"
        EnableFilter="@_enableFilter"
        SetTypeFilter="SetTypeFilter"
        SearchChanged="OnSearchInput"
        EnableFilterChanged="OnEnableFilterChange"
        SaveState="SaveState"
        CopyMark="CopyMark"
        LoadStateText="LoadStateText" />
    <MapSettings />
    <MapCreation />
</CascadingValue>

