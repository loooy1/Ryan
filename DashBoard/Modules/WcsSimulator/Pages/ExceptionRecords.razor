            catch (Exception ex) { ShowFeedback("❌ " + ex.Message, "error"); }
        });

    private async Task ExportExcel()
    {
        try
        {
            await LoadAsync(_currentQuery);
            if (_records.Count == 0) { ShowNotice("导出失败", "当前筛选条件下没有数据，无法导出 Excel。"); return; }
            using var wb = new XLWorkbook();
            var ws = wb.Worksheets.Add("异常记录");
            var projTitle = SafeFileName(string.IsNullOrEmpty(_currentProject) ? "项目" : _currentProject);
            var headers = new[] { "序号", "发生时间", "车号", "现象", "原因", "进度", "责任部门", "是否解决", "复现时间", "复现次数" };
            ws.Cell(1, 1).Value = $"{projTitle}_异常记录";
            ws.Range(1, 1, 1, headers.Length).Merge();
            ws.Cell(1, 1).Style.Font.Bold = true;
            ws.Cell(1, 1).Style.Font.FontSize = 16;
            ws.Cell(1, 1).Style.Font.FontColor = XLColor.White;
            ws.Cell(1, 1).Style.Fill.BackgroundColor = XLColor.FromHtml("#0f172a");
            ws.Cell(1, 1).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            ws.Cell(1, 1).Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;
            ws.Row(1).Height = 30;
            for (var c = 0; c < headers.Length; c++) ws.Cell(2, c + 1).Value = headers[c];
            var headerRow = ws.Row(2);
            ws.Range(2, 1, 2, headers.Length).Style.Font.Bold = true;
            ws.Range(2, 1, 2, headers.Length).Style.Font.FontColor = XLColor.White;
            ws.Range(2, 1, 2, headers.Length).Style.Fill.BackgroundColor = XLColor.FromHtml("#0f172a");
            ws.Range(2, 1, 2, headers.Length).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            ws.Range(2, 1, 2, headers.Length).Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;
            headerRow.Height = 24;

            for (var i = 0; i < _records.Count; i++)
            {
                var r = _records[i];
                var row = i + 3;
                var vehicles = string.IsNullOrEmpty(r.VehicleCode)
                    ? ""
                    : string.Join("; ", r.VehicleCode.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
                ws.Cell(row, 1).Value = i + 1;
                ws.Cell(row, 2).Value = r.HappenedAt;
                ws.Cell(row, 3).Value = vehicles;
                ws.Cell(row, 4).Value = r.Phenomenon;
                ws.Cell(row, 5).Value = r.Reason ?? "";
                ws.Cell(row, 6).Value = r.Progress ?? "";
                ws.Cell(row, 7).Value = string.IsNullOrEmpty(r.ResponsibleDept) ? "—" : r.ResponsibleDept;
                ws.Cell(row, 8).Value = StatusMeta(r.Status).label;
                ws.Cell(row, 9).Value = r.ReproducedAt ?? "—";
                ws.Cell(row, 10).Value = r.ReproduceCount;

                if (i % 2 == 1)
                    ws.Range(row, 1, row, 10).Style.Fill.BackgroundColor = XLColor.FromHtml("#f1f5f9");
                var (_, dcFg) = DeptColor(r.ResponsibleDept);
                if (!string.IsNullOrEmpty(r.ResponsibleDept))
                {
                    ws.Cell(row, 7).Style.Font.FontColor = XLColor.FromHtml(dcFg);
                    ws.Cell(row, 7).Style.Font.Bold = true;
                }
                var (_, _, stFg) = StatusMeta(r.Status);
                ws.Cell(row, 8).Style.Font.FontColor = XLColor.FromHtml(stFg);
                ws.Cell(row, 8).Style.Font.Bold = true;
                ws.Cell(row, 1).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
                ws.Cell(row, 2).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
                ws.Cell(row, 2).Style.Font.FontName = "Consolas";
                ws.Cell(row, 3).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
                ws.Cell(row, 7).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
                ws.Cell(row, 8).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
                ws.Cell(row, 9).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
                ws.Cell(row, 9).Style.Font.FontName = "Consolas";
                ws.Cell(row, 10).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
                ws.Cell(row, 10).Style.Font.Bold = true;
            }

            var used = ws.RangeUsed();
            if (used != null)
            {
                used.Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;
                used.Style.Border.OutsideBorder = XLBorderStyleValues.Thin;
                used.Style.Border.InsideBorder = XLBorderStyleValues.Thin;
                used.Style.Border.OutsideBorderColor = XLColor.FromHtml("#cbd5e1");
                used.Style.Border.InsideBorderColor = XLColor.FromHtml("#cbd5e1");
            }

            ws.SheetView.FreezeRows(2);
            ws.Columns().AdjustToContents();
            ws.Column(1).Width = 6;
            ws.Column(2).Width = 22;
            ws.Column(4).Width = 60;
            ws.Column(5).Width = 45;
            ws.Column(6).Width = 30;
            ws.Column(7).Width = 12;
            ws.Column(8).Width = 12;
            ws.Column(9).Width = 22;
            ws.Column(10).Width = 10;
            ws.Column(4).Style.Alignment.WrapText = true;
            ws.Column(5).Style.Alignment.WrapText = true;
            ws.Column(6).Style.Alignment.WrapText = true;
            ws.Column(4).Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;
            ws.Column(5).Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;
            ws.Column(6).Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;

            using var ms = new MemoryStream();
            wb.SaveAs(ms);
            var b64 = Convert.ToBase64String(ms.ToArray());
            var projPart = SafeFileName(string.IsNullOrEmpty(_currentProject) ? "未分类" : _currentProject);
            await Js.InvokeVoidAsync("downloadBase64",
                $"异常记录_{projPart}_{DateTime.Now:yyyyMMdd_HHmm}.xlsx",
                b64,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            ShowFeedback($"⬇️ 已导出 {_records.Count} 条记录（项目：{projPart}）为 Excel", "success");
        }
        catch (Exception ex) { ShowFeedback("❌ 导出失败：" + ex.Message, "error"); }
    }

    /// <summary>责任部门徽标配色：RCS=橙、WCS=蓝、Quicktron=紫。</summary>
    private static (string bg, string fg) DeptColor(string dept)
        => dept switch
        {
            "RCS" => ("rgba(251,146,60,0.15)", "#fb923c"),
            "WCS" => ("rgba(56,189,248,0.15)", "#7dd3fc"),
            "Quicktron" => ("rgba(192,132,252,0.15)", "#c084fc"),
            _ => ("rgba(100,116,139,0.15)", "#94a3b8"),
        };

    /// <summary>状态徽标：resolved=已解决(绿) / pending=未回复(灰) / in_progress=进行中(蓝) / observing=修复待观察(橙)。</summary>
    private static (string label, string bg, string fg) StatusMeta(string status)
        => status switch
        {
            "resolved" => ("✔ 已解决", "rgba(74,222,128,0.15)", "#4ade80"),
            "in_progress" => ("🔄 进行中", "rgba(56,189,248,0.15)", "#7dd3fc"),
            "observing" => ("👁 修复待观察", "rgba(251,191,36,0.15)", "#fbbf24"),
            _ => ("⏳ 未回复", "rgba(148,163,184,0.15)", "#94a3b8"),
        };

    private void ShowFeedback(string msg, string cls)
    {
        _feedback = msg;
        _feedbackClass = cls;
        StateHasChanged();
    }

    /// <summary>文件名安全化：去除 Windows 非法字符。</summary>
    private static string SafeFileName(string name)
    {
        var safe = string.Join("_", name.Split(Path.GetInvalidFileNameChars(), StringSplitOptions.RemoveEmptyEntries));
        return safe.Length == 0 ? "项目" : safe;
    }

