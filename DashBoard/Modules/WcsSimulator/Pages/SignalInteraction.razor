    private void EditMockRule(MockRuleDto r)
    {
        _editingMock = r;
        _mockDraft = new MockRuleDto
        {
            Id = r.Id,
            Name = r.Name,
            Method = r.Method,
            PathPattern = r.PathPattern,
            ResponseCode = r.ResponseCode,
            ResponseBody = r.ResponseBody,
            Enabled = r.Enabled,
            Priority = r.Priority,
            Description = r.Description,
            AlsoRecord = r.AlsoRecord,
