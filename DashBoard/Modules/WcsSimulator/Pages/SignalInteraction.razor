    private void CancelMockEdit() { _editingMock = null; _mockDraft = null; _mockError = ""; }
    private async Task SaveMockEdit()
    {
        if (_mockDraft == null) return;
        if (string.IsNullOrWhiteSpace(_mockDraft.PathPattern)) { _mockError = "❌ PathPattern 不能为空"; return; }
        try { if (!string.IsNullOrWhiteSpace(_mockDraft.ResponseBody)) System.Text.Json.JsonDocument.Parse(_mockDraft.ResponseBody); } catch { _mockError = "❌ ResponseBody 不是合法 JSON"; return; }
        if (_mockDraft.BoardSync && _mockRules.Any(x => x.Id != _mockDraft.Id && x.BoardSync))
        {
            _mockError = "❌ 任务阶段卡只能有一张，请先取消其他卡的「关联任务看板」";
            return;
        }
        if (_mockDraft.BoardSync && _mockDraft.RequiresApproval)
        {
            _mockError = "❌ 「关联任务看板」与「需审批」互斥，请只勾选其一";
            return;
        }
        var idx = _mockRules.FindIndex(x => x.Id == _mockDraft.Id);
        if (idx >= 0) _mockRules[idx] = _mockDraft;
        else _mockRules.Add(_mockDraft);
        _mockRules = _mockRules.OrderByDescending(x => x.Priority).ThenBy(x => x.Id).ToList();
        await SaveMocks();
        _editingMock = null; _mockDraft = null;
    }
    private void RequestDeleteMock(string id, string path) => ShowConfirm("确认删除", $"是否确认删除 Mock 规则「{path}」？", () => DeleteMock(id));
    private async Task DeleteMock(string id)
    {
        _mockRules.RemoveAll(x => x.Id == id);
        await SaveMocks();
    }
    private async Task ToggleMockEnabled(MockRuleDto r)
    {
        r.Enabled = !r.Enabled;
        await SaveMocks();
    }
    /// <summary>任务阶段卡互斥：勾选时自动取消其他卡的「关联任务看板」，且与「需审批」互斥。</summary>
    private void ToggleBoardSync(MockRuleDto d, ChangeEventArgs e)
    {
        var on = e.Value is bool b ? b : (e.Value?.ToString() == "true" || e.Value?.ToString() == "on");
        if (on)
        {
            foreach (var r in _mockRules)
                if (r.Id != d.Id) r.BoardSync = false;
            d.BoardSync = true;
            d.RequiresApproval = false;
        }
        else d.BoardSync = false;
    }
    /// <summary>「需审批」与「关联任务看板」互斥：勾选审批时自动取消任务阶段卡。</summary>
    private void ToggleApproval(MockRuleDto d, ChangeEventArgs e)
    {
        var on = e.Value is bool b ? b : (e.Value?.ToString() == "true" || e.Value?.ToString() == "on");
        d.RequiresApproval = on;
        if (on) d.BoardSync = false;
    }
    private void AddMockMatcher() => _mockDraft?.Matchers.Add(new MockMatcher { Key = "VehicleCode", Source = "body", Op = "equals", Expected = "" });
    private void RemoveMockMatcher(MockMatcher m) => _mockDraft?.Matchers.Remove(m);
    private void AddMockMatcherPreset()
    {
        if (_mockDraft == null) return;
        if (!_mockDraft.Matchers.Any(m => m.Key == "VehicleCode")) _mockDraft.Matchers.Add(new MockMatcher { Key = "VehicleCode", Source = "body", Op = "equals", Expected = "Car_101" });
        if (!_mockDraft.Matchers.Any(m => m.Key == "StationCode")) _mockDraft.Matchers.Add(new MockMatcher { Key = "StationCode", Source = "body", Op = "equals", Expected = "0100000108_1" });
        if (!_mockDraft.Matchers.Any(m => m.Key == "IsLoaded")) _mockDraft.Matchers.Add(new MockMatcher { Key = "IsLoaded", Source = "body", Op = "equals", Expected = "false" });
    }
    private async Task SaveMocks()
    {
        try { await Api.SaveMockRulesAsync(_mockRules); } catch { }
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadModules();
        await LoadMockRules();

        // 长连接推送（SignalR /hubs/task-stages，TaskStageHub 常驻）：请求信号记录/模块执行记录实时到达，零轮询
        StageHub.MockApprovalEventsChanged += OnMockEventsChanged;
        StageHub.ExecLogChanged += OnExecLogChanged;
        await StageHub.EnsureStartedAsync();
        _mockApprovals = StageHub.MockApprovalEvents.ToList();
        _execLog = StageHub.ExecLogEntries.ToList();

        // 读取 localStorage 状态（内存缓存，同步读取，无 JS 边界）
        try
        {
            if (LocalStore["grcs_si_collapsed"] is { } cl && cl != "null") _panelCollapsed = cl == "1";
        }
        catch { }
        await Task.CompletedTask;
    }

    private void OnMockEventsChanged() => InvokeAsync(() =>
    {
        _mockApprovals = StageHub.MockApprovalEvents.ToList();
        StateHasChanged();
    });

    private void OnExecLogChanged() => InvokeAsync(() =>
    {
        _execLog = StageHub.ExecLogEntries.ToList();
        StateHasChanged();
    });

    // ── 模块执行记录（SignalR 推送，TaskStageHub.ExecLogEntries 为权威缓存）──
    private List<ModuleExecLogEntry> _execLog = [];
    private string _logSearch = "";
    private List<ModuleExecLogEntry> _filteredExecLog
    {
        get
        {
            var q = _logSearch?.Trim();
            if (string.IsNullOrEmpty(q)) return _execLog;
            return _execLog.Where(e =>
                e.Module.Contains(q, StringComparison.OrdinalIgnoreCase)
                || e.TaskId.Contains(q, StringComparison.OrdinalIgnoreCase)
                || e.Point.Contains(q, StringComparison.OrdinalIgnoreCase)
                || e.Detail.Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    private async Task LoadExecLogAsync()
    {
        _execLog = StageHub.ExecLogEntries.ToList();
        StateHasChanged();
        await Task.CompletedTask;
    }

    // ── 模块执行记录重试 ──
    private HashSet<long> _retryingLogId = new();

    /// <summary>可重试：模块名为正常配置名（非「模块未找到/API 为空」类特殊条目）。</summary>
    private static bool CanRetryLog(ModuleExecLogEntry e)
        => !e.Module.StartsWith("模块未找到", StringComparison.OrdinalIgnoreCase)
           && e.Module != "API 地址为空，已跳过";

    private async Task RetryModuleLog(long id)
    {
        if (!_retryingLogId.Add(id)) return;
        StateHasChanged();
        try
        {
            await Api.RetryModuleLogAsync(id);
        }
        catch { }
        _retryingLogId.Remove(id);
        StateHasChanged();
    }

    public void Dispose()
    {
        StageHub.MockApprovalEventsChanged -= OnMockEventsChanged;
        StageHub.ExecLogChanged -= OnExecLogChanged;
    }
}
