@namespace Dashboard.Modules.WcsSimulator.Pages
@page "/wcs-simulator/task-stages"
@page "/wcs-simulator/history"
@inject WcsApiClient WcsApi
@inject AutomationHub AutoHub
@inject BackendHealthService Health
@inherits Dashboard.Modules.WcsSimulator.Components.PageStateBase
@implements IDisposable

<PageTitle>任务看板</PageTitle>

@* ════════════════════════════════════════════════
   任务看板（下发历史 + 任务阶段合并页）：
   - 台账为底：全量下发记录（类型筛选 + 关键词 + 分页加载）
   - 点击行自动展开 → 内嵌 task_records 的完整任务阶段时间线
   - 旧路由 /wcs-simulator/history（下发历史）重定向到本页
   ════════════════════════════════════════════════ *@
<div class="section-card">
    <div class="section-header collapsible" @onclick="ToggleList" title="点击折叠/展开">
        📊 任务看板
        <span class="header-right-group" style="margin-left:auto;display:flex;gap:8px;align-items:center;">
            @if (_clearConfirming)
            {
                <button class="btn btn-danger btn-sm" @onclick="ClearHistory" @onclick:stopPropagation>确认清空</button>
                <button class="btn btn-outline btn-sm" @onclick='() => _clearConfirming = false' @onclick:stopPropagation>取消</button>
            }
            else
            {
                <button class="btn btn-danger btn-sm" @onclick='() => _clearConfirming = true' @onclick:stopPropagation
                        disabled="@(!_ledger.Any(IsDeletable))">🗑 清空</button>
            }
            <button class="btn btn-outline btn-sm" @onclick='() => _forceConfirming = true' @onclick:stopPropagation
                    title="无视任务状态强制删除（输入任务ID）">⚡ 强制删除</button>
            <button class="btn btn-outline btn-sm" @onclick="RefreshNow" @onclick:stopPropagation
                    disabled="@_busy">🔄 刷新</button>
        </span>
        <span class="collapse-arrow">@(IsCollapsed("ts_list") ? "▸ 展开" : "▾ 收起")</span>
    </div>
    @if (!IsCollapsed("ts_list"))
    {
    @if (!_pollingOk)
    {
        <div class="hint-text" style="color:#f87171;margin:8px 0;">
            ⚠ 无法连接 WCS 后端，请确认 WCSBackend 已启动。@_lastError
        </div>
    }
    @if (_showMockReminder)
    {
        <div class="hint-text" style="color:#f59e0b;background:#422006;padding:8px;border-radius:6px;margin:8px 0;border:1px solid #92400e;">
            ⚠ 尚未配置任务阶段卡（Mock 卡片勾选「关联任务看板」即为任务阶段卡，URL 任意），阶段上报不会被接收且禁止下发任务。请前往 <a href="/wcs-simulator/signal-interaction" style="color:#f59e0b;text-decoration:underline;">信号交互 → 通用 Mock 入站</a> 勾选「关联任务看板」。
        </div>
    }
    @if (_forceConfirming)
    {
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:10px 0;padding:8px 12px;background:#1e293b;border:1px solid #f59e0b;border-radius:8px;">
            <span style="color:#f59e0b;font-size:0.75rem;">⚠ 强制删除无视任务状态，请输入任务ID：</span>
            <input type="text" @bind="_forceTaskId" @bind:event="oninput" placeholder="任务ID..." @onkeydown="OnForceKeyDown"
                   style="flex:1;min-width:200px;" autofocus />
            <button class="btn btn-danger btn-sm" @onclick="ForceDelete" @onclick:stopPropagation
                    disabled="@(string.IsNullOrWhiteSpace(_forceTaskId) || _busy)">确认删除</button>
            <button class="btn btn-outline btn-sm" @onclick='() => _forceConfirming = false' @onclick:stopPropagation>取消</button>
        </div>
    }
    @* 类型筛选 + 关键字搜索 *@
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:10px 0;">
        @foreach (var f in _filters)
        {
            <button class="chip-btn @(_activeFilter == f.Key ? "on" : "")" @onclick="() => SetFilter(f.Key)">@f.Value</button>
        }
        <input type="text" value="@_keyword" @oninput="OnKeywordChanged"
               placeholder="搜索 任务ID / 托盘号 / 货物号 / 站点..." style="flex:1;min-width:200px;">
    </div>

    @if (_visible.Count == 0)
    {
        <div class="hint-text" style="margin:8px 0;">暂无下发记录。任务下发后会进入台账，GRCS 执行时通过 task_stage_change 上报 START / LOAD_FINISH / FINISHED。</div>
    }
    else
    {
        <div style="overflow-x:auto;">
        <table class="entry-table">
            <thead><tr><th></th><th>状态</th><th>下发时间</th><th>任务ID</th><th>类型</th><th>托盘号</th><th>货物号</th><th>站点</th><th>仓库</th><th>HTTP</th><th>操作</th></tr></thead>
            <tbody>
            @foreach (var e in _visible)
            {
                var expanded = IsExpanded(e.TaskId);
                var status = TaskStatus(e);
                <tr class="row-clickable" @onclick="() => ToggleExpand(e.TaskId)" title="点击展开/收起任务阶段">
                    <td style="color:#64748b;white-space:nowrap;">@(expanded ? "▾" : "▸")</td>
                    <td><span class="badge @(StatusBadgeClass(status))">@status</span></td>
                    <td style="font-size:0.72rem;color:#94a3b8;white-space:nowrap;">@e.Time</td>
                    <td style="font-family:Consolas,monospace;font-size:0.75rem;">@e.TaskId</td>
                    <td><span class="badge">@TypeLabel(e.TaskType)</span></td>
                    <td>@e.ContainerCode</td>
                    <td>@e.CargoCode</td>
                    <td>@e.StartStationCode → @e.EndStationCode</td>
                    <td>@e.Warehouse</td>
                    <td>@e.StatusCode</td>
                    <td><button class="btn btn-danger btn-xs" @onclick="() => DeleteTask(e.TaskId)" @onclick:stopPropagation
                                title="@(IsDeletable(e) ? "删除该任务（已完成/失败）" : "执行中的任务不可删除")"
                                disabled="@(_busy || !IsDeletable(e))">✕</button></td>
                </tr>
                @if (expanded)
                {
                    <tr class="stage-expand">
                        <td colspan="11">
                            @if (_groups.TryGetValue(e.TaskId, out var evts) && evts.Count > 0)
                            {
                                <div class="stage-timeline">
                                    @foreach (var se in evts)
                                    {
                                        <div class="stage-row">
                                            <span class="stage-dot @(StageDotClass(se.Stage))"></span>
                                            <span class="stage-time">@se.Time.ToString("HH:mm:ss")</span>
                                            <span class="badge @(StageBadgeClass(se.Stage))">@StageLabel(se.Stage)</span>
                                            <span class="badge @(StageStatusBadgeClass(se.StageStatus))">@StageStatusLabel(se.StageStatus)</span>
                                            @if (!string.IsNullOrEmpty(se.ContainerCode))
                                            {
                                                <span class="stage-meta">容器 <code>@se.ContainerCode</code></span>
                                            }
                                            @if (!string.IsNullOrEmpty(se.StartStationCode) || !string.IsNullOrEmpty(se.EndStationCode))
                                            {
                                                <span class="stage-meta">路线 <code>@se.StartStationCode → @se.EndStationCode</code></span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="hint-text" style="margin:4px 0;">暂无阶段上报（任务可能尚未开始执行，或阶段事件已清空）。</div>
                            }
                            @* 分拣任务：关联显示回库任务（TaskId+"_R"，container_operation_finish 下发）*@
                            @if (e.TaskType == "SORTING")
                            {
                                var returnTaskId = ReturnTaskIdOf(e.TaskId);
                                var returnLedger = _ledgerMap.GetValueOrDefault(returnTaskId);
                                <div style="margin-top:10px;padding-top:10px;border-top:1px dashed #334155;">
                                    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:4px;">
                                        <span style="color:#64748b;font-size:0.75rem;">↳ 回库任务</span>
                                        <code style="color:#94a3b8;background:#1e293b;padding:1px 6px;border-radius:4px;font-size:0.72rem;">@returnTaskId</code>
                                        @if (returnLedger != null)
                                        {
                                            var rstatus = TaskStatus(returnLedger);
                                            <span class="badge @(StatusBadgeClass(rstatus))">@rstatus</span>
                                            <span class="stage-meta">下发 @returnLedger.Time</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-empty">未下发</span>
                                        }
                                    </div>
                                    @if (_groups.TryGetValue(returnTaskId, out var revts) && revts.Count > 0)
                                    {
                                        <div class="stage-timeline">
                                            @foreach (var se in revts)
                                            {
                                                <div class="stage-row">
                                                    <span class="stage-dot @(StageDotClass(se.Stage))"></span>
                                                    <span class="stage-time">@se.Time.ToString("HH:mm:ss")</span>
                                                    <span class="badge @(StageBadgeClass(se.Stage))">@StageLabel(se.Stage)</span>
                                                    <span class="badge @(StageStatusBadgeClass(se.StageStatus))">@StageStatusLabel(se.StageStatus)</span>
                                                    @if (!string.IsNullOrEmpty(se.ContainerCode))
                                                    {
                                                        <span class="stage-meta">容器 <code>@se.ContainerCode</code></span>
                                                    }
                                                    @if (!string.IsNullOrEmpty(se.StartStationCode) || !string.IsNullOrEmpty(se.EndStationCode))
                                                    {
                                                        <span class="stage-meta">路线 <code>@se.StartStationCode → @se.EndStationCode</code></span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    else if (returnLedger != null)
                                    {
                                        <div class="hint-text" style="margin:4px 0;">回库任务已下发，尚未有阶段上报。</div>
                                    }
                                </div>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
        </div>
        @if (_filtered.Count > _visible.Count)
        {
            <button class="btn btn-outline btn-sm" @onclick="LoadMore" style="margin-top:8px;">加载更多（@_visible.Count / @_filtered.Count）</button>
        }
    }
    }
</div>

@code {
    // ── 台账展示 ──
    private List<TaskRecord> _ledger = [];     // 台账原始数据（task_records 内存缓存读取）
    private Dictionary<string, TaskRecord> _ledgerMap = new(StringComparer.OrdinalIgnoreCase); // TaskId → 条目（回库任务关联查找用）
    private List<TaskRecord> _filtered = [];   // 经筛选 + 关键词过滤后的结果
    private List<TaskRecord> _visible = [];    // 当前已加载的可视窗口（分页加载，每页 PageSize 条）
    private string _activeFilter = "all";           // 当前类型筛选键（见 _filters）
    private string _keyword = "";                   // 关键词（任务ID/托盘/货物/站点）
    private const int PageSize = 100;               // 每页条数，防大量记录一次渲染卡顿
    private readonly HashSet<string> _expanded = new(StringComparer.OrdinalIgnoreCase); // 展开显示阶段的任务

    // 类型筛选注册表：键 → 中文标签；ApplyFilter 里按键映射到具体任务类型码
    private static readonly Dictionary<string, string> _filters = new()
    {
        ["all"] = "全部",
        ["in"] = "入库",
        ["out"] = "出库",
        ["sort"] = "分拣",
        ["move"] = "移库"
    };

    // ── 任务阶段 ──
    private bool _busy;                             // 操作中标志
    private bool _pollingOk = true;                 // 轮询是否成功
    private string _lastError = "";
    private bool _showMockReminder;                 // task_stage_change 未配置 Mock 时提示
    private Dictionary<string, List<TaskRecord>> _groups = [];         // TaskId → task_records 完整阶段记录（时间正序）
    private bool _clearConfirming;                                     // 清空全部确认态
    private bool _forceConfirming;                                      // 强制删除输入行显示态
    private string _forceTaskId = "";                                   // 强制删除目标任务ID
    private System.Threading.Timer? _timer;         // 轮询定时器
    private bool _refreshing;                       // 重入保护

    // ── 卡片折叠状态（基类 PageStateBase 提供，键 grcs_ts_collapsed，默认全部折叠避免初始化闪烁）──
    protected override string CollapsedStoreKey => "grcs_ts_collapsed";
    private async Task ToggleList()
    {
        var wasCollapsed = IsCollapsed("ts_list");
        await Toggle("ts_list");
        if (wasCollapsed && IsCollapsed("ts_list") == false)
        {
            await LoadEvents();
            await LoadLedger();
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // 恢复状态（内存缓存，同步读取，无 JS 边界）
        try
        {
            RestoreCollapsed();
        }
        catch { }

        // 恢复下发历史（台账内存缓存，无 JS 边界）
        try { await CheckMockConfig(); } catch { }

        // 懒加载：只有展开才发 HTTP/读台账，折叠的等用户展开时再拉
        if (!IsCollapsed("ts_list"))
        {
            await LoadEvents();
            await LoadLedger();
        }

        // 定时轮询：GRCS 每几秒可能上报新阶段，折叠时跳过节省后端压力
        _timer = new System.Threading.Timer(async _ =>
        {
            if (IsCollapsed("ts_list")) return;
            await RefreshAll();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    /// <summary>合并刷新：阶段事件 + 台账（台账走 2s 内存缓存，开销极小）。</summary>
    private async Task RefreshAll()
    {
        if (_refreshing) return;
        _refreshing = true;
        try
        {
            await LoadEvents();
            await LoadLedger();
            await CheckMockConfig();
        }
        finally { _refreshing = false; }
    }

    public void Dispose()
    {
        _timer?.Dispose();
        _timer = null;
    }

    /// <summary>从台账重建 TaskId → TaskType 映射（台账走内存缓存，轮询中重复调用开销极小）。</summary>


    private async Task CheckMockConfig()
    {
        try
        {
            var mocks = await WcsApi.GetMockRulesAsync();
            _showMockReminder = mocks == null || !mocks.Any(m => m.Enabled && m.BoardSync);
        }
        catch { _showMockReminder = false; }
    }

    /// <summary>
    /// 从共享缓存读取 task_records 完整记录并按 TaskId 分组（零 HTTP，TaskStageHub SignalR 常驻推送）。
    /// </summary>
    private async Task LoadEvents()
    {
        if (Health.WcsOnline == false)
        {
            _pollingOk = false;
            _lastError = "WCS backend is unavailable";
            return;
        }

        var records = await WcsApi.GetTaskRecordsAsync();
        if (records == null)
        {
            _pollingOk = false;
            _lastError = "Failed to read task records";
            return;
        }

        _pollingOk = true;
        BuildGroups(records);
        _ledger = records.Where(record => record.IsCreated)
            .OrderByDescending(record => record.Id).ToList();
        _ledgerMap = _ledger.Where(record => !string.IsNullOrEmpty(record.TaskId))
            .GroupBy(record => record.TaskId, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(group => group.Key, group => group.First(), StringComparer.OrdinalIgnoreCase);
        ApplyFilter();
    }

    /// <summary>将 task_records 完整记录按 TaskId 分组，供任意台账行展开完整时间线。</summary>
    private void BuildGroups(List<TaskRecord> records)
    {
        _groups = records
            .GroupBy(record => record.TaskId)
            .ToDictionary(group => group.Key, group => group.OrderBy(record => record.Id).ToList())
            .OrderByDescending(g => g.Value[^1].Time)
            .ToDictionary(g => g.Key, g => g.Value);
    }

    /// <summary>重新读台账并应用筛选（台账 2s 缓存，刷新成本低）。</summary>
    private Task LoadLedger()
    {
        ApplyFilter();
        return Task.CompletedTask;
    }

    /// <summary>手动触发一次刷新。</summary>
    private async Task RefreshNow()
    {
        _busy = true;
        await RefreshAll();
        _busy = false;
    }

    // ── 台账行交互 ──
    private bool IsExpanded(string taskId) => _expanded.Contains(taskId);
    private void ToggleExpand(string taskId)
    {
        if (!_expanded.Remove(taskId)) _expanded.Add(taskId);
        StateHasChanged();
    }

    /// <summary>分拣任务的回库任务号由模块执行前效果固定生成。</summary>
    private static string ReturnTaskIdOf(string taskId) => taskId + "_R";

    /// <summary>任务状态：由 task_records 的完整阶段和创建行结果推导。</summary>
    private string TaskStatus(TaskRecord e)
    {
        if (_groups.TryGetValue(e.TaskId, out var evts))
        {
            if (evts.Any(x => x.Stage is "CANCELLED" or "DISPATCH_FAILED")) return "失败";
            if (evts.Any(x => x.Stage == "WCS_FINALIZATION_FAILED")) return "收尾失败";
            if (evts.Any(x => x.Stage == "WCS_COMPLETED" && x.StageStatus == TaskStageStatuses.Success)) return "WCS任务完成";
            if (evts.Any(x => x.Stage == "WCS_WAITING_RETURN")) return "等待回库";
            if (evts.Any(x => x.Stage == "FINISHED")) return "WCS收尾中";
            if (evts.Any(x => x.Stage == "START" || x.Stage == "LOAD_FINISH"
                || x.Stage.StartsWith("TRANSIT:", StringComparison.OrdinalIgnoreCase)
                || x.Stage.StartsWith("BEFORE_MODULE:", StringComparison.OrdinalIgnoreCase)
                || x.Stage.StartsWith("AFTER_START_MODULE:", StringComparison.OrdinalIgnoreCase)
                || x.Stage.StartsWith("AFTER_END_MODULE:", StringComparison.OrdinalIgnoreCase))) return "执行中";
            if (evts.Any(x => x.Stage == "DISPATCHED")) return "已下发";
        }
        if (!e.IsSuccess && e.StatusCode != 0) return "失败";
        if (!e.IsSuccess) return "已创建";
        if (_groups.TryGetValue(e.TaskId, out var createdRecords) && createdRecords.Any(x => x.Stage == "CREATED")) return "已创建";
        return "已下发";
    }

    private static string StatusBadgeClass(string status) => status switch
    {
        "WCS任务完成" => "badge-ok",
        "执行中" => "badge-selected",
        "WCS收尾中" => "badge-selected",
        "已创建" => "badge-info",
        "失败" or "收尾失败" => "badge-danger",
        _ => "badge-info"
    };

    /// <summary>切换类型筛选芯片。</summary>
    private void SetFilter(string f) { _activeFilter = f; ApplyFilter(); }

    /// <summary>关键词输入实时过滤。</summary>
    private void OnKeywordChanged(ChangeEventArgs e) { _keyword = e.Value?.ToString() ?? ""; ApplyFilter(); }

    /// <summary>按类型 + 关键词过滤台账（回库任务不单独成行，挂在分拣任务展开区），过滤后只取前 PageSize 条进入可视窗口。</summary>
    private void ApplyFilter()
    {
        IEnumerable<TaskRecord> q = _ledger.Where(e => e.TaskType != "RCS_RETURN");
        switch (_activeFilter)
        {
            case "in": q = q.Where(e => e.TaskType is "CONTAINER_CARRY_INBOUND" or "CARGO_CARRY_INBOUND"); break;
            case "out": q = q.Where(e => e.TaskType is "CONTAINER_CARRY_OUTBOUND" or "CARGO_CARRY_OUTBOUND"); break;
            case "sort": q = q.Where(e => e.TaskType == "SORTING"); break;
            case "move": q = q.Where(e => e.TaskType == "STOCK_TRANSFER"); break;
        }
        if (!string.IsNullOrWhiteSpace(_keyword))
        {
            var k = _keyword.Trim();
            q = q.Where(e => e.TaskId.Contains(k, StringComparison.OrdinalIgnoreCase)
                || e.ContainerCode.Contains(k, StringComparison.OrdinalIgnoreCase)
                || e.CargoCode.Contains(k, StringComparison.OrdinalIgnoreCase)
                || e.StartStationCode.Contains(k, StringComparison.OrdinalIgnoreCase)
                || e.EndStationCode.Contains(k, StringComparison.OrdinalIgnoreCase));
        }
        _filtered = q.ToList();
        _visible = _filtered.Take(PageSize).ToList();
    }

    /// <summary>分页加载：可视窗口再扩一页（防止大数据量一次渲染卡顿）。</summary>
    private void LoadMore() => _visible = _filtered.Take(_visible.Count + PageSize).ToList();

    /// <summary>任务类型码 → 显示文本：附加中文标签，未知码原样显示。</summary>
    private static string TypeLabel(string code)
    {
        if (string.Equals(code, "RCS_RETURN", StringComparison.OrdinalIgnoreCase))
            return "RCS_RETURN（RCS 回库任务）";
        var t = TaskTypeRegistry.All.FirstOrDefault(x => x.Value == code);
        return t != null ? $"{code}（{t.Label}）" : code;
    }

    /// <summary>删除指定任务（仅已完成/失败可删，执行中禁止；后端删全行 + 同步缓存）。</summary>
    private async Task DeleteTask(string taskId)
    {
        var entry = _ledgerMap.GetValueOrDefault(taskId);
        if (entry == null || !IsDeletable(entry)) { _lastError = "执行中的任务不可删除"; return; }
        _busy = true;
        var (ok, code, _) = await WcsApi.DeleteTaskStageAsync("", taskId);
        if (!ok && code != 404)
        {
            _lastError = $"删除失败 HTTP {code}";
            _busy = false;
            return;
        }
        _groups.Remove(taskId);
        _expanded.Remove(taskId);
        _busy = false;
    }

    /// <summary>清空已结束任务（已完成 FINISHED / 下发失败），执行中的任务保留。</summary>
    private async Task ClearHistory()
    {
        _busy = true;
        var deletable = _ledger.Where(IsDeletable).ToList();
        foreach (var e in deletable)
        {
            var (ok, code, _) = await WcsApi.DeleteTaskStageAsync("", e.TaskId);
            if (!ok && code != 404)
            {
                _lastError = $"删除 {e.TaskId} 失败 HTTP {code}";
                _busy = false;
                _clearConfirming = false;
                return;
            }
        }
        await RefreshAll();   // 从缓存重建（执行中的任务保留在列表）
        _clearConfirming = false;
        _busy = false;
    }

    /// <summary>任务是否可删除：下发失败（结束态）或已完成（FINISHED）→ 可删；已下发/执行中 → 禁止。</summary>
    private bool IsDeletable(TaskRecord e)
    {
        if (!e.IsSuccess) return true;
        return _groups.TryGetValue(e.TaskId, out var stages)
            && stages.Any(stage => (stage.Stage == "WCS_COMPLETED" && stage.StageStatus == TaskStageStatuses.Success)
                || stage.Stage is "WCS_FINALIZATION_FAILED" or "CANCELLED" or "DISPATCH_FAILED");
    }

    /// <summary>强制删除：无视任务状态直接删除全行（后端 + 本地缓存 + 列表）。</summary>
    private async Task ForceDelete()
    {
        var taskId = _forceTaskId.Trim();
        if (string.IsNullOrEmpty(taskId)) return;
        _busy = true;
        var (ok, code, _) = await WcsApi.DeleteTaskStageAsync("", taskId);
        if (!ok && code != 404)
        {
            _lastError = $"强制删除失败 HTTP {code}";
            _busy = false;
            return;
        }
        _groups.Remove(taskId);
        _expanded.Remove(taskId);
        _ledger.RemoveAll(x => string.Equals(x.TaskId, taskId, StringComparison.OrdinalIgnoreCase));
        _ledgerMap.Remove(taskId);
        ApplyFilter();
        _forceConfirming = false;
        _forceTaskId = "";
        _busy = false;
    }

    private async Task OnForceKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ForceDelete();
    }

    private static string StageLabel(string stage)
    {
        const StringComparison comparison = StringComparison.OrdinalIgnoreCase;
        if (string.Equals(stage, "CREATED", comparison)) return "WCS任务创建";
        if (string.Equals(stage, "DISPATCHED", comparison)) return "已下发 RCS";
        if (string.Equals(stage, "START", comparison)) return "任务开始";
        if (string.Equals(stage, "LOAD_FINISH", comparison)) return "装载完成";
        if (stage.StartsWith("TRANSIT:", comparison)) return "货物在途：" + stage["TRANSIT:".Length..];
        if (string.Equals(stage, "FINISHED", comparison)) return "RCS任务完成";
        if (string.Equals(stage, "WCS_FINALIZING", comparison)) return "WCS任务收尾中";
        if (string.Equals(stage, "WCS_INVENTORY_FINALIZED", comparison)) return "WCS终点库存收尾完成";
        if (string.Equals(stage, "WCS_WAITING_RETURN", comparison)) return "等待回库任务完成";
        if (string.Equals(stage, "WCS_COMPLETED", comparison)) return "WCS任务完成";
        if (string.Equals(stage, "WCS_FINALIZATION_FAILED", comparison)) return "WCS任务收尾失败";
        if (stage.StartsWith("WCS_FINALIZATION_REASON:", comparison)) return "WCS收尾原因：" + stage["WCS_FINALIZATION_REASON:".Length..];
        if (stage.StartsWith("SORTING_SLOT_ASSIGNED:", comparison)) return "已分配实际分拣台：" + stage["SORTING_SLOT_ASSIGNED:".Length..];
        if (string.Equals(stage, "CANCELLED", comparison)) return "任务取消";
        if (string.Equals(stage, "DISPATCH_FAILED", comparison)) return "下发失败";
        if (string.Equals(stage, "RETURN_TASK_REGISTERED", comparison)) return "RCS回库任务已登记";
        if (string.Equals(stage, "RETURN_TASK_PREPARED", comparison)) return "回库任务已预登记";
        if (string.Equals(stage, "DISPATCH_UNKNOWN", comparison)) return "下发结果未知，等待确认";
        if (stage.StartsWith("PRE_EFFECT:", comparison)) return "模块执行前效果：" + stage["PRE_EFFECT:".Length..];
        if (stage.StartsWith("EFFECT_CONFIGURATION:", comparison)) return "模块效果配置错误：" + stage["EFFECT_CONFIGURATION:".Length..];
        if (stage.StartsWith("BEFORE_MODULE:", comparison)) return "起点前模块：" + stage["BEFORE_MODULE:".Length..];
        if (stage.StartsWith("AFTER_START_MODULE:", comparison)) return "起点后模块：" + stage["AFTER_START_MODULE:".Length..];
        if (stage.StartsWith("AFTER_END_MODULE:", comparison)) return "终点后模块：" + stage["AFTER_END_MODULE:".Length..];
        if (stage.StartsWith("INVENTORY_EFFECT:", comparison)) return InventoryEffectLabel(stage["INVENTORY_EFFECT:".Length..]);
        return "未知阶段：" + stage;
    }

    private static string InventoryEffectLabel(string effect) => effect.ToLowerInvariant() switch
    {
        "cargo_arrival" => "执行后：货物到达",
        "cargo_removal" => "执行后：货物移除",
        "create_return_task" => "执行后：创建回库任务",
        _ => "执行后：" + effect
    };

    private static string StageStatusLabel(string status) => status.ToLowerInvariant() switch
    {
        TaskStageStatuses.Success => "成功",
        TaskStageStatuses.Fail => "失败",
        TaskStageStatuses.Callback => "RCS 回调",
        _ => "状态：" + status
    };

    private static string StageStatusBadgeClass(string status) => status.ToLowerInvariant() switch
    {
        TaskStageStatuses.Success => "badge-ok",
        TaskStageStatuses.Fail => "badge-danger",
        TaskStageStatuses.Callback => "badge-info",
        _ => "badge-empty"
    };

    private static string StageBadgeClass(string s)
    {
        if (s is "CANCELLED" or "DISPATCH_FAILED" or "WCS_FINALIZATION_FAILED" || s.StartsWith("INVENTORY_RELEASE_FAILED:", StringComparison.OrdinalIgnoreCase) || s.StartsWith("EFFECT_CONFIGURATION:", StringComparison.OrdinalIgnoreCase)) return "badge-danger";
        if (s == "DISPATCH_UNKNOWN") return "badge-warn";
        if (s is "CREATED" or "WCS_FINALIZING" or "WCS_INVENTORY_FINALIZED" or "WCS_WAITING_RETURN" or "WCS_COMPLETED"
            || s.StartsWith("SORTING_SLOT_ASSIGNED:", StringComparison.OrdinalIgnoreCase)
            || s.StartsWith("WCS_FINALIZATION_REASON:", StringComparison.OrdinalIgnoreCase)) return "badge-selected";
        if (s is "START" or "LOAD_FINISH" or "FINISHED" || s.StartsWith("TRANSIT:", StringComparison.OrdinalIgnoreCase)
            || s == "DISPATCHED") return "badge-info";
        if (s is "RETURN_TASK_PREPARED" or "RETURN_TASK_REGISTERED"
            || s.StartsWith("PRE_EFFECT:", StringComparison.OrdinalIgnoreCase)
            || s.StartsWith("BEFORE_MODULE:", StringComparison.OrdinalIgnoreCase)
            || s.StartsWith("AFTER_START_MODULE:", StringComparison.OrdinalIgnoreCase)
            || s.StartsWith("AFTER_END_MODULE:", StringComparison.OrdinalIgnoreCase)
            || s.StartsWith("INVENTORY_EFFECT:", StringComparison.OrdinalIgnoreCase)) return "badge-warn";
        return "badge-empty";
    }

    private static string StageDotClass(string s)
    {
        if (s is "CANCELLED" or "DISPATCH_FAILED" or "WCS_FINALIZATION_FAILED" || s.StartsWith("INVENTORY_RELEASE_FAILED:", StringComparison.OrdinalIgnoreCase) || s.StartsWith("EFFECT_CONFIGURATION:", StringComparison.OrdinalIgnoreCase)) return "dot-other";
        if (s is "CREATED" or "WCS_FINALIZING" or "WCS_INVENTORY_FINALIZED" or "WCS_WAITING_RETURN" or "WCS_COMPLETED"
            || s.StartsWith("SORTING_SLOT_ASSIGNED:", StringComparison.OrdinalIgnoreCase)
            || s.StartsWith("WCS_FINALIZATION_REASON:", StringComparison.OrdinalIgnoreCase)) return "dot-load";
        if (s is "START" or "LOAD_FINISH" or "FINISHED" or "DISPATCHED" || s.StartsWith("TRANSIT:", StringComparison.OrdinalIgnoreCase)) return "dot-start";
        if (s is "RETURN_TASK_PREPARED" or "RETURN_TASK_REGISTERED"
            || s.StartsWith("PRE_EFFECT:", StringComparison.OrdinalIgnoreCase)
            || s.StartsWith("BEFORE_MODULE:", StringComparison.OrdinalIgnoreCase)
            || s.StartsWith("AFTER_START_MODULE:", StringComparison.OrdinalIgnoreCase)
            || s.StartsWith("AFTER_END_MODULE:", StringComparison.OrdinalIgnoreCase)
            || s.StartsWith("INVENTORY_EFFECT:", StringComparison.OrdinalIgnoreCase)) return "dot-module";
        return "dot-start";
    }
}

