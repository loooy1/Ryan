        Name = src.Name,
        Steps = src.Steps.Select(s => new AutoStepDto { Kind = s.Kind, PalletFilter = s.PalletFilter, TemplateValue = s.TemplateValue, Label = s.Label, WaitForFinish = s.WaitForFinish, UsePickedContainer = s.UsePickedContainer, UsePickedStart = s.UsePickedStart, PickedStepIndex = s.PickedStepIndex }).ToList(),
