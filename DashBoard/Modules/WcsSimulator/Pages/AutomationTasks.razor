    // 弹窗日志：步骤号（如「步骤 2/5」）高亮加粗；其余内容转义后原样展示
    private static readonly Regex StepNoRe = new(@"步骤 (\d+/\d+)", RegexOptions.Compiled);
    private static MarkupString RenderLog(LogEntryDto e)
    {
        var msg = System.Net.WebUtility.HtmlEncode(e.Message);
        msg = StepNoRe.Replace(msg, "<b style=\"color:#fbbf24\">步骤 $1</b>");
        return new MarkupString(msg);
    }

    private HashSet<string> _expandedParents = new();
    private void OnParentClick(LogRoundDto parent)
    {
        var children = Hub.Rounds.Where(c => c.ParentRoundId == parent.RoundId).ToList();
        if (children.Count == 0) { OpenRound(parent.RoundId); return; }
        if (_expandedParents.Contains(parent.RoundId)) _expandedParents.Remove(parent.RoundId);
        else _expandedParents.Add(parent.RoundId);
        StateHasChanged();
    }

    private static readonly JsonSerializerOptions JsonOpts = new() { PropertyNameCaseInsensitive = true };

    protected override async Task OnInitializedAsync()
    {
        // 标签页身份：sessionStorage 持久化（同标签页刷新/重进沿用同一 tabId，避免误判「另一标签页」；
        // 新开标签页独立 sessionStorage 生成新 tabId，跨标签页互斥依然生效）
        try
        {
            _tabId = await Js.InvokeAsync<string>("grcsSessionLoad", "wcs_auto_tab_id") ?? "";
            if (string.IsNullOrEmpty(_tabId))
            {
                _tabId = Guid.NewGuid().ToString("N");
                await Js.InvokeVoidAsync("grcsSessionSave", "wcs_auto_tab_id", _tabId);
            }
        }
        catch { _tabId = Guid.NewGuid().ToString("N"); }

        try
        {
            var cache = await WcsApi.GetAsync<MapCacheDto>("/api/wcs/map");
            _mapStations = cache?.Stations ?? [];
        }
        catch { }

        try
        {
            RestoreCollapsed();
        }
        catch { }

        try
        {
            var range = await WcsApi.GetAsync<RangeConfigDto>("/api/wcs/auto/range");
            if (range != null)
            {
                _range.Enabled = range.Enabled;
                _range.TypeFilter = range.TypeFilter;
                _range.FloorFilter = range.FloorFilter;
                _range.Marks = range.Marks ?? [];
                _rangeMarksText = string.Join(", ", _range.Marks);
                _rangeFp = RangeFp(range.Enabled, range.TypeFilter, range.FloorFilter, _range.Marks);
            }
        }
        catch { }

        Hub.Changed += OnHubChanged;
        MoveLoop.Changed += OnMoveLoopChanged;
        StageHub.NestStatsChanged += OnNestStatsChanged;

        try
        {
            var nest = await WcsApi.GetAsync<NestConfigDto>("/api/wcs/auto/nest/config");
            if (nest != null) _nestMarksText = string.Join(", ", nest.Marks);
        }
        catch { }

        try
        {
            var fleet = LocalStore["grcs_nest_fleet"];
            if (!string.IsNullOrEmpty(fleet) && fleet != "null")
            {
                var list = JsonSerializer.Deserialize<List<string>>(fleet) ?? [];
                _selectedVehicles = FleetDedupe(list);
            }
        }
        catch { }
    }

    private List<MapStationLite> _batchPool => _range.ApplyTo(_mapStations.Where(s => s.StaEnable));

    private async Task ToggleMoveDispatch()
    {
        if (_moveRunning)
        {
            MoveLoop.Stop();
            StateHasChanged();
            return;
        }
        if (string.IsNullOrEmpty(SceneName)) { ShowResp("❌ 未配置场景名称（地图信息页系统设置）", "error"); return; }

        var (ok, reason) = await MoveLoop.StartAsync(new Dashboard.Modules.WcsSimulator.Services.MoveLoopService.Options
        {
            TabId = _tabId,
            OrderIdPrefix = _batchOrderIdPrefix,
            Priority = _batchPriority,
            Interval = _batchInterval,
        });
        if (!ok)
        {
            ShowResp("❌ 无法开始移动下发：" + (reason ?? "后端拒绝（互斥：模板任务或另一标签页正在下发）"), "error");
            return;
        }
        StateHasChanged();
    }

