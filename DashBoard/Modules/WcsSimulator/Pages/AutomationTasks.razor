    // ── 归巢两步地图选择（先选车队，再选巢区，总结确认后一并保存）──
    private List<VehicleInfoDto> _fleetVehicles = [];

    /// <summary>打开两步地图：① 框选车队（站点为背景，仅就绪车可选）→ ② 框选巢区（车辆为背景）→ 总结确认后车队存 localStorage、巢区 PUT nest/config。</summary>
    private async Task OpenNestPicker()
    {
        if (_mapStations.Count == 0) { ShowResp("❌ 请先在「地图信息」页加载地图数据", "error"); return; }
        try { _fleetVehicles = await WcsApi.GetVehiclesAsync(); }
        catch { _fleetVehicles = []; }
        if (_fleetVehicles.Count == 0)
        {
            ShowResp("❌ 未获取到车辆（检查 GRCS 连接与「地图信息 → 系统设置」的场景名称）", "error");
            return;
        }
        var chargingMarks = new HashSet<string>(
            _mapStations.Where(s => (s.StationType & MapStationTypeBits.Charging) != 0).Select(s => s.Mark),
            StringComparer.OrdinalIgnoreCase);
        var config = new
        {
            Stations = _mapStations.Select(s => new { s.Mark, s.StationType, s.X, s.Y, s.Floor, s.StaEnable }),
            Vehicles = _fleetVehicles.Select(v => new
            {
                v.Name, v.X, v.Y, v.IsReady, v.ExecutionState, v.UtilizationState, v.Power, v.Location,
                IsCharging = !string.IsNullOrEmpty(v.Location) && chargingMarks.Contains(v.Location),
            }),
            PreselectedVehicles = Array.Empty<string>(),
            PreselectedMarks = Array.Empty<string>(),
        };
        try
        {
            var json = await Js.InvokeAsync<string?>("grcsNestPickerOpen", JsonSerializer.Serialize(config));
            if (string.IsNullOrWhiteSpace(json)) return;
            NestPickResult? result = null;
            try { result = JsonSerializer.Deserialize<NestPickResult>(json); } catch { }
            if (result == null) return;

            var names = result.Vehicles.Where(n => !string.IsNullOrWhiteSpace(n)).ToList();
            _selectedVehicles = FleetDedupe(names);
            await LocalStore.SetAsync(Js, "grcs_nest_fleet", JsonSerializer.Serialize(names));

            var marks = result.Marks.Where(m => !string.IsNullOrWhiteSpace(m)).Distinct().ToList();
            _nestMarksText = string.Join(", ", marks);
            await WcsApi.PutAsync<NestConfigDto, object>("/api/wcs/auto/nest/config", new NestConfigDto { Marks = marks });
            ShowResp(result.Dropped > 0
                ? $"✅ 已保存：车队前 {names.Count} 台参与、巢区 {marks.Count} 个站点（其余 {result.Dropped} 台已移出车队）"
                : $"✅ 已保存：车队 {names.Count} 台、巢区 {marks.Count} 个站点（确认后立即生效）", "success");
            StateHasChanged();
        }
        catch (Exception ex) { ShowResp($"❌ 地图选择失败：{ex.Message}", "error"); }
    }

