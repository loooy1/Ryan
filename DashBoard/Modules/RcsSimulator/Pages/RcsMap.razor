@page "/rcs/map"
@using Rcs.Contracts.Map
@using Rcs.Contracts.Vehicles
@inject RcsApiClient Api
@inject RcsRealtimeHubClient Realtime
@implements IDisposable

<PageTitle>RCS 地图</PageTitle>

<div class="rcs-page">
    <div class="rcs-header">
        <div><div class="rcs-kicker">RCS SIMULATOR</div><h1>矩阵地图与路径演示</h1><p>独立于 WCS 的 A* 路径计算和虚拟车运行。</p></div>
        <div class="rcs-actions">
            <button @onclick="Preview" disabled="@(!CanCalculate)">计算路径</button>
            <button class="primary" @onclick="Run" disabled="@(!CanCalculate)">开始运行</button>
            <button @onclick="Pause">暂停</button><button @onclick="Reset">重置</button>
        </div>
    </div>
    <div class="rcs-layout">
        <section class="rcs-card rcs-map-card">
            <div class="rcs-card-title"><span>地图</span><small>@_map.Width × @_map.Height</small></div>
            <div class="rcs-grid" style="--cols:@_map.Width;">
                @for (var y = 0; y < _map.Height; y++)
                {
                    for (var x = 0; x < _map.Width; x++)
                    {
                        var point = new GridPoint(x, y);
                        <button class="rcs-cell @CellClass(point)" @onclick="() => SelectCell(point)" title="(@x,@y)">
                            @if (_vehicle.Position == point) { <span class="vehicle">◆</span> }
                            else if (_start == point) { <span class="marker start">A</span> }
                            else if (_end == point) { <span class="marker end">B</span> }
                        </button>
                    }
                }
            </div>
            <div class="rcs-hint">点击两个可通行格：第一个设为起点 A，第二个设为终点 B。</div>
        </section>
        <aside class="rcs-side">
            <section class="rcs-card"><div class="rcs-card-title">虚拟车 <span class="status @_vehicle.Status.ToLowerInvariant()">@_vehicle.Status</span></div><div class="rcs-stats"><b>V-01</b><span>当前位置 (@_vehicle.Position.X, @_vehicle.Position.Y)</span><span>路径进度 @_vehicle.RouteIndex / @_vehicle.RouteLength</span></div></section>
            <section class="rcs-card"><div class="rcs-card-title">图例</div><div class="legend"><span class="legend-item walkable"></span>可通行 <span class="legend-item obstacle"></span>障碍 <span class="legend-item path"></span>路径</div><div class="rcs-error">@_error</div></section>
        </aside>
    </div>
</div>

<style>
    .rcs-page{padding:24px;min-height:calc(100vh - 70px);color:#e2e8f0;background:#0b1220}.rcs-header{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:18px}.rcs-kicker{color:#38bdf8;font-size:.7rem;letter-spacing:.18em;font-weight:700}.rcs-header h1{margin:4px 0;color:#f8fafc;font-size:1.35rem}.rcs-header p{margin:0;color:#64748b;font-size:.8rem}.rcs-actions{display:flex;gap:8px;flex-wrap:wrap}.rcs-actions button{border:1px solid #334155;border-radius:8px;background:#17243a;color:#cbd5e1;padding:8px 13px;cursor:pointer}.rcs-actions button:hover{border-color:#38bdf8;color:#e0f2fe}.rcs-actions button.primary{background:#0369a1;border-color:#38bdf8;color:#fff}.rcs-actions button:disabled{opacity:.4;cursor:not-allowed}.rcs-layout{display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:16px}.rcs-card{border:1px solid #263650;border-radius:14px;background:linear-gradient(145deg,#111d32,#0c1526);box-shadow:0 12px 28px #02061766;padding:16px}.rcs-map-card{min-height:600px}.rcs-card-title{display:flex;justify-content:space-between;align-items:center;color:#f8fafc;font-weight:700;margin-bottom:14px}.rcs-card-title small{color:#64748b;font-weight:400}.rcs-grid{display:grid;grid-template-columns:repeat(var(--cols),minmax(25px,1fr));gap:3px;max-width:900px;margin:22px auto}.rcs-cell{aspect-ratio:1;border:1px solid #22324d;border-radius:4px;background:#101c30;cursor:pointer;color:#fff;display:flex;align-items:center;justify-content:center;padding:0}.rcs-cell:hover{border-color:#38bdf8;background:#12304a}.rcs-cell.obstacle{background:#263650;border-color:#475569}.rcs-cell.path{background:#164e63;border-color:#22d3ee}.marker{font-weight:800}.marker.start{color:#4ade80}.marker.end{color:#f472b6}.vehicle{color:#fbbf24;font-size:1.2rem}.rcs-hint{color:#64748b;font-size:.75rem;text-align:center}.rcs-side{display:flex;flex-direction:column;gap:16px}.status{font-size:.68rem;padding:3px 7px;border-radius:999px;background:#1e293b;color:#94a3b8}.status.running{color:#4ade80;background:#14532d}.status.paused{color:#fbbf24;background:#713f12}.status.arrived{color:#38bdf8;background:#164e63}.rcs-stats{display:flex;flex-direction:column;gap:8px;color:#94a3b8;font-size:.78rem}.rcs-stats b{color:#fbbf24;font-size:1.5rem}.legend{display:flex;gap:7px;align-items:center;flex-wrap:wrap;color:#94a3b8;font-size:.72rem}.legend-item{width:16px;height:16px;border-radius:3px;background:#101c30;border:1px solid #22324d}.legend-item.obstacle{background:#263650}.legend-item.path{background:#164e63;border-color:#22d3ee}.rcs-error{margin-top:14px;color:#f87171;font-size:.75rem;min-height:18px}@@media(max-width:900px){.rcs-header{align-items:flex-start;flex-direction:column}.rcs-layout{grid-template-columns:1fr}.rcs-side{display:grid;grid-template-columns:1fr 1fr}}
</style>

@code {
    private GridMapDto _map = new() { Width = 18, Height = 12 };
    private RouteDto _route = new();
    private VehicleStateDto _vehicle = new();
    private GridPoint? _start;
    private GridPoint? _end;
    private string _error = "";
    private bool CanCalculate => _start is not null && _end is not null;

    protected override async Task OnInitializedAsync()
    {
        try { _map = await Api.GetMapAsync() ?? _map; }
        catch (Exception ex) { _error = $"RCS 后端未连接：{ex.Message}"; }
        try { _vehicle = await Api.GetVehicleAsync() ?? _vehicle; } catch { }
        Realtime.VehicleStateChanged += OnVehicleStateChanged;
        try { await Realtime.StartAsync(); } catch { }
    }

    private void SelectCell(GridPoint point)
    {
        if (_map.Obstacles.Contains(point)) return;
        if (_start is null || _end is not null) { _start = point; _end = null; _route = new(); }
        else if (point != _start) _end = point;
    }

    private async Task Preview()
    {
        if (!CanCalculate) return;
        try { _route = await Api.PreviewAsync(new RunVehicleRequest { Start = _start!.Value, End = _end!.Value }) ?? new(); _error = _route.Message ?? ""; }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task Run()
    {
        if (!CanCalculate) return;
        await Preview();
        if (!_route.Found) return;
        try { await Api.RunAsync(new RunVehicleRequest { Start = _start!.Value, End = _end!.Value }); } catch (Exception ex) { _error = ex.Message; }
    }

    private async Task Pause() { try { await Api.PauseAsync(); } catch (Exception ex) { _error = ex.Message; } }
    private async Task Reset() { _route = new(); _start = null; _end = null; _error = ""; try { await Api.ResetAsync(new GridPoint(1, 1)); } catch { } }
    private void OnVehicleStateChanged(VehicleStateDto state) { _vehicle = state; InvokeAsync(StateHasChanged); }
    private string CellClass(GridPoint point) => _map.Obstacles.Contains(point) ? "obstacle" : _route.Points.Contains(point) ? "path" : "";
    public void Dispose() => Realtime.VehicleStateChanged -= OnVehicleStateChanged;
}
