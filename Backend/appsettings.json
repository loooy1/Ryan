{
  "Urls": "http://0.0.0.0:8231",
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Microsoft.AspNetCore": "Error",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "FileLogging": {
    "SystemName": "WCS",
    "RootDirectory": "log",
    "MinimumLevel": "Information",
    "ConsoleMinimumLevel": "Error",
    "RetainedDays": 30,
    "FileSizeLimitMB": 100,
    "RecentBufferSize": 2000,
    "EnabledCategories": [ "Task", "Automation", "Module", "Inventory", "Http", "System" ],
    "CategoryRoutes": {
      "WCSBackend.Modules.Wcs.Automation.Tasks": "Task",
      "WCSBackend.Modules.Wcs.Automation.Templates": "Automation",
      "WCSBackend.Modules.Wcs.Automation.Runners": "Automation",
      "WCSBackend.Modules.Wcs.Automation.Modules": "Module",
      "WCSBackend.Modules.Wcs.Infrastructure.Inventory": "Inventory",
      "WCSBackend.Modules.Wcs.Proxy": "Http"
    }
  },
  "AllowedHosts": "*"
}
