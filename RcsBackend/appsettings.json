{
  "Urls": "http://0.0.0.0:8232",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FileLogging": {
    "SystemName": "RCS",
    "RootDirectory": "log",
    "MinimumLevel": "Information",
    "ConsoleMinimumLevel": "Error",
    "RetainedDays": 30,
    "FileSizeLimitMB": 100,
    "RecentBufferSize": 2000,
    "EnabledCategories": [ "Task", "Automation", "Algorithm", "Module", "Inventory", "Http", "System" ],
    "CategoryRoutes": {
      "Rcs.Algorithms": "Algorithm",
      "RCSBackend.Modules.Rcs.Application.Simulation": "Automation",
      "RCSBackend.Modules.Rcs.Infrastructure": "Automation"
    }
  },
  "AllowedHosts": "*"
}
