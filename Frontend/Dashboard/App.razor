@* ════════════════════════════════════════════════
   应用根组件：MudBlazor 全局提供者 + 路由表
   ── 说明 ── 三个 Provider 只需挂载一次：ThemeProvider 应用全局
   深色主题；DialogProvider 托管对话框；SnackbarProvider 托管消息条
   （各页面通过注入的 IDialogService / ISnackbar 使用，无需各自声明）
   ════════════════════════════════════════════════ *@
<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudDialogProvider />
<MudSnackbarProvider />

@* ── 路由：NotFoundPage 兜底 404；所有页面默认使用 MainLayout 三列布局 ── *@
<Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        @* FocusOnNavigate：导航后把焦点移到 h1 标题，辅助无障碍与键盘操作 *@
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>

@code {
    // 全局深色主题：统一各页面暗色风格（背景/表面/主色等 MudBlazor 令牌）
    private readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark()
        {
            Black = "#0f172a",
            Background = "#0f172a",
            Surface = "#1e293b",
            DrawerBackground = "#0c1222",
            DrawerText = "#e2e8f0",
            AppbarBackground = "#0c1222",
            AppbarText = "#e2e8f0",
            TextPrimary = "#e2e8f0",
            TextSecondary = "#94a3b8",
            Primary = "#38bdf8",
            Secondary = "#a78bfa",
            Tertiary = "#4ade80",
            Info = "#38bdf8",
            Success = "#4ade80",
            Warning = "#fb923c",
            Error = "#f87171",
            Dark = "#0f172a",
            DrawerIcon = "#94a3b8",
            ActionDefault = "#94a3b8",
            ActionDisabled = "#475569",
            Divider = "#1e293b",
            DividerLight = "#334155",
            TableLines = "#334155",
            TableHover = "#1e293b80",
            TextDisabled = "#475569",
            GrayLight = "#1e293b",
            GrayDark = "#0c1222",
            OverlayDark = "#00000080",
        }
    };
}
