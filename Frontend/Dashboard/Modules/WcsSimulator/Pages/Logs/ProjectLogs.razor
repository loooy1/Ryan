    private void RemoveContentLine(int index)
    {
        if (index >= 0 && index < _sectionLines.Count) _sectionLines.RemoveAt(index);
    }

    private void MoveContentLine(int index, int offset)
    {
        var target = index + offset;
        if (index < 0 || index >= _sectionLines.Count || target < 0 || target >= _sectionLines.Count) return;
        (_sectionLines[index], _sectionLines[target]) = (_sectionLines[target], _sectionLines[index]);
    }

    private static List<ProjectContentLine> ParseMarkdownLines(string markdown)
    {
        var lines = new List<ProjectContentLine>();
        char? fenceCharacter = null;
        var fenceLength = 0;
        foreach (var raw in (markdown ?? "").Replace("\r\n", "\n").Replace('\r', '\n').Split('\n'))
        {
            var text = raw.TrimEnd();
            if (fenceCharacter.HasValue)
            {
                lines.Add(new ProjectContentLine { Kind = "literal", Text = raw });
                if (TryReadMarkdownFence(text, out var closingCharacter, out var closingLength, out var closingTail)
                    && closingCharacter == fenceCharacter.Value
                    && closingLength >= fenceLength
                    && string.IsNullOrWhiteSpace(closingTail))
                {
                    fenceCharacter = null;
                    fenceLength = 0;
                }
                continue;
            }

            if (TryReadMarkdownFence(text, out var openingCharacter, out var openingLength, out _))
            {
                lines.Add(new ProjectContentLine { Kind = "literal", Text = raw });
                fenceCharacter = openingCharacter;
                fenceLength = openingLength;
                continue;
            }

            if (string.IsNullOrWhiteSpace(text)) continue;
            var trimmed = text.TrimStart();
            var headingLevel = 0;
            while (headingLevel < trimmed.Length && headingLevel < 6 && trimmed[headingLevel] == '#') headingLevel++;
            if (headingLevel > 0 && headingLevel < trimmed.Length && trimmed[headingLevel] == ' ')
                lines.Add(new ProjectContentLine { Kind = "heading", HeadingLevel = headingLevel, Text = trimmed[(headingLevel + 1)..] });
            else if (trimmed.StartsWith("- ") || trimmed.StartsWith("* ")) lines.Add(new ProjectContentLine { Kind = "bullet", Text = trimmed[2..] });
            else if (trimmed.StartsWith("> ")) lines.Add(new ProjectContentLine { Kind = "quote", Text = trimmed[2..] });
            else lines.Add(new ProjectContentLine { Kind = "paragraph", Text = text });
        }
        return lines;
    }

    private static string ComposeMarkdown(IEnumerable<ProjectContentLine> lines)
    {
        var output = new System.Text.StringBuilder();
        var previousWasLiteral = false;
        foreach (var line in lines.Where(line => line.Kind == "literal" || !string.IsNullOrWhiteSpace(line.Text)))
        {
            var isLiteral = line.Kind == "literal";
            if (output.Length > 0) output.Append(isLiteral && previousWasLiteral ? "\n" : "\n\n");
            var text = line.Kind switch
            {
                "heading" => new string('#', Math.Clamp(line.HeadingLevel, 1, 6)) + " " + line.Text.Trim(),
                "bullet" => "- " + line.Text.Trim(),
                "quote" => "> " + line.Text.Trim(),
                "literal" => line.Text,
                _ => line.Text.Trim()
            };
            output.Append(text);
            previousWasLiteral = isLiteral;
        }

        return CloseUnclosedMarkdownFence(output.ToString());
    }

    private static string CloseUnclosedMarkdownFence(string markdown)
    {
        char? fenceCharacter = null;
        var fenceLength = 0;
        foreach (var line in markdown.Replace("\r\n", "\n").Split('\n'))
        {
            if (!TryReadMarkdownFence(line, out var marker, out var length, out var tail)) continue;
            if (!fenceCharacter.HasValue)
            {
                fenceCharacter = marker;
                fenceLength = length;
            }
            else if (marker == fenceCharacter.Value && length >= fenceLength && string.IsNullOrWhiteSpace(tail))
            {
                fenceCharacter = null;
                fenceLength = 0;
            }
        }

        if (!fenceCharacter.HasValue) return markdown;
        var closingFence = new string(fenceCharacter.Value, fenceLength);
        return markdown.TrimEnd() + "\n" + closingFence;
    }

    private static bool TryReadMarkdownFence(string line, out char marker, out int length, out string tail)
    {
        marker = '\0';
        length = 0;
        tail = "";
        var leadingSpaces = 0;
        while (leadingSpaces < line.Length && line[leadingSpaces] == ' ') leadingSpaces++;
        if (leadingSpaces > 3 || leadingSpaces >= line.Length) return false;
        marker = line[leadingSpaces];
        if (marker != '`' && marker != '~') return false;
        var index = leadingSpaces;
        while (index < line.Length && line[index] == marker) index++;
        length = index - leadingSpaces;
        if (length < 3) return false;
        tail = line[index..];
        return true;
    }

    private static string SafeFileName(string name)
        => System.Text.RegularExpressions.Regex.Replace(name.Trim(), "[\\x00-\\x1F<>:\"/\\\\|?*]", "_");

    private static string SectionIcon(string key) => key switch
    {
        "overview" => "📌", "risks" => "⚠️", "deployment" => "🛠️",
        "data" => "📊", "owners" => "👥", _ => "🗂️"
    };

    private static bool IsSupplementarySection(ProjectSectionDto section)
        => string.Equals(section.Key, "supplement", StringComparison.OrdinalIgnoreCase)
            || string.Equals(section.Key, "additional", StringComparison.OrdinalIgnoreCase)
            || section.Title.Contains("补充", StringComparison.Ordinal);

    private List<ProjectSectionDto> GetOrderedSectionsForExport()
        => _projectSections
            .OrderBy(section => IsSupplementarySection(section) ? 2
                : string.Equals(section.Key, "deployment", StringComparison.OrdinalIgnoreCase)
                    || section.Title.Contains("部署", StringComparison.Ordinal) ? 1 : 0)
            .ToList();

    private static string SectionSummary(ProjectSectionDto section)
    {
        var text = (section.MarkdownContent ?? "").Trim();
        if (text.Length == 0) return "尚未填写 · 点击添加项目资料";
        text = System.Text.RegularExpressions.Regex.Replace(text, "[#*`>\\[\\]_-]", "");
        text = System.Text.RegularExpressions.Regex.Replace(text, "\\s+", " ").Trim();
        return text.Length > 82 ? text[..82] + "…" : text;
    }

    private static string RenderMarkdown(string markdown)
    {
        var lines = (markdown ?? "").Replace("\r\n", "\n").Replace('\r', '\n').Split('\n');
        var html = new System.Text.StringBuilder();
        var listOpen = false;
        char? codeFence = null;
        var codeFenceLength = 0;
        var codeContent = new System.Text.StringBuilder();
        foreach (var raw in lines)
        {
            var trimmed = raw.Trim();
            if (TryReadMarkdownFence(raw, out var marker, out var markerLength, out var markerTail))
            {
                if (!codeFence.HasValue)
                {
                    if (listOpen) { html.Append("</ul>"); listOpen = false; }
                    codeFence = marker;
                    codeFenceLength = markerLength;
                    codeContent.Clear();
                }
                else if (marker == codeFence.Value && markerLength >= codeFenceLength && string.IsNullOrWhiteSpace(markerTail))
                {
                    html.Append("<pre><code>")
                        .Append(System.Text.Encodings.Web.HtmlEncoder.Default.Encode(codeContent.ToString().TrimEnd('\n')))
                        .AppendLine("</code></pre>");
                    codeFence = null;
                    codeFenceLength = 0;
                    codeContent.Clear();
                }
                else if (codeFence.HasValue) codeContent.Append(raw).Append('\n');
                continue;
            }
            if (codeFence.HasValue)
            {
                codeContent.Append(raw).Append('\n');
                continue;
            }
            if (trimmed.Length == 0)
            {
                if (listOpen) { html.Append("</ul>"); listOpen = false; }
                continue;
            }
            if (trimmed.StartsWith("- ") || trimmed.StartsWith("* "))
            {
                if (!listOpen) { html.Append("<ul>"); listOpen = true; }
                html.Append("<li>").Append(RenderInline(trimmed[2..])).Append("</li>");
                continue;
            }
            if (listOpen) { html.Append("</ul>"); listOpen = false; }
            var level = 0;
            while (level < trimmed.Length && level < 6 && trimmed[level] == '#') level++;
            if (level > 0 && level < trimmed.Length && trimmed[level] == ' ')
                html.Append("<h").Append(level).Append('>').Append(RenderInline(trimmed[(level + 1)..])).Append("</h").Append(level).Append('>');
            else if (trimmed.StartsWith("> ")) html.Append("<blockquote>").Append(RenderInline(trimmed[2..])).Append("</blockquote>");
            else html.Append("<p>").Append(RenderInline(trimmed)).Append("</p>");
        }
        if (codeFence.HasValue)
            html.Append("<pre><code>")
                .Append(System.Text.Encodings.Web.HtmlEncoder.Default.Encode(codeContent.ToString().TrimEnd('\n')))
                .AppendLine("</code></pre>");
        if (listOpen) html.Append("</ul>");
        return html.ToString();
    }

    private static string RenderInline(string text)
    {
        var safe = System.Text.Encodings.Web.HtmlEncoder.Default.Encode(text);
        safe = System.Text.RegularExpressions.Regex.Replace(safe, "\\*\\*(.+?)\\*\\*", "<strong>$1</strong>");
        return System.Text.RegularExpressions.Regex.Replace(safe, "`(.+?)`", "<code>$1</code>");
    }

