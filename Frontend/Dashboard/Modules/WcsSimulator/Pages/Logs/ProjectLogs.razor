    private static string RenderSectionText(string markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown)) return "暂无内容";

        // The deployment section may itself contain a details wrapper copied from an older export.
        // Remove only that outer wrapper because the current export already supplies the section toggle.
        markdown = System.Text.RegularExpressions.Regex.Replace(
            markdown.Trim(),
            @"^<details>\s*<summary>.*?</summary>\s*|\s*</details>$",
            "",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.Singleline);

        var lines = markdown.Replace("\r\n", "\n").Replace('\r', '\n').Split('\n');
        var html = new System.Text.StringBuilder();
        var inCodeBlock = false;
        var hasContent = false;
        foreach (var rawLine in lines)
        {
            var trimmed = rawLine.Trim();
            if (trimmed.StartsWith("```") || trimmed.StartsWith("~~~"))
            {
                inCodeBlock = !inCodeBlock;
                continue;
            }
            if (trimmed.Length == 0) continue;
            if (inCodeBlock) trimmed = "  " + trimmed;
            else if (trimmed.StartsWith("### ")) trimmed = "【" + trimmed[4..] + "】";
            else if (trimmed.StartsWith("## ")) trimmed = "【" + trimmed[3..] + "】";
            else if (trimmed.StartsWith("# ")) trimmed = "【" + trimmed[2..] + "】";
            else if (trimmed.StartsWith("- ") || trimmed.StartsWith("* ")) trimmed = "• " + trimmed[2..];
            else if (trimmed.StartsWith("> ")) trimmed = "— " + trimmed[2..];

            if (hasContent) html.Append("<br>");
            html.Append(System.Net.WebUtility.HtmlEncode(trimmed));
            hasContent = true;
        }
        return hasContent ? html.ToString() : "暂无内容";
    }

