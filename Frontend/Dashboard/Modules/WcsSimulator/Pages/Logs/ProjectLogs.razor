@namespace Dashboard.Modules.WcsSimulator.Pages
@page "/wcs-simulator/project-records"
@inject IJSRuntime Js
@inject WcsApiClient WcsApi
@inject LocalStoreService LocalStore
@using Dashboard.Modules.WcsSimulator.Services
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>项目记录</PageTitle>

<div class="section-card project-records-page">
    <div class="project-page-header">
        <div>
            <div class="project-workspace-eyebrow">PROJECT WORKSPACE</div>
            <div style="display:flex;align-items:center;gap:4px;flex-wrap:wrap;">
                <h1 style="margin:0;">项目记录</h1>
                @if (!string.IsNullOrWhiteSpace(_currentProject))
                {
                    <span class="project-current-tag" style="margin-left:0;">● @_currentProject</span>
                }
            </div>
            <p>为每个项目集中维护概览、风险、部署资料、数据和责任人。</p>
        </div>
        <div class="project-page-actions">
            <button class="btn btn-outline" @onclick="DownloadProjectMarkdown"
                    disabled="@(string.IsNullOrWhiteSpace(_currentProject) || _projectSectionsLoading || _projectSections.Count == 0)"
                    title="下载不带折叠内容的 Markdown 项目记录">⬇ 下载 Markdown</button>
            <button class="btn btn-outline" @onclick="DownloadProjectHtml"
                    disabled="@(string.IsNullOrWhiteSpace(_currentProject) || _projectSectionsLoading || _projectSections.Count == 0)"
                    title="下载可展开阅读的独立 HTML 项目记录">⬇ 下载 HTML</button>
            <button class="btn btn-outline" @onclick="ExportProjectPdf"
                    disabled="@(string.IsNullOrWhiteSpace(_currentProject) || _projectSectionsLoading || _projectSections.Count == 0)"
                    title="直接下载项目记录 PDF 文件">⬇ 下载 PDF</button>
        </div>
    </div>

    <div class="project-picker-panel">
        <div class="project-picker-label"><span>当前项目</span><small>切换后显示该项目的资料分区</small></div>
        @if (_projectsLoading)
        {
            <div class="project-picker-loading">正在读取项目…</div>
        }
        else if (_projects.Count > 0)
        {
            <select value="@_currentProject" @onchange="OnProjectChanged" aria-label="选择项目">
                @foreach (var project in _projects)
                {
                    <option value="@project">@project</option>
                }
            </select>
        }
        else
        {
            <div class="project-picker-empty">还没有项目，点击“新建项目”开始建立项目资料。</div>
        }
        <button class="btn btn-primary btn-sm" @onclick="CreateProject">＋ 新建项目</button>
        @if (!string.IsNullOrWhiteSpace(_currentProject))
        {
            <button class="btn btn-outline btn-sm" @onclick="OpenRenameProject">重命名</button>
            <button class="btn btn-outline btn-sm project-delete-button" @onclick="DeleteProject">删除项目</button>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_currentProject))
    {
        <section class="project-workspace">
            <div class="project-workspace-heading">
                <div>
                    <h2>@_currentProject</h2>
                    <p>点击分区查看或编辑。正文支持 Markdown，内容较长时可在弹窗内滚动阅读。</p>
                </div>
                <div class="project-workspace-meta">@_projectSections.Count 个资料分区</div>
            </div>
            @if (_projectSectionsLoading)
            {
                <div class="project-section-loading">正在读取项目资料…</div>
            }
            else if (_projectSections.Count == 0)
            {
                <div class="project-section-loading">项目资料暂时无法加载，请检查 WCS 后端连接。</div>
            }
            else
            {
                <div class="project-section-grid">
                    @foreach (var section in _projectSections)
                    {
                        <button class="project-section-card" @onclick="() => OpenProjectSection(section)">
                            <span class="project-section-icon">@SectionIcon(section.Key)</span>
                            <span class="project-section-copy"><strong>@section.Title</strong><span>@SectionSummary(section)</span></span>
                            <span class="project-section-open">打开 →</span>
                        </button>
                    }
                </div>
            }
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(_feedback))
    {
        <div class="response-panel @(_feedbackClass)" style="margin-top:14px;">@_feedback</div>
    }
</div>

@if (_activeProjectSection != null)
{
    <div class="template-modal-overlay project-section-overlay" @onclick="CloseProjectSection">
        <div class="project-section-modal" @onclick:stopPropagation>
            <header class="project-section-modal-header">
                <div class="project-section-modal-title">
                    <span class="project-section-icon">@SectionIcon(_activeProjectSection.Key)</span>
                    <div><h2>@_activeProjectSection.Title</h2><p>@_currentProject · Markdown 项目资料</p></div>
                </div>
                <div class="project-section-modal-actions">
                    <label class="btn btn-outline project-upload-label" title="上传 Markdown 文件到当前分区">
                        ⬆ 上传 Markdown
                        <InputFile class="project-upload-input" accept=".md,.markdown,text/markdown" OnChange="UploadMarkdownFile" />
                    </label>
                    <button class="btn btn-outline" @onclick="ToggleSectionEdit">@(_sectionEditing ? "👁 预览" : "✏ 编辑")</button>
                    @if (_sectionEditing)
                    {
                        <button class="btn btn-primary" @onclick="SaveProjectSection" disabled="@_sectionSaving">@(_sectionSaving ? "保存中…" : "保存资料")</button>
                    }
                    <button class="tpl-modal-close" @onclick="CloseProjectSection" title="关闭">✕</button>
                </div>
            </header>
            <div class="project-section-modal-body">
                @if (_sectionEditing)
                {
                    <div class="project-markdown-editor">
                        <div class="project-line-editor-toolbar">
                            <div><strong>分条填写</strong><span>每个内容块单独编辑，保存时自动排版。</span></div>
                            <div class="project-line-add-actions">
                                <button class="btn btn-outline btn-sm project-line-delete" @onclick="ClearAllContentLines" disabled="@(_sectionLines.Count == 0)" title="清空当前分区的全部内容，保存后生效">清空所有栏</button>
                                <button class="btn btn-outline btn-sm" @onclick='() => AddContentLine("paragraph")'>＋ 正文</button>
                                <button class="btn btn-outline btn-sm" @onclick='() => AddContentLine("heading")'>＋ 标题</button>
                                <button class="btn btn-outline btn-sm" @onclick='() => AddContentLine("bullet")'>＋ 列表项</button>
                            </div>
                        </div>
                        @if (_sectionLines.Count == 0)
                        {
                            <div class="project-line-empty">还没有内容，点击上方按钮添加一条。</div>
                        }
                        <div class="project-line-list">
                            @for (var i = 0; i < _sectionLines.Count; i++)
                            {
                                var index = i;
                                var line = _sectionLines[index];
                                <div class="project-line-row">
                                    <select class="project-line-kind" @bind="line.Kind" aria-label="内容类型">
                                        <option value="paragraph">正文</option>
                                        <option value="heading">标题</option>
                                        <option value="bullet">列表项</option>
                                        <option value="quote">引用</option>
                                        <option value="literal">代码/原文</option>
                                    </select>
                                    @if (line.Kind == "heading")
                                    {
                                        <select class="project-line-kind" @bind="line.HeadingLevel" aria-label="标题级别">
                                            <option value="1">H1</option><option value="2">H2</option><option value="3">H3</option>
                                            <option value="4">H4</option><option value="5">H5</option><option value="6">H6</option>
                                        </select>
                                    }
                                    <textarea @bind="line.Text" @bind:event="oninput" rows="@(line.Text.Length > 90 ? 3 : 1)" placeholder="输入这一条内容…"></textarea>
                                    <div class="project-line-controls">
                                        <button class="btn btn-outline btn-xs" @onclick="() => MoveContentLine(index, -1)" disabled="@(index == 0)" title="上移">↑</button>
                                        <button class="btn btn-outline btn-xs" @onclick="() => MoveContentLine(index, 1)" disabled="@(index == _sectionLines.Count - 1)" title="下移">↓</button>
                                        <button class="btn btn-outline btn-xs project-line-delete" @onclick="() => RemoveContentLine(index)" title="删除此条">删除</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else if (string.IsNullOrWhiteSpace(_sectionDraft))
                {
                    <div class="project-markdown-empty"><span>📝</span><h3>这个分区还没有内容</h3><p>点击右上角“编辑”，开始填写项目资料。</p></div>
                }
                else
                {
                    <article class="project-markdown-preview">@((MarkupString)RenderMarkdown(_sectionDraft))</article>
                }
                @if (!string.IsNullOrWhiteSpace(_sectionError))
                {
                    <div class="response-panel error" style="margin-top:12px;">@_sectionError</div>
                }
                @if (!string.IsNullOrWhiteSpace(_sectionSavedAt) && !_sectionEditing)
                {
                    <div class="project-section-updated">最近保存：@_sectionSavedAt</div>
                }
            </div>
        </div>
    </div>
}

@if (_newProjectVisible)
{
    <div class="template-modal-overlay" @onclick="CancelNewProject">
        <div class="tpl-modal" @onclick:stopPropagation style="max-width:460px;">
            <div class="tpl-modal-header"><div class="tpl-modal-title">新建项目</div><button class="tpl-modal-close" @onclick="CancelNewProject">✕</button></div>
            <div class="tpl-modal-body">
                <div class="hint-text" style="margin-bottom:12px;">新项目会自动建立项目概览、风险、部署文档、项目数据、责任人和补充说明分区。</div>
                <input type="text" @bind="_newProjectValue" @bind:event="oninput" maxlength="191" placeholder="输入项目名称" style="width:100%;" />
                @if (!string.IsNullOrWhiteSpace(_newProjectError)) { <div class="tpl-error" style="margin-top:10px;">@_newProjectError</div> }
            </div>
            <div class="tpl-modal-footer">
                <button class="btn btn-outline" @onclick="CancelNewProject">取消</button>
                <button class="btn btn-primary" @onclick="NewProjectConfirm" disabled="@(_creatingProject || string.IsNullOrWhiteSpace(_newProjectValue))">@(_creatingProject ? "创建中…" : "创建项目")</button>
            </div>
        </div>
    </div>
}

@if (_passwordVisible)
{
    <div class="template-modal-overlay" @onclick="CancelPassword">
        <div class="tpl-modal" @onclick:stopPropagation style="max-width:440px;">
            <div class="tpl-modal-header"><div class="tpl-modal-title">🔒 删除项目</div><button class="tpl-modal-close" @onclick="CancelPassword">✕</button></div>
            <div class="tpl-modal-body">
                <div class="hint-text" style="white-space:pre-wrap;color:#e2e8f0;margin-bottom:12px;">@_passwordMessage</div>
                <input type="password" @bind="_passwordValue" placeholder="请输入删除密码" style="width:100%;" />
            </div>
            <div class="tpl-modal-footer">
                <button class="btn btn-outline" @onclick="CancelPassword">取消</button>
                <button class="btn btn-danger" @onclick="PasswordConfirm" disabled="@(string.IsNullOrEmpty(_passwordValue))">确认删除</button>
            </div>
        </div>
    </div>
}

@if (_renameVisible)
{
    <div class="template-modal-overlay" @onclick="CancelRenameProject">
        <div class="tpl-modal" @onclick:stopPropagation style="max-width:460px;">
            <div class="tpl-modal-header"><div class="tpl-modal-title">✏ 重命名项目</div><button class="tpl-modal-close" @onclick="CancelRenameProject">✕</button></div>
            <div class="tpl-modal-body">
                <div class="form-group"><label>新项目名称</label><input type="text" @bind="_renameProjectValue" @bind:event="oninput" maxlength="191" /></div>
                <div class="form-group"><label>密码</label><input type="password" @bind="_renamePasswordValue" placeholder="请输入密码" /></div>
                @if (!string.IsNullOrWhiteSpace(_renameError)) { <div class="tpl-error">@_renameError</div> }
            </div>
            <div class="tpl-modal-footer">
                <button class="btn btn-outline" @onclick="CancelRenameProject">取消</button>
                <button class="btn btn-primary" @onclick="ConfirmRenameProject" disabled="@(_renamingProject || string.IsNullOrWhiteSpace(_renameProjectValue) || string.IsNullOrWhiteSpace(_renamePasswordValue))">@(_renamingProject ? "重命名中…" : "确认重命名")</button>
            </div>
        </div>
    </div>
}

@code {
    private const string ProjectStoreKey = "grcs_pl_project";
    private List<string> _projects = [];
    private List<ProjectSectionDto> _projectSections = [];
    private string _currentProject = "";
    private bool _projectsLoading;
    private bool _projectSectionsLoading;
    private bool _newProjectVisible;
    private bool _creatingProject;
    private string _newProjectValue = "";
    private string _newProjectError = "";
    private ProjectSectionDto? _activeProjectSection;
    private List<ProjectContentLine> _sectionLines = [];
    private string _sectionDraft = "";
    private string? _uploadedMarkdownOriginal;
    private string? _uploadedMarkdownLinesSnapshot;
    private string _sectionSavedAt = "";
    private string _sectionError = "";
    private bool _sectionEditing;
    private bool _sectionSaving;
    private string _feedback = "";
    private string _feedbackClass = "";
    private bool _passwordVisible;
    private string _passwordValue = "";
    private string _passwordMessage = "";
    private bool _renameVisible;
    private bool _renamingProject;
    private string _renameProjectValue = "";
    private string _renamePasswordValue = "";
    private string _renameError = "";

    protected override async Task OnInitializedAsync()
    {
        _projectsLoading = true;
        try
        {
            _projects = (await WcsApi.GetAsync<List<ProjectWorkspaceDto>>("/api/wcs/projects") ?? [])
                .Select(project => project.Name).Where(name => !string.IsNullOrWhiteSpace(name)).ToList();
            var saved = LocalStore.Get(ProjectStoreKey);
            _currentProject = !string.IsNullOrWhiteSpace(saved) && _projects.Contains(saved)
                ? saved
                : _projects.FirstOrDefault() ?? "";
        }
        catch (Exception ex) { ShowFeedback("项目列表加载失败：" + ex.Message, "error"); }
        finally { _projectsLoading = false; }
        await LoadProjectSectionsAsync();
    }

    private async Task OnProjectChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _currentProject = e.Value?.ToString() ?? "";
        await LocalStore.SetAsync(Js, ProjectStoreKey, _currentProject);
        CloseProjectSection();
        await LoadProjectSectionsAsync();
    }

    private async Task LoadProjectSectionsAsync()
    {
        _projectSectionsLoading = true;
        _projectSections = [];
        try
        {
            if (!string.IsNullOrWhiteSpace(_currentProject))
                _projectSections = await WcsApi.GetAsync<List<ProjectSectionDto>>($"/api/wcs/projects/{Uri.EscapeDataString(_currentProject)}/sections") ?? [];
        }
        catch (Exception ex) { ShowFeedback("项目资料加载失败：" + ex.Message, "error"); }
        finally { _projectSectionsLoading = false; }
    }

    private void CreateProject()
    {
        _newProjectValue = "";
        _newProjectError = "";
        _newProjectVisible = true;
    }

    private void CancelNewProject() => _newProjectVisible = false;

    private async Task NewProjectConfirm()
    {
        var name = _newProjectValue.Trim();
        if (name.Length == 0) { _newProjectError = "请输入项目名称"; return; }
        if (_projects.Contains(name, StringComparer.OrdinalIgnoreCase)) { _newProjectError = "该项目名称已存在"; return; }
        _creatingProject = true;
        _newProjectError = "";
        try
        {
            var result = await WcsApi.PostAsync<object, ProjectCreateResult>("/api/wcs/projects", new { name });
            if (result?.Success != true) { _newProjectError = result?.Message ?? "创建失败，请检查 WCS 后端连接"; return; }
            _projects.Add(name);
            _currentProject = name;
            await LocalStore.SetAsync(Js, ProjectStoreKey, name);
            _newProjectVisible = false;
            await LoadProjectSectionsAsync();
            ShowFeedback($"已创建项目“{name}”", "success");
        }
        catch (Exception ex) { _newProjectError = "创建失败：" + ex.Message; }
        finally { _creatingProject = false; }
    }

    private void DeleteProject()
    {
        _passwordValue = "";
        _passwordMessage = $"确认删除项目“{_currentProject}”及其资料吗？此操作不可恢复。请输入删除密码：";
        _passwordVisible = true;
    }

    private void OpenRenameProject()
    {
        _renameProjectValue = _currentProject;
        _renamePasswordValue = "";
        _renameError = "";
        _renameVisible = true;
    }

    private void CancelRenameProject() => _renameVisible = false;

    private async Task ConfirmRenameProject()
    {
        var newName = _renameProjectValue.Trim();
        if (newName.Length == 0) { _renameError = "项目名称不能为空"; return; }
        if (newName.Length > 191) { _renameError = "项目名称不能超过 191 个字符"; return; }
        if (newName == _currentProject) { _renameVisible = false; return; }

        _renamingProject = true;
        _renameError = "";
        try
        {
            var oldName = _currentProject;
            var (ok, statusCode, json) = await WcsApi.PutWithStatusAsync(
                $"/api/wcs/projects/{Uri.EscapeDataString(oldName)}",
                new { NewName = newName, Password = _renamePasswordValue });
            if (!ok) throw new InvalidOperationException(ReadApiMessage(json, $"重命名失败（HTTP {statusCode}）"));

            var index = _projects.IndexOf(oldName);
            if (index >= 0) _projects[index] = newName;
            _currentProject = newName;
            await LocalStore.SetAsync(Js, ProjectStoreKey, newName);
            _renameVisible = false;
            CloseProjectSection();
            await LoadProjectSectionsAsync();
            ShowFeedback($"项目已重命名为“{newName}”", "success");
        }
        catch (Exception ex) { _renameError = ex.Message; }
        finally { _renamingProject = false; }
    }

    private static string ReadApiMessage(string json, string fallback)
    {
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(json);
            if (document.RootElement.TryGetProperty("message", out var message) && message.ValueKind == System.Text.Json.JsonValueKind.String)
                return message.GetString() ?? fallback;
        }
        catch { }
        return fallback;
    }

    private void CancelPassword() => _passwordVisible = false;

    private async Task PasswordConfirm()
    {
        var password = _passwordValue;
        _passwordVisible = false;
        try
        {
            var deleteSucceeded = await WcsApi.DeleteAsync($"/api/wcs/projects/{Uri.EscapeDataString(_currentProject)}?password={Uri.EscapeDataString(password)}");
            if (!deleteSucceeded) throw new InvalidOperationException("密码错误或后端拒绝了删除请求");
            var deleted = _currentProject;
            _projects.Remove(deleted);
            _currentProject = _projects.FirstOrDefault() ?? "";
            await LocalStore.SetAsync(Js, ProjectStoreKey, _currentProject);
            CloseProjectSection();
            await LoadProjectSectionsAsync();
            ShowFeedback($"已删除项目“{deleted}”", "success");
        }
        catch (Exception ex) { ShowFeedback("删除失败：" + ex.Message, "error"); }
    }

    private void OpenProjectSection(ProjectSectionDto section)
    {
        _activeProjectSection = section;
        _sectionDraft = section.MarkdownContent ?? "";
        _sectionLines = ParseMarkdownLines(_sectionDraft);
        _uploadedMarkdownOriginal = null;
        _uploadedMarkdownLinesSnapshot = null;
        _sectionSavedAt = section.UpdatedAt ?? "";
        _sectionEditing = false;
        _sectionError = "";
    }

    private void CloseProjectSection()
    {
        _activeProjectSection = null;
        _sectionEditing = false;
        _uploadedMarkdownOriginal = null;
        _uploadedMarkdownLinesSnapshot = null;
        _sectionError = "";
    }

    private void ToggleSectionEdit()
    {
        if (_sectionEditing)
        {
            _sectionDraft = GetCurrentSectionMarkdown();
        }
        else
        {
            _sectionLines = ParseMarkdownLines(_sectionDraft);
            if (_sectionLines.Count == 0) _sectionLines.Add(new ProjectContentLine());
            if (_uploadedMarkdownOriginal != null)
                _uploadedMarkdownLinesSnapshot = ComposeMarkdown(_sectionLines);
        }
        _sectionEditing = !_sectionEditing;
        _sectionError = "";
    }

    private async Task SaveProjectSection()
    {
        if (_activeProjectSection == null) return;
        _sectionSaving = true;
        _sectionError = "";
        try
        {
            _sectionDraft = GetCurrentSectionMarkdown();
            var result = await WcsApi.PutAsync<object, ProjectSectionSaveResult>(
                $"/api/wcs/projects/{Uri.EscapeDataString(_currentProject)}/sections/{Uri.EscapeDataString(_activeProjectSection.Key)}",
                new { markdownContent = _sectionDraft });
            if (result?.Success != true) { _sectionError = result?.Message ?? "保存失败，请检查 WCS 后端连接"; return; }
            _activeProjectSection.MarkdownContent = _sectionDraft;
            _activeProjectSection.UpdatedAt = result.Data?.UpdatedAt ?? DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
            _sectionSavedAt = _activeProjectSection.UpdatedAt;
            _sectionEditing = false;
            _uploadedMarkdownOriginal = null;
            _uploadedMarkdownLinesSnapshot = null;
            ShowFeedback($"已保存“{_activeProjectSection.Title}”", "success");
        }
        catch (Exception ex) { _sectionError = "保存失败：" + ex.Message; }
        finally { _sectionSaving = false; }
    }

    private async Task UploadMarkdownFile(InputFileChangeEventArgs args)
    {
        if (_activeProjectSection == null) return;
        var file = args.File;
        var extension = Path.GetExtension(file.Name);
        if (!extension.Equals(".md", StringComparison.OrdinalIgnoreCase)
            && !extension.Equals(".markdown", StringComparison.OrdinalIgnoreCase))
        {
            _sectionError = "请选择 .md 或 .markdown 文件";
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(10 * 1024 * 1024);
            using var reader = new System.IO.StreamReader(stream, System.Text.Encoding.UTF8, detectEncodingFromByteOrderMarks: true);
            _sectionDraft = await reader.ReadToEndAsync();
            _sectionLines = ParseMarkdownLines(_sectionDraft);
            if (_sectionLines.Count == 0) _sectionLines.Add(new ProjectContentLine());
            _uploadedMarkdownOriginal = _sectionDraft;
            _uploadedMarkdownLinesSnapshot = ComposeMarkdown(_sectionLines);
            _sectionEditing = true;
            _sectionError = "";
            ShowFeedback($"已载入 Markdown 文件“{file.Name}”，检查内容后点击“保存资料”写入项目。", "success");
        }
        catch (Exception ex) { _sectionError = "读取 Markdown 文件失败：" + ex.Message; }
    }

    private async Task DownloadProjectMarkdown()
    {
        if (string.IsNullOrWhiteSpace(_currentProject) || _projectSections.Count == 0) return;
        try
        {
            var sections = GetOrderedSectionsForExport();
            var content = new System.Text.StringBuilder();
            content.Append("# ").AppendLine(_currentProject + " 项目记录");
            content.AppendLine();
            content.Append("> 项目资料汇总 · 导出时间：").AppendLine(DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"));
            content.Append("> 资料分区：").Append(sections.Count).AppendLine(" 个");
            foreach (var section in sections)
            {
                var sectionContent = section.MarkdownContent ?? "";
                if (_activeProjectSection != null && string.Equals(_activeProjectSection.Key, section.Key, StringComparison.Ordinal))
                    sectionContent = _sectionEditing ? GetCurrentSectionMarkdown() : _sectionDraft;

                content.AppendLine().AppendLine("---").AppendLine().AppendLine("---").AppendLine();
                content.Append("## ").Append(SectionIcon(section.Key)).Append(' ').AppendLine(section.Title).AppendLine();
                var preparedContent = NormalizeMarkdownForDownload(sectionContent);
                content.AppendLine(string.IsNullOrWhiteSpace(preparedContent) ? "暂无内容" : preparedContent);
            }

            var fileName = $"{SafeFileName(_currentProject)}_项目记录.md";
            await Js.InvokeVoidAsync("downloadTextFile", fileName, content.ToString(), "text/markdown;charset=utf-8");
            ShowFeedback($"已下载项目“{_currentProject}”的 Markdown 文档。", "success");
        }
        catch (Exception ex)
        {
            ShowFeedback("下载 Markdown 失败：" + ex.Message, "error");
        }
    }

    private async Task DownloadProjectHtml()
    {
        if (string.IsNullOrWhiteSpace(_currentProject) || _projectSections.Count == 0) return;

        try
        {
            var html = BuildProjectHtml();
            var fileName = $"{SafeFileName(_currentProject)}_项目记录.html";
            await Js.InvokeVoidAsync("downloadTextFile", fileName, html, "text/html;charset=utf-8");
            ShowFeedback($"已下载项目“{_currentProject}”的 HTML 阅读页。", "success");
        }
        catch (Exception ex)
        {
            ShowFeedback("下载 HTML 失败：" + ex.Message, "error");
        }
    }

    private async Task ExportProjectPdf()
    {
        if (string.IsNullOrWhiteSpace(_currentProject) || _projectSections.Count == 0) return;
        try
        {
            var orderedSections = GetOrderedSectionsForExport();
            var sections = orderedSections
                .Select(section => new
                {
                    title = section.Title,
                    icon = SectionIcon(section.Key),
                    content = PrepareMarkdownForHtml(GetSectionContentForExport(section))
                })
                .ToList();
            var payload = new
            {
                title = _currentProject + " 项目记录",
                exportTime = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"),
                sections
            };
            await Js.InvokeVoidAsync("downloadProjectPdf", $"{SafeFileName(_currentProject)}_项目记录.pdf", payload);
            ShowFeedback($"已下载项目“{_currentProject}”的 PDF 文档。", "success");
        }
        catch (Exception ex)
        {
            ShowFeedback("下载 PDF 失败：" + ex.Message, "error");
        }
    }

    private string BuildProjectHtml()
    {
        var exportTime = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
        var sections = GetOrderedSectionsForExport();
        var projectTitle = System.Net.WebUtility.HtmlEncode(_currentProject);
        var html = new System.Text.StringBuilder();
        html.AppendLine("<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">");
        html.Append("<title>").Append(projectTitle).AppendLine(" 项目记录</title>");
        html.AppendLine("<style>");
        html.AppendLine(ExportHtmlStyles);
        html.AppendLine("</style></head><body><main class=\"page\">");
        html.Append("<header class=\"hero\"><div class=\"eyebrow\">PROJECT WORKSPACE</div><h1>")
            .Append(projectTitle).AppendLine(" 项目记录</h1>");
        html.Append("<p>项目资料汇总 · 导出时间：").Append(System.Net.WebUtility.HtmlEncode(exportTime))
            .Append(" · ").Append(sections.Count).AppendLine(" 个资料分区</p></header>");
        html.AppendLine("<nav class=\"toolbar\"><input id=\"search\" type=\"search\" placeholder=\"搜索项目资料…\" aria-label=\"搜索项目资料\"><button type=\"button\" onclick=\"setAll(true)\">全部展开</button><button type=\"button\" onclick=\"setAll(false)\">全部收起</button><button type=\"button\" onclick=\"window.print()\">打印 / 保存 PDF</button></nav>");
        html.AppendLine("<section id=\"sections\">");
        for (var i = 0; i < sections.Count; i++)
        {
            var section = sections[i];
            var sectionContent = section.MarkdownContent ?? "";
            if (_activeProjectSection != null && string.Equals(_activeProjectSection.Key, section.Key, StringComparison.Ordinal))
                sectionContent = _sectionEditing ? GetCurrentSectionMarkdown() : _sectionDraft;

            if (i > 0)
                html.AppendLine("<hr class=\"section-divider\" style=\"border:0;border-top:1px solid #cbd8e6;margin:9px 4px 4px\"><hr class=\"section-divider\" style=\"border:0;border-top:1px solid #cbd8e6;margin:4px 4px 20px\">");
            html.Append("<details class=\"section\"><summary><span class=\"icon\">")
                .Append(System.Net.WebUtility.HtmlEncode(SectionIcon(section.Key))).Append("</span><span>")
                .Append(System.Net.WebUtility.HtmlEncode(section.Title)).AppendLine("</span></summary>");
            html.Append("<article class=\"content\">").Append(RenderMarkdown(PrepareMarkdownForHtml(sectionContent)))
                .AppendLine("</article></details>");
        }
        html.AppendLine("</section><footer>由 WCS 项目记录导出 · ").Append(projectTitle).AppendLine("</footer></main>");
        html.AppendLine("<script>function setAll(open){document.querySelectorAll('details.section').forEach(x=>x.open=open)}document.getElementById('search').addEventListener('input',e=>{const q=e.target.value.trim().toLocaleLowerCase();document.querySelectorAll('details.section').forEach(x=>{x.hidden=q!==''&&!x.innerText.toLocaleLowerCase().includes(q);if(q&& !x.hidden)x.open=true})});</script>");
        html.AppendLine("</body></html>");
        return html.ToString();
    }

    private static string PrepareMarkdownForHtml(string markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown)) return "暂无内容";
        var lines = markdown.Trim().Replace("\r\n", "\n").Replace('\r', '\n').Split('\n');
        var result = new System.Text.StringBuilder();
        var outsideFence = new System.Text.StringBuilder();
        char? fenceCharacter = null;
        var fenceLength = 0;

        void FlushOutsideFence()
        {
            if (outsideFence.Length == 0) return;
            var text = System.Net.WebUtility.HtmlDecode(outsideFence.ToString());
            text = System.Text.RegularExpressions.Regex.Replace(
                text,
                @"<details>\s*<summary>(.*?)</summary>",
                match => "## " + System.Net.WebUtility.HtmlDecode(match.Groups[1].Value) + "\n",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.Singleline);
            text = System.Text.RegularExpressions.Regex.Replace(text, @"</details>", "\n", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            result.Append(text);
            outsideFence.Clear();
        }

        for (var index = 0; index < lines.Length; index++)
        {
            var line = lines[index];
            var hasNewline = index < lines.Length - 1;
            if (TryReadMarkdownFence(line, out var marker, out var markerLength, out var markerTail))
            {
                if (!fenceCharacter.HasValue)
                {
                    FlushOutsideFence();
                    fenceCharacter = marker;
                    fenceLength = markerLength;
                }
                else if (marker == fenceCharacter.Value && markerLength >= fenceLength && string.IsNullOrWhiteSpace(markerTail))
                {
                    result.Append(line);
                    if (hasNewline) result.Append('\n');
                    fenceCharacter = null;
                    fenceLength = 0;
                    continue;
                }

                result.Append(line);
                if (hasNewline) result.Append('\n');
                continue;
            }

            if (fenceCharacter.HasValue)
            {
                result.Append(line);
                if (hasNewline) result.Append('\n');
            }
            else
            {
                outsideFence.Append(line);
                if (hasNewline) outsideFence.Append('\n');
            }
        }

        FlushOutsideFence();
        return result.ToString().Trim();
    }

    private static string NormalizeMarkdownForDownload(string markdown)
    {
        var prepared = PrepareMarkdownForHtml(markdown);
        var lines = prepared.Replace("\r\n", "\n").Replace('\r', '\n').Split('\n');
        var result = new List<string>(lines.Length + 1);
        char? openFenceCharacter = null;
        var openFenceLength = 0;

        foreach (var line in lines)
        {
            var trimmed = line.TrimStart();
            if (TryReadMarkdownFence(line, out var marker, out var markerLength, out var markerTail))
            {
                if (!openFenceCharacter.HasValue)
                {
                    openFenceCharacter = marker;
                    openFenceLength = markerLength;
                }
                else if (marker == openFenceCharacter.Value && markerLength >= openFenceLength && string.IsNullOrWhiteSpace(markerTail))
                {
                    openFenceCharacter = null;
                    openFenceLength = 0;
                }
                result.Add(line);
                continue;
            }

            if (openFenceCharacter.HasValue)
            {
                result.Add(line);
                continue;
            }

            var headingLevel = 0;
            while (headingLevel < 6 && headingLevel < trimmed.Length && trimmed[headingLevel] == '#') headingLevel++;
            if (headingLevel > 0 && headingLevel < trimmed.Length && trimmed[headingLevel] == ' ')
            {
                var childLevel = Math.Max(3, Math.Min(6, headingLevel + 1));
                result.Add(new string('#', childLevel) + trimmed[headingLevel..]);
            }
            else result.Add(line);
        }

        if (openFenceCharacter.HasValue) result.Add(new string(openFenceCharacter.Value, openFenceLength));
        return string.Join("\n", result).Trim();
    }

    private string GetSectionContentForExport(ProjectSectionDto section)
    {
        if (_activeProjectSection == null || !string.Equals(_activeProjectSection.Key, section.Key, StringComparison.Ordinal))
            return section.MarkdownContent ?? "";
        return _sectionEditing ? GetCurrentSectionMarkdown() : _sectionDraft;
    }

    private string GetCurrentSectionMarkdown()
    {
        var composed = ComposeMarkdown(_sectionLines);
        if (_uploadedMarkdownOriginal != null
            && string.Equals(composed, _uploadedMarkdownLinesSnapshot, StringComparison.Ordinal))
            return _uploadedMarkdownOriginal;

        if (_uploadedMarkdownOriginal != null)
        {
            _uploadedMarkdownOriginal = null;
            _uploadedMarkdownLinesSnapshot = null;
        }
        return composed;
    }

