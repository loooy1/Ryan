@namespace Dashboard.Modules.WcsSimulator.Pages
@page "/wcs-simulator/inventory"
@inject WcsApiClient WcsService
@inherits Dashboard.Modules.WcsSimulator.Components.PageStateBase
@using System.Text.Json
@using Dashboard.Modules.WcsSimulator.Models
@using Microsoft.JSInterop
@implements IDisposable

<PageTitle>库存管理</PageTitle>

@* ════════════════════════════════════════════════
   WCS 手工入库：纯货物按框选储位写入；托盘由 RCS 批量生成后同步回 WCS。
   带货托仅展示，不可由此功能创建或覆盖。
   ════════════════════════════════════════════════ *@
<section class="inventory-workspace">
    <div class="inventory-workspace-header">
        🗺️ 库存地图与入库
        <span class="badge-info">已选 @_manualSelectedMarks.Count 个储位</span>
    </div>
    @if (_manualSlots.Count == 0)
    {
        <div class="hint-text" style="margin-top:10px;">请先到“地图信息”页读取地图。手工入库只允许框选已同步到 WCS 的空储位。</div>
    }
    else
    {
            <div class="manual-inventory-layout">
                <div>
                    <div class="manual-map-toolbar">
                        <span class="hint-text">灰=空闲，绿=纯托盘，青=纯货物，紫=带货托/在途，红=任务锁定</span>
                        <button class="btn btn-outline btn-sm" @onclick="RefreshManualSnapshot" disabled="@_manualLoading" style="margin-left:auto;">
                            @(_manualLoading ? "⏳ 刷新中..." : "🔄 刷新库存和位置")
                        </button>
                    </div>
                    <div id="manual-inventory-map" class="manual-map-canvas"></div>
                    @* 已由下方 Canvas 框选器替代。保留旧 SVG 仅为源代码迁移过渡，运行时不渲染。 *@
                </div>

                <aside class="manual-inventory-panel">
                    @if (_sortingEdit && _sortingSelectedMarks.Count > 0)
                    {
                        <div class="manual-sorting-actions">
                            <div class="manual-actions-title">分拣台关联</div>
                            <div class="manual-sorting-parent">人工分拣台 <code>@_sortingParentMark</code></div>
                            <div class="manual-selected-stations">
                                <b>已选实际分拣台（@_sortingSelectedMarks.Count）</b>
                                <div class="manual-selected-chips">
                                    @foreach (var mark in _sortingSelectedMarks.Order(StringComparer.OrdinalIgnoreCase))
                                    {
                                        <code>@mark</code>
                                    }
                                </div>
                            </div>
                            <div class="manual-action-grid">
                                <button class="btn btn-outline btn-sm" @onclick="SaveAndEndSortingAssociation" disabled="@_sortingSaving">关联并结束</button>
                            </div>
                        </div>
                    }
                    @if (!_sortingEdit)
                    {
                    <div class="form-group">
                        <label>库存类型</label>
                        <select @bind="_manualInventoryType" @bind:after="OnManualTypeChanged">
                            <option value="@ManualInventoryTypes.Pallet">托盘</option>
                            <option value="@ManualInventoryTypes.Cargo">纯货物</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>类型前缀</label>
                        <input type="text" @bind="_manualPrefix" @bind:event="oninput" placeholder="SimContainer_ / SimCargo_">
                    </div>
                    @if (_manualInventoryType == ManualInventoryTypes.Cargo)
                    {
                        <div class="form-group">
                            <label>RCS 货物模型</label>
                            <select @bind="_manualCargoSizeId" disabled="@_manualCargoSizesLoading">
                                @if (_manualCargoSizes.Count == 0)
                                {
                                    <option value="0">未读取到可用模型</option>
                                }
                                else
                                {
                                    @foreach (var size in _manualCargoSizes)
                                    {
                                        <option value="@size.Id">@size.Name（ID @size.Id，@size.Length × @size.Width × @size.Height）</option>
                                    }
                                }
                            </select>
                            <span class="hint-text">@(_manualCargoSizesLoading ? "正在读取 RCS 模型..." : "模型来自 RCS")</span>
                        </div>
                    }
                    <div class="manual-preview">
                        @if (_manualInventoryType == ManualInventoryTypes.Pallet)
                        {
                            <b>托盘生成方式</b>
                            <span>RCS 按前缀 <code>@_manualPrefix</code> 生成当前楼层全部空闲 RACK 储位的托盘。</span>
                            <span class="hint-text">请求数量固定为 -1；RCS 不支持指定托盘落位。</span>
                        }
                        else
                        {
                            <b>编码预览</b>
                            @foreach (var previewCode in ManualCodePreview)
                            {
                                <code>@previewCode</code>
                            }
                            @if (_manualSelectedMarks.Count > ManualCodePreview.Count())
                            {
                                <span>… 共 @_manualSelectedMarks.Count 条</span>
                            }
                            <span class="hint-text">确认时按服务器当前时间重新生成十六进制编号。</span>
                        }
                    </div>
                    <div class="manual-selected-stations">
                        <b>已选储位（@_manualSelectedMarks.Count）</b>
                        @if (_manualSelectedMarks.Count == 0)
                        {
                            <span class="hint-text">在左侧地图单击或框选空闲储位。</span>
                        }
                        else
                        {
                            <div class="manual-selected-chips">
                                @foreach (var mark in _manualSelectedMarks.Order(StringComparer.OrdinalIgnoreCase))
                                {
                                    <code>@mark</code>
                                }
                            </div>
                        }
                    </div>
                    <div class="manual-inventory-actions">
                        <div class="manual-actions-title">库存操作 <span>暂未接入</span></div>
                        <div class="manual-action-grid">
                            <button class="btn btn-outline btn-sm" @onclick="NoopInventoryAction" disabled="@(!CanStageAddPallet)">＋ 增加托盘</button>
                            <button class="btn btn-outline btn-sm" @onclick="NoopInventoryAction" disabled="@(!CanStageAddCargo)">＋ 增加货物</button>
                            <button class="btn btn-outline btn-sm manual-danger-btn" @onclick="NoopInventoryAction" disabled="@(!CanStageDeletePallet)">− 删除托盘</button>
                            <button class="btn btn-outline btn-sm manual-danger-btn" @onclick="NoopInventoryAction" disabled="@(!CanStageDeleteCargo)">− 删除货物</button>
                        </div>
                        <span class="hint-text">按钮仅展示可操作规则，当前点击不会修改 WCS 或 RCS。</span>
                    </div>
                    <button class="btn btn-primary manual-entry-btn" @onclick="ManualEnter" disabled="@(_manualSubmitting || (_manualInventoryType == ManualInventoryTypes.Cargo && (_manualSelectedMarks.Count == 0 || _manualCargoSizeId <= 0)))">
                        @(_manualSubmitting
                            ? "⏳ 处理中..."
                            : _manualInventoryType == ManualInventoryTypes.Pallet
                                ? "由 RCS 生成当前楼层全部托盘并同步 WCS"
                                : $"确认增加 {_manualSelectedMarks.Count} 条货物")
                    </button>
                    <div class="hint-text manual-entry-hint">
                        @(_manualInventoryType == ManualInventoryTypes.Pallet
                            ? "托盘由 RCS /AutoContainerEnter 创建；成功后立即以 RCS 库存重建 WCS 账本和地图。"
                            : "货物先整体写入 WCS 指定储位，再按储位顺序逐条同步 RCS。")
                        不创建带货托。
                    </div>

                    @if (_transitPositions.Count > 0)
                    {
                        <div class="manual-transit-list">
                            <b>在途托盘位置快照</b>
                            <span class="hint-text">@_transitLoadedAt</span>
                            @foreach (var transit in _transitPositions)
                            {
                                <div><code>@transit.PalletCode</code> · @TransitLocationText(transit)</div>
                            }
                        </div>
                    }
                    <div class="manual-ledger-sync">
                        <div class="manual-actions-title">库存账本同步</div>
                        <button class="btn btn-outline manual-sync-btn" @onclick="SyncLedger" disabled="@_syncLoading">
                            @(_syncLoading ? "⏳ 同步中..." : "🔄 RCS 同步至 WCS")
                        </button>
                        <span class="hint-text">以 RCS 当前库存重建 WCS 库存账本；存在在途自动化任务时会被拒绝。</span>
                    </div>
                    }
                </aside>
            </div>
    }

    @if (_manualResult != null)
        {
            <div style="overflow-x:auto;margin-top:12px;">
                <div class="hint-text" style="margin-bottom:6px;">@_manualResult.Message</div>
                <table class="data-table">
                    <thead><tr><th>储位</th><th>库存编码</th><th>类型</th><th>WCS</th><th>RCS</th><th>结果</th></tr></thead>
                    <tbody>
                    @foreach (var item in _manualResult.Items)
                    {
                        <tr>
                            <td><code>@item.StationMark</code></td>
                            <td><code>@item.Code</code></td>
                            <td>@(item.InventoryType == ManualInventoryTypes.Pallet ? "托盘" : "货物")</td>
                            <td>@(item.WcsWritten ? "✅ 已写入" : "—")</td>
                            <td>@(item.RcsSynced ? "✅ 已同步" : $"❌ HTTP {item.RcsStatusCode}")</td>
                            <td>@item.Message</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
    }
</section>

@* ════════════════════════════════════════════════
   操作反馈
   ════════════════════════════════════════════════ *@
@if (!string.IsNullOrEmpty(_feedback))
{
    <div class="section-card">
        <div class="response-panel @(_feedbackClass)">@_feedback</div>
    </div>
}

@code {
    private static readonly JsonSerializerOptions JsonOpts = new() { PropertyNameCaseInsensitive = true };

    private bool _syncLoading;

    // ── WCS 手工入库地图 ──
    // Canvas 地图只由 WCS 的 wcs_slots 快照派生，不读取浏览器 grcs_map_stations 缓存。
    private List<MapStationLite> _manualStations = [];
    private readonly Dictionary<string, WcsSlotRow> _manualSlots = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _manualSelectedMarks = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _sortingSelectedMarks = new(StringComparer.OrdinalIgnoreCase);
    private string _selectedSortingParentMark = "";
    private string _sortingParentMark = "";
    private bool _sortingEdit;
    private bool _sortingSaving;
    private List<int> _manualFloors = [];
    private int _manualFloor;
    private string _manualInventoryType = ManualInventoryTypes.Pallet;
    private string _manualPrefix = "SimContainer_";
    private int _manualCargoSizeId;
    private List<RcsCargoSizeDto> _manualCargoSizes = [];
    private bool _manualCargoSizesLoading;
    private DotNetObjectReference<Inventory>? _manualMapDotNetRef;
    private bool _manualMapPendingMount;
    private bool _manualMapPendingUpdate;
    private bool _manualMapMounted;
    private bool _manualLoading;
    private bool _manualSubmitting;
    private List<TransitPalletPositionDto> _transitPositions = [];
    private string _transitLoadedAt = "";
    private ManualInventoryEnterResult? _manualResult;


    /// <summary>从 RCS 同步库存账本到 WCS（清空重建；有在途自动化任务时后端拒绝）。</summary>
    private async Task SyncLedger()
    {
        _syncLoading = true;
        var (ok, json) = await WcsService.SyncInventoryAsync();
        string msg;
        if (ok)
        {
            try
            {
                var j = System.Text.Json.JsonDocument.Parse(json).RootElement;
                msg = $"同步完成（{j.GetProperty("syncedAt").GetString()}）\n" +
                    $"GRCS 库存：{j.GetProperty("grcsCount").GetInt32()} 条\n" +
                    $"储位更新：{j.GetProperty("slots").GetInt32()} 个储位（占用 {j.GetProperty("occupied").GetInt32()}）\n" +
                    $"  带货托 {j.GetProperty("loaded").GetInt32()}、空托 {j.GetProperty("emptyPallets").GetInt32()}、纯货物 {j.GetProperty("cargos").GetInt32()}";
            }
            catch { msg = json; }
        }
        else
        {
            msg = $"同步失败：{json}";
        }
        ShowFeedback(ok ? "✅" : "❌", msg);
        _syncLoading = false;
    }

    // ── 折叠状态（基类 PageStateBase 提供，键 grcs_inv_collapsed）──
    protected override string CollapsedStoreKey => "grcs_inv_collapsed";
    private async Task ToggleManualInventory()
    {
        var wasCollapsed = IsCollapsed("inv_manual");
        await Toggle("inv_manual");
        if (wasCollapsed && !IsCollapsed("inv_manual")) await RefreshManualSnapshot();
    }

    protected override Task OnInitializedAsync() => Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _manualMapDotNetRef = DotNetObjectReference.Create(this);
            await RefreshManualSnapshot();
            await LoadManualCargoSizes();
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (_manualMapPendingMount && _manualSlots.Count > 0)
        {
            _manualMapPendingMount = false;
            await MountManualMapAsync();
            return;
        }

        if (_manualMapPendingUpdate && _manualSlots.Count > 0)
        {
            _manualMapPendingUpdate = false;
            await UpdateManualMapAsync();
        }
    }

    public void Dispose() => _manualMapDotNetRef?.Dispose();

    private IEnumerable<string> ManualCodePreview
    {
        get
        {
            var timeHex = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds().ToString("X");
            return Enumerable.Range(0, Math.Min(_manualSelectedMarks.Count, 4))
                .Select(index => $"{_manualPrefix}{timeHex}{index:X4}");
        }
    }


    /// <summary>库存地图同时显示储位与接驳位；手工入库选点仍只接受储位。</summary>
    private static bool IsInventoryMapStation(MapStationLite station)
        => (station.StationType & (MapStationTypeBits.StorageLocation | MapStationTypeBits.TransferPoint
            | MapStationTypeBits.PickingStation | MapStationTypeBits.PeopleStation)) != 0;

    private static bool IsInventoryMapSlot(WcsSlotRow slot)
        => slot.SiteType is "Storage" or "Terminal" or "PeopleStation" or "Sorting";

    private static MapStationLite ToMapStation(WcsSlotRow slot) => new()
    {
        Mark = slot.Mark,
        StationType = slot.SiteType switch
        {
            "Storage" => MapStationTypeBits.StorageLocation,
            "Terminal" => MapStationTypeBits.TransferPoint,
            "PeopleStation" => MapStationTypeBits.PeopleStation,
            "Sorting" => MapStationTypeBits.PickingStation,
            _ => 0,
        },
        X = slot.X,
        Y = slot.Y,
        Floor = slot.Floor,
        StaEnable = true,
    };

    /// <summary>实际分拣台由地图类型决定；WCS 储位账本仅用于保存其库存和关联关系。</summary>
    private bool IsSortingChildStation(string mark)
        => _manualStations.Any(station => string.Equals(station.Mark, mark, StringComparison.OrdinalIgnoreCase)
            && (station.StationType & MapStationTypeBits.PickingStation) != 0);

    private bool IsPeopleSortingStation(string mark)
        => _manualStations.Any(station => string.Equals(station.Mark, mark, StringComparison.OrdinalIgnoreCase)
            && (station.StationType & MapStationTypeBits.PeopleStation) != 0);

    private List<string> CurrentSortingChildren => string.IsNullOrWhiteSpace(_sortingParentMark)
        ? []
        : _manualSlots.Values
            .Where(slot => string.Equals(slot.ParentStationCode, _sortingParentMark, StringComparison.OrdinalIgnoreCase))
            .Select(slot => slot.Mark).Order(StringComparer.OrdinalIgnoreCase).ToList();


    private async Task RefreshManualSnapshot()
    {
        _manualLoading = true;
        try
        {
            var slots = await WcsService.GetWcsSlotsAsync();
            var transitPositions = await WcsService.GetTransitPalletPositionsAsync();
            _manualSlots.Clear();
            foreach (var slot in slots ?? []) _manualSlots[slot.Mark] = slot;
            _manualStations = _manualSlots.Values
                .Where(IsInventoryMapSlot)
                .Select(ToMapStation)
                .ToList();
            _manualFloors = _manualSlots.Values.Where(IsInventoryMapSlot)
                .Select(slot => slot.Floor).Distinct().Order().ToList();
            if (!_manualFloors.Contains(_manualFloor)) _manualFloor = _manualFloors.FirstOrDefault();
            _transitPositions = transitPositions ?? [];
            _transitLoadedAt = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
            _manualSelectedMarks.RemoveWhere(mark => !IsManualMapSelectable(mark));
            _sortingSelectedMarks.RemoveWhere(mark => !IsSortingChildStation(mark));
            if (_manualMapMounted) _manualMapPendingUpdate = true;
            else _manualMapPendingMount = true;
        }
        finally { _manualLoading = false; }
    }

    /// <summary>复用自动化任务的 Canvas 地图，在库存页面内常驻显示；库存状态仅从 WCS 快照读取。</summary>
    private StationMapPickerConfig BuildManualMapConfig()
    {
        var stations = _manualStations.Where(IsInventoryMapStation).Select(station => new StationMapPickerStation
        {
            Mark = station.Mark,
            StationType = station.StationType,
            X = station.X,
            Y = station.Y,
            Floor = station.Floor,
            StaEnable = _sortingEdit
                ? IsSortingChildStation(station.Mark)
                : IsManualMapSelectable(station.Mark) || IsPeopleSortingStation(station.Mark),
            VisualKind = ManualVisualKind(station),
            Tooltip = ManualStationTooltip(station),
            BadgeText = SortingStationBadge(station),
            ParentMark = SortingMapParent(station),
        }).ToList();

        foreach (var transit in _transitPositions.Where(position => position.CurrentLocation != null))
        {
            if (transit.CurrentLocation == null) continue;
            stations.Add(new StationMapPickerStation
            {
                Mark = $"在途：{transit.PalletCode}",
                StationType = 0,
                X = transit.CurrentLocation.X,
                Y = transit.CurrentLocation.Y,
                Floor = ResolveTransitFloor(transit),
                StaEnable = false,
                VisualKind = "transit",
                Tooltip = TransitTooltip(transit),
            });
        }

        return new StationMapPickerConfig
        {
            Floors = _manualFloors,
            InitialFloor = _manualFloor,
            Stations = stations,
            Preselected = _sortingEdit
                ? _sortingSelectedMarks.ToList()
                : _manualSelectedMarks.Append(_selectedSortingParentMark)
                    .Where(mark => !string.IsNullOrWhiteSpace(mark)).ToList(),
            ScaleSymbolsWithZoom = true,
            CompactSelection = true,
            ShowSelectedLabels = false,
            ShowSortingLinks = _sortingEdit,
            RightClickPeopleStationSelection = true,
        };
    }

    private async Task MountManualMapAsync()
    {
        if (_manualMapDotNetRef == null || _manualStations.Count == 0) return;
        try
        {
            await Js.InvokeVoidAsync("grcsStationMapPickerMount", "manual-inventory-map",
                JsonSerializer.Serialize(BuildManualMapConfig()), _manualMapDotNetRef);
            _manualMapMounted = true;
        }
        catch (Exception ex) { ShowFeedback("❌", $"库存地图加载失败：{ex.Message}"); }
    }

    private async Task UpdateManualMapAsync()
    {
        if (!_manualMapMounted) return;
        try
        {
            await Js.InvokeVoidAsync("grcsStationMapPickerUpdate", "manual-inventory-map",
                JsonSerializer.Serialize(BuildManualMapConfig()));
        }
        catch (Exception ex) { ShowFeedback("❌", $"库存地图更新失败：{ex.Message}"); }
    }

    [JSInvokable]
    public Task OnManualMapSelectionChanged(List<string>? marks)
    {
        var next = new HashSet<string>(marks ?? [], StringComparer.OrdinalIgnoreCase);
        if (_sortingEdit)
        {
            if (_sortingSelectedMarks.SetEquals(next)) return Task.CompletedTask;
            _sortingSelectedMarks.Clear();
            foreach (var mark in next) _sortingSelectedMarks.Add(mark);
            return InvokeAsync(StateHasChanged);
        }

        var nextParent = next.Contains(_selectedSortingParentMark)
            ? _selectedSortingParentMark
            : next.Where(IsPeopleSortingStation).Order(StringComparer.OrdinalIgnoreCase).FirstOrDefault() ?? "";
        var nextManual = new HashSet<string>(next.Where(IsManualMapSelectable), StringComparer.OrdinalIgnoreCase);
        if (string.Equals(_selectedSortingParentMark, nextParent, StringComparison.OrdinalIgnoreCase)
            && _manualSelectedMarks.SetEquals(nextManual)) return Task.CompletedTask;

        _selectedSortingParentMark = nextParent;
        _manualSelectedMarks.Clear();
        foreach (var mark in nextManual) _manualSelectedMarks.Add(mark);
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnManualMapFloorChanged(int floor)
    {
        if (_manualFloor == floor) return Task.CompletedTask;
        _manualFloor = floor;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnManualMapSortingAssociationRequested(string mark)
    {
        var station = _manualStations.FirstOrDefault(item => string.Equals(item.Mark, mark, StringComparison.OrdinalIgnoreCase));
        if (station == null || (station.StationType & MapStationTypeBits.PeopleStation) == 0) return;
        _selectedSortingParentMark = station.Mark;
        _sortingParentMark = station.Mark;
        _sortingSelectedMarks.Clear();
        foreach (var child in CurrentSortingChildren) _sortingSelectedMarks.Add(child);
        _sortingEdit = true;
        await Js.InvokeVoidAsync("grcsStationMapPickerSetSortingMode", "manual-inventory-map",
            _sortingParentMark, _sortingSelectedMarks.Order(StringComparer.OrdinalIgnoreCase).ToList());
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnManualTypeChanged()
    {
        _manualPrefix = _manualInventoryType == ManualInventoryTypes.Pallet ? "SimContainer_" : "SimCargo_";
        if (_manualInventoryType == ManualInventoryTypes.Cargo) await LoadManualCargoSizes();
    }

    private async Task LoadManualCargoSizes()
    {
        _manualCargoSizesLoading = true;
        try
        {
            _manualCargoSizes = await WcsService.GetCargoSizesAsync();
            if (_manualCargoSizes.Any(size => size.Id == _manualCargoSizeId) == false)
                _manualCargoSizeId = _manualCargoSizes.FirstOrDefault()?.Id ?? 0;
        }
        finally { _manualCargoSizesLoading = false; }
    }

    private bool IsManualSelectable(string mark)
    {
        if (!_manualSlots.TryGetValue(mark, out var slot)) return false;
        return string.Equals(slot.SiteType, "Storage", StringComparison.OrdinalIgnoreCase)
            && string.IsNullOrEmpty(slot.PalletCode) && string.IsNullOrEmpty(slot.CargoCode)
            && string.IsNullOrEmpty(slot.TaskLockId);
    }

    /// <summary>库存地图允许选择空位或已有库存；任务锁定、在途库存不可编辑。</summary>
    private bool IsManualMapSelectable(string mark)
    {
        if (!_manualSlots.TryGetValue(mark, out var slot)) return false;
        return string.Equals(slot.SiteType, "Storage", StringComparison.OrdinalIgnoreCase)
            && string.IsNullOrEmpty(slot.TaskLockId)
            && !string.Equals(slot.PalletStatus, "transit", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(slot.CargoStatus, "transit", StringComparison.OrdinalIgnoreCase);
    }

    private async Task CompleteSortingEdit()
    {
        var selectedMarks = _sortingSelectedMarks.Order(StringComparer.OrdinalIgnoreCase).ToList();
        var parentStation = _manualStations.FirstOrDefault(station =>
            string.Equals(station.Mark, _sortingParentMark, StringComparison.OrdinalIgnoreCase));
        _sortingEdit = false;
        _sortingSelectedMarks.Clear();
        await Js.InvokeVoidAsync("grcsStationMapPickerCompleteSortingAssociation", "manual-inventory-map",
            _sortingParentMark, selectedMarks, ManualVisualKind(_sortingParentMark),
            parentStation == null ? null : SortingStationBadge(parentStation));
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveAndEndSortingAssociation()
    {
        if (await PersistSortingAssociationAsync()) await CompleteSortingEdit();
    }

    private async Task<bool> PersistSortingAssociationAsync()
    {
        if (string.IsNullOrWhiteSpace(_sortingParentMark)) return false;
        _sortingSaving = true;
        try
        {
            var (ok, json) = await WcsService.SaveSortingAssociationAsync(new SortingStationAssociationRequest
            {
                ParentStationCode = _sortingParentMark,
                ChildStationCodes = _sortingSelectedMarks.Order(StringComparer.OrdinalIgnoreCase).ToList(),
            });
            var result = JsonSerializer.Deserialize<SortingStationAssociationResult>(json, JsonOpts);
            ShowFeedback(ok ? "✅" : "❌", result?.Message ?? json);
            if (!ok) return false;
            foreach (var slot in _manualSlots.Values
                .Where(slot => string.Equals(slot.ParentStationCode, _sortingParentMark, StringComparison.OrdinalIgnoreCase)))
                slot.ParentStationCode = "";
            foreach (var mark in _sortingSelectedMarks)
                if (_manualSlots.TryGetValue(mark, out var slot)) slot.ParentStationCode = _sortingParentMark;
            return true;
        }
        finally { _sortingSaving = false; }
    }
    private IEnumerable<WcsSlotRow> SelectedManualSlots => _manualSelectedMarks
        .Select(mark => _manualSlots.TryGetValue(mark, out var slot) ? slot : null)
        .Where(slot => slot != null)
        .Select(slot => slot!);

    private static bool IsEmptySlot(WcsSlotRow slot)
        => string.IsNullOrEmpty(slot.PalletCode) && string.IsNullOrEmpty(slot.CargoCode);

    private static bool IsPalletOnlySlot(WcsSlotRow slot)
        => !string.IsNullOrEmpty(slot.PalletCode) && string.IsNullOrEmpty(slot.CargoCode);

    private bool AllSelectedSlots(Func<WcsSlotRow, bool> rule)
    {
        var slots = SelectedManualSlots.ToList();
        return slots.Count > 0 && slots.All(rule);
    }

    private bool CanStageAddPallet => AllSelectedSlots(IsEmptySlot);
    private bool CanStageAddCargo => AllSelectedSlots(slot => IsEmptySlot(slot) || IsPalletOnlySlot(slot));
    private bool CanStageDeletePallet => AllSelectedSlots(slot => !string.IsNullOrEmpty(slot.PalletCode));
    private bool CanStageDeleteCargo => AllSelectedSlots(slot => !string.IsNullOrEmpty(slot.CargoCode));

    /// <summary>库存增删动作暂为 UI 占位，不执行任何本地或 RCS 写入。</summary>
    private void NoopInventoryAction() { }

    private string ManualVisualKind(string mark)
    {
        if (!_manualSlots.TryGetValue(mark, out var slot)) return "empty";
        if (!string.IsNullOrEmpty(slot.TaskLockId)) return "locked";
        if (string.Equals(slot.PalletStatus, "transit", StringComparison.OrdinalIgnoreCase)
            || string.Equals(slot.CargoStatus, "transit", StringComparison.OrdinalIgnoreCase)) return "transit";
        if (!string.IsNullOrEmpty(slot.PalletCode) && !string.IsNullOrEmpty(slot.CargoCode)) return "loaded";
        if (!string.IsNullOrEmpty(slot.PalletCode)) return "pallet";
        if (!string.IsNullOrEmpty(slot.CargoCode)) return "cargo";
        return "empty";
    }

    private string ManualVisualKind(MapStationLite station)
    {
        if ((station.StationType & MapStationTypeBits.PeopleStation) == 0)
            return ManualVisualKind(station.Mark);
        var children = _manualSlots.Values.Where(slot => string.Equals(slot.ParentStationCode, station.Mark, StringComparison.OrdinalIgnoreCase)).ToList();
        if (children.Count == 0) return "empty";
        var occupied = children.Count(slot => !string.IsNullOrEmpty(slot.PalletCode) || !string.IsNullOrEmpty(slot.CargoCode));
        return occupied == children.Count ? "locked" : occupied > 0 ? "cargo" : "empty";
    }

    private string? SortingStationBadge(MapStationLite station)
    {
        if ((station.StationType & MapStationTypeBits.PeopleStation) == 0) return null;
        var children = _manualSlots.Values.Where(slot => string.Equals(slot.ParentStationCode, station.Mark, StringComparison.OrdinalIgnoreCase)).ToList();
        if (children.Count == 0) return null;
        var occupied = children.Count(slot => !string.IsNullOrEmpty(slot.PalletCode) || !string.IsNullOrEmpty(slot.CargoCode));
        return $"{occupied}/{children.Count}";
    }

    private string? SortingMapParent(MapStationLite station)
    {
        if (!_manualSlots.TryGetValue(station.Mark, out var slot)) return null;
        if (_sortingEdit && _sortingSelectedMarks.Contains(station.Mark)) return _sortingParentMark;
        return slot.ParentStationCode;
    }

    private string ManualStationTooltip(MapStationLite station)
    {
        if ((station.StationType & MapStationTypeBits.PeopleStation) != 0)
        {
            var children = _manualSlots.Values.Where(slot => string.Equals(slot.ParentStationCode, station.Mark, StringComparison.OrdinalIgnoreCase)).OrderBy(slot => slot.Mark).ToList();
            if (children.Count == 0) return $"人工分拣台 {station.Mark}：未关联实际分拣台；右键可关联";
            var occupied = children.Count(slot => !string.IsNullOrEmpty(slot.PalletCode) || !string.IsNullOrEmpty(slot.CargoCode));
            return $"人工分拣台 {station.Mark}：占用 {occupied}/{children.Count}；右键可修改关联";
        }
        if (!_manualSlots.TryGetValue(station.Mark, out var slot)) return $"{station.Mark}：未同步到 WCS 储位表";
        var pallet = string.IsNullOrWhiteSpace(slot.PalletCode) ? "无托盘" : $"托盘 {slot.PalletCode}（{slot.PalletStatus}）";
        var cargo = string.IsNullOrWhiteSpace(slot.CargoCode) ? "无货物" : $"货物 {slot.CargoCode}（{slot.CargoStatus}）";
        var locked = string.IsNullOrWhiteSpace(slot.TaskLockId) ? "" : $"；任务锁 {slot.TaskLockId}";
        return $"{station.Mark}：{pallet}；{cargo}{locked}";
    }

    private string TransitLocationText(TransitPalletPositionDto transit)
    {
        if (transit.CurrentLocation != null)
            return $"坐标 {transit.CurrentLocation.X:0.#}, {transit.CurrentLocation.Y:0.#} · 车辆 {transit.RobotId}";
        if (!string.IsNullOrWhiteSpace(transit.CurrentStationCode)) return $"站点 {transit.CurrentStationCode} · 车辆 {transit.RobotId}";
        return string.IsNullOrWhiteSpace(transit.RobotId) ? "未获取位置" : $"车辆 {transit.RobotId}";
    }

    private string TransitTooltip(TransitPalletPositionDto transit)
        => $"在途托盘 {transit.PalletCode}；{TransitLocationText(transit)}";

    /// <summary>
    /// RCS 坐标 Z 可能从 0 起算，地图楼层通常从 1 起算。优先采用 RCS 当前站点的地图楼层；
    /// 没有站点时依次匹配 Z、Z+1，再回退到来源储位或当前地图楼层。
    /// </summary>
    private int ResolveTransitFloor(TransitPalletPositionDto transit)
    {
        var currentStationFloor = FindMapFloor(transit.CurrentStationCode);
        if (currentStationFloor.HasValue) return currentStationFloor.Value;

        if (transit.CurrentLocation != null)
        {
            var rcsFloor = (int)Math.Round(transit.CurrentLocation.Z);
            if (_manualFloors.Contains(rcsFloor)) return rcsFloor;
            if (_manualFloors.Contains(rcsFloor + 1)) return rcsFloor + 1;
        }

        var sourceFloor = FindMapFloor(transit.SourceMark);
        if (sourceFloor.HasValue) return sourceFloor.Value;
        return _manualFloors.Count == 1 ? _manualFloors[0] : _manualFloor;
    }

    private int? FindMapFloor(string stationCode)
    {
        if (string.IsNullOrWhiteSpace(stationCode)) return null;
        var mark = stationCode.Trim();
        if (mark.EndsWith("_0", StringComparison.OrdinalIgnoreCase)
            || mark.EndsWith("_1", StringComparison.OrdinalIgnoreCase))
        {
            mark = mark[..^2];
        }
        return _manualStations.FirstOrDefault(station =>
            string.Equals(station.Mark, mark, StringComparison.OrdinalIgnoreCase))?.Floor;
    }

    private async Task ManualEnter()
    {
        _manualSubmitting = true;
        try
        {
            if (_manualInventoryType == ManualInventoryTypes.Pallet)
            {
                var (created, statusCode, createJson) = await WcsService.AutoContainerEnterAsync(
                    "", "", _manualPrefix, -1, _manualFloor, type: 2);
                if (!created)
                {
                    _manualResult = new ManualInventoryEnterResult
                    {
                        Message = $"RCS 托盘生成失败：{createJson}",
                        Items = [new ManualInventoryEnterItemResult
                        {
                            StationMark = $"{_manualFloor} 层（RCS 自动分配）",
                            Code = _manualPrefix,
                            InventoryType = ManualInventoryTypes.Pallet,
                            RcsStatusCode = statusCode,
                            Message = createJson,
                        }]
                    };
                    ShowFeedback("❌", _manualResult.Message);
                    return;
                }

                var (synced, syncJson) = await WcsService.SyncInventoryAsync();
                _manualResult = new ManualInventoryEnterResult
                {
                    WcsWritten = synced,
                    Message = synced
                        ? "RCS 已生成当前楼层全部可用托盘，WCS 已按 RCS 实际落位同步完成"
                        : $"RCS 已生成托盘，但 WCS 库存同步失败：{syncJson}",
                    Items = [new ManualInventoryEnterItemResult
                    {
                        StationMark = $"{_manualFloor} 层（RCS 自动分配）",
                        Code = _manualPrefix,
                        InventoryType = ManualInventoryTypes.Pallet,
                        WcsWritten = synced,
                        RcsSynced = true,
                        RcsStatusCode = statusCode,
                        Message = synced ? "RCS 已生成，WCS 已同步实际储位" : syncJson,
                    }]
                };
                if (synced) _manualSelectedMarks.Clear();
                ShowFeedback(synced ? "✅" : "❌", _manualResult.Message);
                await RefreshManualSnapshot();
                return;
            }

            var request = new ManualInventoryEnterRequest
            {
                StationMarks = _manualSelectedMarks.Order(StringComparer.OrdinalIgnoreCase).ToList(),
                InventoryType = _manualInventoryType,
                Prefix = _manualPrefix,
                CargoSizeId = _manualCargoSizeId,
            };
            var (ok, _, json) = await WcsService.ManualInventoryEnterAsync(request);
            _manualResult = JsonSerializer.Deserialize<ManualInventoryEnterResult>(json, JsonOpts)
                ?? new ManualInventoryEnterResult { Message = json };
            if (ok) _manualSelectedMarks.Clear();
            ShowFeedback(ok ? "✅" : "❌", _manualResult.Message);
            await RefreshManualSnapshot();
        }
        catch (Exception ex) { ShowFeedback("❌", ex.Message); }
        finally { _manualSubmitting = false; }
    }

