@page "/tools/nested-cargo"
@using System.Net.Http.Json
@using System.Text.Json
@using Dashboard.Modules.WcsSimulator.Services
@inject HttpClient Http
@inject LocalStoreService LocalStore
@inject IJSRuntime Js

<PageTitle>嵌套货物 - 常用工具</PageTitle>

<div class="nested-cargo-page">
    <div class="header">
        <div><div class="eyebrow">COMMON TOOLS / CARGO</div><h1>增加嵌套货物</h1><p>在真实 rcs.cargo 表中，将货物绑定到空托盘架。</p></div>
        <span class="badge">独立模块</span>
    </div>
    <section class="card">
        <div class="fields">
            <label>场景 <input @bind="SceneName" maxlength="100" placeholder="例如 AMR" /></label>
            <label>托盘架号 <input @bind="RackCode" maxlength="100" placeholder="例如 SimContainer_32" /></label>
            <label>货物号 <input @bind="CargoCode" maxlength="100" placeholder="例如 PLWZ0000010" /></label>
        </div>
        <p class="hint">服务端会在事务中锁定托盘架，检查托盘架为空和货物号未占用，然后复制托盘架属性插入子货物。</p>
        <div class="actions"><span class="notice @(NoticeSuccess ? "success" : "error")">@Notice</span><button class="primary" disabled="@Busy" @onclick="SubmitAsync">@(Busy ? "执行中…" : "执行嵌套")</button></div>
    </section>
</div>

<style>
    .nested-cargo-page{max-width:1050px;margin:0 auto;padding:30px 34px;color:#e8f1fc}.header{display:flex;justify-content:space-between;gap:20px;margin-bottom:24px}.eyebrow{font-size:11px;letter-spacing:.16em;font-weight:800;color:#51c8e8;margin-bottom:9px}.header h1{font-size:27px;margin:0}.header p{color:#8da3bd;font-size:13px;margin:8px 0}.badge{height:max-content;border:1px solid #23677a;color:#68d8ed;background:#0c2938;border-radius:20px;padding:7px 12px;font-size:11px;white-space:nowrap}.card{background:linear-gradient(145deg,#111e31,#0d1727);border:1px solid #293e59;border-radius:13px;padding:24px;box-shadow:0 12px 30px #02071140}.fields{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.fields label{display:flex;flex-direction:column;gap:7px;color:#9eb3ca;font-size:12px}.fields input{background:#091322;border:1px solid #30445d;border-radius:7px;padding:11px;color:#eaf4ff;font:inherit;outline:none}.fields input:focus{border-color:#26b9d6}.hint{color:#8197b2;font-size:12px;border-top:1px solid #24354b;padding-top:15px;margin:20px 0 15px}.actions{display:flex;justify-content:flex-end;align-items:center;gap:14px}.notice{margin-right:auto;font-size:12px}.notice.success{color:#7de5b4}.notice.error{color:#ff9ca9}.primary{border:1px solid #26b9d6;background:#0d9bb7;color:#fff;border-radius:7px;padding:10px 18px;font-weight:700;cursor:pointer}.primary:disabled{opacity:.45;cursor:not-allowed}@@media(max-width:760px){.nested-cargo-page{padding:22px 16px}.header{align-items:flex-start;flex-direction:column}.fields{grid-template-columns:1fr}.actions{align-items:flex-start;flex-direction:column}.notice{margin-right:0}}
</style>

@code {
    private string SceneName = "AMR";
    private string RackCode = "";
    private string CargoCode = "";
    private string Notice = "请输入三个参数后执行。";
    private bool NoticeSuccess;
    private bool Busy;

    private async Task SubmitAsync()
    {
        Busy = true;
        Notice = "";
        try
        {
            await LocalStore.PreloadAsync(Js);
            var response = await Http.PostAsJsonAsync(ApiUrl("/api/common-tools/nested-cargo"), new { sceneName = SceneName, rackCode = RackCode, cargoCode = CargoCode });
            using var json = JsonDocument.Parse(await response.Content.ReadAsStringAsync());
            var root = json.RootElement;
            Notice = root.TryGetProperty("message", out var message) ? message.GetString() ?? "" : response.StatusCode.ToString();
            NoticeSuccess = response.IsSuccessStatusCode && root.TryGetProperty("success", out var success) && success.GetBoolean();
        }
        catch (Exception ex) { Notice = ex.Message; NoticeSuccess = false; }
        finally { Busy = false; }
    }

    private string ApiUrl(string path)
    {
        var configuredUrl = LocalStore["grcs_wcs_url"];
        var baseUrl = string.IsNullOrWhiteSpace(configuredUrl) || configuredUrl == "null" ? "http://localhost:8230" : configuredUrl.TrimEnd('/');
        return baseUrl + path;
    }
}
