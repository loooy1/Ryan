ius:6px;background:#13243a;color:#c5d7ee;padding:6px;font-size:10px;cursor:pointer}.station-stock-row .stock-delete{color:#fb7185}.station-stock-add{margin-top:12px}.station-stock-add-title{color:#89a0bf;font-size:11px;margin-bottom:6px}.station-stock-add-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px}.station-stock-add-grid button{background:#087f9c;color:white;border-color:#0e9cbb}.station-stock-message{font-size:11px;color:#6ee7b7;margin-top:7px}.station-stock-message.error{color:#fda4af}
