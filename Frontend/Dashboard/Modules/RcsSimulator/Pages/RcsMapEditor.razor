-item:hover{color:#fca5a5;background:#7f1d1d44}.rcs-builder-page .map-context-menu .menu-arrow{display:flex;align-items:center;justify-content:center;flex:0 0 12px;margin-left:auto;color:#67e8f9;font-size:1rem;line-height:18px}.builder-properties input,.builder-properties select,.matrix-dialog input,.matrix-dialog select{display:block;width:100%;box-sizing:border-box;margin-top:5px;border:1px solid #334155;border-radius:7px;background:#0b1425;color:#e2e8f0;padding:8px}.form-group{margin:10px 0}.form-group label{display:block;color:#94a3b8;font-size:.72rem}.form-grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px}.check{display:flex;gap:7px;align-items:center;color:#94a3b8;font-size:.74rem}.check input{width:auto}.property-empty{padding:12px;border:1px dashed #334155;border-radius:8px;color:#64748b;font-size:.76rem;line-height:1.6}.feedback{padding:9px 14px;font-size:.76rem}.feedback.success{color:#4ade80}.feedback.error{color:#f87171}.matrix-overlay{position:fixed;inset:0;z-index:900;display:flex;align-items:center;justify-content:center;padding:20px;background:#020617bb;backdrop-filter:blur(4px)}.matrix-dialog{width:min(560px,96vw);border:1px solid #334155;border-top:2px solid #22d3ee;border-radius:14px;background:linear-gradient(155deg,#111d32,#0b1425);box-shadow:0 24px 70px #0000008c;padding:20px}.dialog-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding-bottom:14px;border-bottom:1px solid #263650;margin-bottom:16px}.dialog-title{color:#f8fafc;font-size:1rem;font-weight:700}.dialog-sub{color:#64748b;font-size:.7rem;margin-top:4px}.dialog-close{border:1px solid #334155;border-radius:8px;background:transparent;color:#94a3b8;width:28px;height:28px;cursor:pointer}.matrix-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.matrix-grid .full{grid-column:1/-1}.matrix-preview{margin-top:14px;padding:9px 11px;border-radius:9px;background:#0b1425;color:#94a3b8;font-size:.72rem}.dialog-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:20px;padding-top:14px;border-top:1px solid #263650}@@media(max-width:1000px){.builder-layout{grid-template-columns:100px minmax(0,1fr)}.builder-properties{grid-column:1/-1}}@@media(max-width:620px){.builder-layout{grid-template-columns:1fr}.builder-tools{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.caption,.divider,.count-box{margin:0}.map-tool{width:auto;margin:0}.canvas-host{height:500px;min-height:0}}
</style>

<style>
.import-map-button{position:relative;overflow:hidden;display:inline-flex;align-items:center}
.import-map-button input[type=file]{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer}
