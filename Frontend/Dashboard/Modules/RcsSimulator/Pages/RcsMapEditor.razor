@page "/rcs/map-editor"
@using Contracts.Rcs.Map
@using Dashboard.Modules.RcsSimulator.Components
@using Microsoft.AspNetCore.Components.Web
@using System.Globalization
@using System.Text.Json
@using Microsoft.JSInterop
@inject RcsApiClient Api
@inject RcsMapCacheService MapCache
@inject IJSRuntime Js

<PageTitle>RCS 创建地图</PageTitle>

<div class="rcs-builder-page">
    <div class="builder-header">
        <div><div class="builder-kicker">RCS / MAP BUILDER</div><h1>创建地图</h1><p>按 WCS 地图创建方式编辑 RCS 点位，并用连线定义算法可通行路径。</p></div>
        <div class="builder-actions">
            <label class="btn ghost import-map-button @(_importing ? "disabled" : "")">
                @(_importing ? "⏳ 正在导入…" : "📥 读取 GRCS 地图")
                <InputFile @key="_mapFileInputKey" OnChange="ImportGrcsMapAsync" accept=".json,application/json" disabled="@_importing" />
            </label>
            <button class="btn ghost" @onclick="() => ReloadAsync(forceReload: true)" disabled="@(_saving || _importing)">↻ 重新读取</button>
            <button class="btn primary" @onclick="SaveAsync" disabled="@(_saving || _importing)">@(_saving ? "保存中…" : "保存地图")</button>
        </div>
    </div>

    <div class="builder-layout">
        <aside class="builder-tools">
            <div class="caption">工具</div>
            <button class="map-tool @ToolClass(EditorTool.Select)" @onclick="() => SetTool(EditorTool.Select)">↖ <span>选择</span></button>
            <button class="map-tool point-group-toggle @(_pointToolsExpanded ? "active" : "")" @onclick="TogglePointTools"><span class="tool-leading-icon">＋</span><span><b>站点</b></span><em>@(_pointToolsExpanded ? "⌃" : "⌄")</em></button>
            @if (_pointToolsExpanded)
            {
                <div class="point-tools-panel">
                    <button class="point-tool-card @ToolClass(EditorTool.Storage)" @onclick="() => SetTool(EditorTool.Storage)"><span class="point-card-icon storage">▦</span><span><b>储位</b></span></button>
                    <button class="point-tool-card @ToolClass(EditorTool.Transfer)" @onclick="() => SetTool(EditorTool.Transfer)"><span class="point-card-icon transfer">⇄</span><span><b>接驳位</b></span></button>
                    <button class="point-tool-card @ToolClass(EditorTool.People)" @onclick="() => SetTool(EditorTool.People)"><span class="point-card-icon people">♙</span><span><b>人工分拣台</b></span></button>
                    <button class="point-tool-card @ToolClass(EditorTool.Sorting)" @onclick="() => SetTool(EditorTool.Sorting)"><span class="point-card-icon sorting">⌘</span><span><b>分拣台</b></span></button>
                    <button class="point-tool-card @ToolClass(EditorTool.Waypoint)" @onclick="() => SetTool(EditorTool.Waypoint)"><span class="point-card-icon waypoint">•</span><span><b>路径点</b></span></button>
                    <button class="point-tool-card @ToolClass(EditorTool.Elevator)" @onclick="() => SetTool(EditorTool.Elevator)"><span class="point-card-icon elevator">↕</span><span><b>跨层点</b></span></button>
                    <button class="point-tool-card @ToolClass(EditorTool.Charging)" @onclick="() => SetTool(EditorTool.Charging)"><span class="point-card-icon charging">⚡</span><span><b>充电点</b></span></button>
                </div>
            }
            <button class="map-tool point-group-toggle @(_pathToolsExpanded ? "active" : "")" @onclick="TogglePathTools"><span class="tool-leading-icon">⌁</span><span><b>路径</b></span><em>@(_pathToolsExpanded ? "⌃" : "⌄")</em></button>
            @if (_pathToolsExpanded)
            {
                <div class="point-tools-panel path-tools-panel">
                    <button class="point-tool-card @ToolClass(EditorTool.Line)" @onclick="() => SetTool(EditorTool.Line)"><span class="point-card-icon waypoint">╱</span><span><b>单点连接</b></span></button>
                    <button class="point-tool-card @ToolClass(EditorTool.RangeLine)" @onclick="() => SetTool(EditorTool.RangeLine)"><span class="point-card-icon waypoint">▧</span><span><b>范围连接</b></span></button>
                </div>
            }
            <button class="map-tool @ToolClass(EditorTool.Matrix)" @onclick="OpenMatrix">▦ <span>点阵</span></button>
            <button class="map-tool align-tool @ToolClass(EditorTool.AlignX)" @onclick="() => SetTool(EditorTool.AlignX)">↔ <span>X 对齐</span></button>
            <button class="map-tool align-tool @ToolClass(EditorTool.AlignY)" @onclick="() => SetTool(EditorTool.AlignY)">↕ <span>Y 对齐</span></button>
            @if (_tool is EditorTool.AlignX or EditorTool.AlignY)
            {
                <div class="align-hint">① 点击基准点<br />② 点击要对齐的点<br />基准：<b>@(_alignmentAnchor?.PointCode ?? "未选择")</b></div>
            }
            @if (_tool == EditorTool.Line)
            {
                <div class="align-hint line-hint">先点击起点，再点击终点创建线。可在右侧修改方向和距离。</div>
            }
            @if (_tool == EditorTool.RangeLine)
            {
                <div class="align-hint line-hint">拖拽框选范围内站点，然后点击“确认连接”。</div>
                @if (_rangeSelection.Count > 1)
                {
                    <button class="btn primary small range-confirm" @onclick="ConfirmRangeConnection">确认连接（@_rangeSelection.Count 个站点）</button>
                }
            }
            <div class="divider"></div>
            <button class="btn outline small" @onclick="ClearMap" disabled="@(_map.Points.Count == 0 && _map.Lines.Count == 0)">清空画布</button>
            <div class="count-box">地图元素<b>@_map.Points.Count</b><small>点 · @_map.Lines.Count 条线</small></div>
        </aside>

        <section class="builder-stage">
            <div class="stage-bar"><strong>@(_map.Name.Length == 0 ? "空白地图画布" : _map.Name)</strong><span class="stage-hint">@ToolHint</span><div class="zoom"><button title="缩小" @onclick="ZoomOut">−</button><button title="重置视图" @onclick="ResetView">⌂</button><button title="放大" @onclick="ZoomIn">＋</button></div></div>
            <div id="rcs-map-editor-host" class="canvas-host">
                <canvas id="rcs-map-editor-canvas" class="map-create-canvas" aria-label="RCS 地图编辑画布"></canvas>
                <svg id="rcs-map-editor-overlay" class="map-create-overlay" aria-hidden="true"></svg>
            </div>
            @if (!string.IsNullOrWhiteSpace(_message)) { <div class="feedback @(_error ? "error" : "success")">@_message</div> }
        </section>

        @if (_contextMenuOpen)
        {
            <div class="map-context-menu-wrap" style="left:@(_contextMenuX + "px");top:@(_contextMenuY + "px");" @onclick:stopPropagation="true">
                <div class="map-context-menu">
                    <div class="context-title">站点 @_selectedPointCodes.Count · 路径 @_selectedLineCodes.Count</div>
                    <button @onclick="OpenStationFilterMenu">选中站点 <span class="menu-arrow">›</span></button>
                    <button @onclick="KeepSelectedLines">选中路径</button>
                    <div class="context-divider"></div>
                    <button class="danger-item" @onclick="DeleteSelectedBatch">删除所选</button>
                    <button @onclick="CloseContextMenu">取消</button>
                </div>
                @if (_stationFilterMenuOpen)
                {
                    <div class="map-context-menu map-context-submenu">
                        <div class="context-title">站点类型</div>
                        <button @onclick='() => FilterSelectedPoints("STORAGE")'>选中储位</button>
                        <button @onclick='() => FilterSelectedPoints("TRANSFER")'>选中接驳点</button>
                        <button @onclick='() => FilterSelectedPoints("PEOPLE")'>选中人工分拣台</button>
                        <button @onclick='() => FilterSelectedPoints("SORTING")'>选中分拣台</button>
                        <button @onclick='() => FilterSelectedPoints("WAYPOINT")'>选中路径点</button>
                        <button @onclick='() => FilterSelectedPoints("ELEVATOR")'>选中跨层点</button>
                        <button @onclick='() => FilterSelectedPoints("CHARGING")'>选中充电点</button>
                        <div class="context-divider"></div>
                        <button class="danger-item" @onclick="DeleteSelectedBatch">删除所选</button>
                        <button @onclick="CloseContextMenu">取消</button>
                    </div>
                }
            </div>
        }

        <aside class="builder-properties">
            <div class="caption">地图信息</div>
            <div class="form-group"><label>地图编码</label><input @bind="_map.MapCode" /></div>
            <div class="form-group"><label>地图名称</label><input @bind="_map.Name" /></div>
            <div class="form-group"><label>场景名称</label><input @bind="_map.SceneName" /></div>
            <div class="form-grid2"><div class="form-group"><label>版本</label><input type="number" @bind="_map.Version" /></div><div class="form-group"><label>状态</label><select @bind="_map.Status"><option value="DRAFT">草稿</option><option value="PUBLISHED">已发布</option></select></div></div>
            <label class="check"><input type="checkbox" @bind="_map.IsActive" /> 设为当前地图</label>
            @if (_selectedPointCodes.Count + _selectedLineCodes.Count <= 1)
            {
                <div class="divider"></div>
                <div class="caption">当前对象</div>
                <RcsElementProperties Point="_selectedPoint" Line="_selectedLine" PointCodeChanged="RenameSelectedPoint" Changed="MarkDirty" />
                @if (_selectedPoint is not null || _selectedLine is not null)
                {
                    <button class="btn danger small" @onclick="DeleteSelected">删除@(_selectedPoint is not null ? "点" : "线")</button>
                }
            }
        </aside>
    </div>
</div>

@if (_matrixDialogOpen)
{
    <div class="matrix-overlay" @onclick="CloseMatrix">
        <div class="matrix-dialog" @onclick:stopPropagation="true">
            <div class="dialog-head"><div><div class="dialog-title">添加点阵</div><div class="dialog-sub">批量生成点位，生成后仍可逐个编辑并添加线路</div></div><button class="dialog-close" @onclick="CloseMatrix">✕</button></div>
            <div class="matrix-grid">
                <div class="form-group full"><label>点位类型</label><select @bind="_matrixType"><option value="STORAGE">储位</option><option value="TRANSFER">接驳位</option><option value="PEOPLE">人工分拣台</option><option value="SORTING">分拣台</option><option value="WAYPOINT">路径点</option><option value="ELEVATOR">跨层点</option><option value="CHARGING">充电点</option></select></div>
                <div class="form-group full"><label>起始坐标</label><div class="form-grid2"><input type="number" @bind="_matrixOriginX" placeholder="X" /><input type="number" @bind="_matrixOriginY" placeholder="Y" /></div></div>
                <div class="form-group"><label>行数</label><input type="number" min="1" max="200" @bind="_matrixRows" /></div><div class="form-group"><label>列数</label><input type="number" min="1" max="200" @bind="_matrixColumns" /></div>
                <div class="form-group"><label>水平间距</label><input type="number" min="0" @bind="_matrixHorizontalSpacing" /></div><div class="form-group"><label>垂直间距</label><input type="number" min="0" @bind="_matrixVerticalSpacing" /></div>
            </div>
            <div class="matrix-preview">将生成 <b>@(_matrixRows * _matrixColumns)</b> 个点</div>
            <div class="dialog-actions"><button class="btn outline" @onclick="CloseMatrix">取消</button><button class="btn primary" @onclick="CreateMatrix">确定生成</button></div>
        </div>
    </div>
}

