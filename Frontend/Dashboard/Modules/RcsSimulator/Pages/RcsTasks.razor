@page "/rcs/tasks/upstream"
@page "/rcs/tasks/internal"
@using System.Text.Json
@using Contracts.Rcs.Tasks
@using Contracts.Rcs.Vehicle
@inject RcsApiClient Api
@inject RcsRealtimeHubClient Realtime
@inject IJSRuntime Js
@implements IAsyncDisposable

<PageTitle>RCS 任务管理</PageTitle>

<div class="rcs-tasks-page">
    <header class="tasks-header">
        <div><div class="tasks-kicker">RCS / TASK FLOW</div><h1>任务管理</h1>
            <p>统一查看上游任务信息、车辆分配和 RCS 执行阶段。</p></div>
        <div class="tasks-header-actions">
            <button class="tasks-refresh" @onclick="RefreshAsync" disabled="@_loading">↻ 刷新</button>
            <button class="tasks-clear" @onclick="() => _confirmClear = true" disabled="@(_loading || _clearing || _pageInfo.AllTaskCount == 0)">清空全部任务</button>
        </div>
    </header>

    <section class="tasks-metrics">
        <div><span>任务组</span><strong>@_pageInfo.GroupCount</strong><small>全部记录</small></div>
        <div><span>RCS 子任务</span><strong>@_pageInfo.TotalCount</strong><small>当前筛选结果</small></div>
        <div><span>待分配</span><strong>@_pageInfo.WaitingCount</strong><small>等待自动车辆</small></div>
        <div><span>执行中</span><strong>@_pageInfo.ExecutingCount</strong><small>含暂停和取消中</small></div>
    </section>

    <div class="tasks-toolbar">
        <label><span>搜索</span><input value="@_search" @oninput="SearchChangedAsync" placeholder="任务组、任务编号、车辆或容器" /></label>
        <label><span>任务状态</span><select value="@_statusFilter" @onchange="StatusChangedAsync"><option value="">全部状态</option><option value="WAITING">待分配</option><option value="RUNNING">执行中</option><option value="PAUSED">已暂停</option><option value="COMPLETED">已完成</option><option value="FAILED">失败</option><option value="CANCELLED">已取消</option><option value="INTERRUPTED">已中断</option></select></label>
        <small>@(Realtime.IsConnected ? "● 实时更新已连接" : "○ 等待实时连接") · 共 @_pageInfo.TotalCount 条匹配</small>
    </div>

    @if (_error != "") { <div class="tasks-error" role="alert">@_error</div> }
    @if (_notice != "") { <div class="tasks-notice" role="status">@_notice</div> }
    @if (_loading && _tasks.Count == 0) { <div class="tasks-empty">正在读取 RCS 任务…</div> }
    else if (_tasks.Count == 0) { <div class="tasks-empty">@(_pageInfo.TotalCount == 0 ? "当前没有已接收的 RCS 任务。" : "没有当前页的任务记录。")</div> }
    else
    {
        <div class="unified-task-list">
            @foreach (var task in _tasks.Values.OrderByDescending(x => x.CreatedAt, StringComparer.Ordinal))
            {
                var vehicle = _vehicles.GetValueOrDefault(task.VehicleId);
                var start = task.StationCode.FirstOrDefault() ?? "—";
                var end = task.StationCode.LastOrDefault() ?? "—";
                <details class="unified-task-card" @key="task.TaskId">
                    <summary class="unified-task-summary">
                        <div class="unified-task-id"><small>@(task.Source == RcsTaskSource.Manual ? "手动任务" : "上游原始任务") · @task.TaskType</small><strong title="@task.TaskId">@task.TaskId</strong></div>
                        <div class="summary-route"><small>起点 → 终点</small><strong title="@start → @end">@start <span>→</span> @end</strong></div>
                        <div class="summary-fact"><small>货物 / 托盘</small><strong title="@task.ContainerCode">@(task.ContainerCode == "" ? "—" : task.ContainerCode)</strong></div>
                        <div class="summary-fact"><small>执行车辆</small><strong>@(task.VehicleId == "" ? "待分配" : task.VehicleId)</strong></div>
                        <span class="task-status @StatusClass(task.Status)">@StatusText(task.Status)</span>
                        <span class="task-expand-mark" aria-hidden="true">⌄</span>
                    </summary>
                    <div class="unified-task-content">
                    <div class="unified-stage-section"><div class="section-caption">任务进度 <span>7 个阶段 · 4 个车辆确认阶段</span></div>
                        <ol class="task-timeline">
                            @foreach (var step in Timeline(task, vehicle))
                            {
                                <li class="@step.State">
                                    <span class="timeline-node">@(step.State == "done" ? "✓" : step.State == "failed" ? "!" : step.Number.ToString())</span>
                                    <span class="timeline-copy">
                                        <strong>@step.Title</strong>
                                        <small>@step.Detail</small>
                                        @if (step.Confirmation != "")
                                        {
                                            <small class="vehicle-confirmation @step.ConfirmationClass">@step.Confirmation</small>
                                        }
                                    </span>
                                </li>
                            }
                        </ol>
                    </div>
                    @if (task.Message != "")
                    {
                        <div class="internal-message">@task.Message</div>
                    }
                    <section class="original-payload">
                        <div class="section-caption">@(task.Source == RcsTaskSource.Manual ? "手动任务参数" : "上游系统原始报文")</div>
                        <pre>@TaskParameterJson(task)</pre>
                    </section>
                    </div>
                </details>
            }
        </div>
    }

    <footer class="tasks-pagination" aria-label="任务列表分页">
        <label class="page-size-control"><span>每页</span><select value="@_pageSize" @onchange="PageSizeChangedAsync" disabled="@_loading">
            @for (var size = 10; size <= 100; size += 10) { <option value="@size">@size 条/页</option> }
        </select></label>
        <div class="page-controls">
            <button @onclick="PreviousPageAsync" disabled="@(_loading || _page <= 1)" aria-label="上一页">‹</button>
            <span class="current-page">@_page</span>
            <button @onclick="NextPageAsync" disabled="@(_loading || _page >= _pageInfo.TotalPages)" aria-label="下一页">›</button>
        </div>
        <label class="page-jump">前往<input type="number" min="1" max="@_pageInfo.TotalPages" @bind="_jumpPage" @bind:event="oninput" disabled="@_loading" /><span>页</span>
            <button @onclick="JumpPageAsync" disabled="@_loading">确定</button>
        </label>
        <small>共 @_pageInfo.TotalPages 页 · @_pageInfo.TotalCount 条</small>
    </footer>

    @if (_confirmClear)
    {
        <div class="task-clear-backdrop" @onclick="CloseClearDialog">
            <section class="task-clear-dialog" role="dialog" aria-modal="true" aria-labelledby="clear-tasks-title" @onclick:stopPropagation>
                <div class="clear-dialog-icon">!</div>
                <h2 id="clear-tasks-title">清空所有 RCS 任务？</h2>
                <p>此操作会删除数据库中的全部任务记录，覆盖所有状态和分页数据。若有车辆正在执行，RCS 会先请求停车并等待确认；若停车失败或超时，则保留任务记录。</p>
                <div class="clear-dialog-count">全部任务 <strong>@_pageInfo.AllTaskCount</strong> 条 · 任务组 <strong>@_pageInfo.GroupCount</strong></div>
                <div class="clear-dialog-actions"><button @onclick="CloseClearDialog" disabled="@_clearing">取消</button>
                    <button class="confirm-clear" @onclick="ClearAllTasksAsync" disabled="@_clearing">@(_clearing ? "正在停车并清理…" : "确认清空")</button>
                </div>
            </section>
        </div>
    }
</div>
