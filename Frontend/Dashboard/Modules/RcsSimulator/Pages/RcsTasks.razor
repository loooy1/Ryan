@page "/rcs/tasks/upstream"
@page "/rcs/tasks/internal"
@using System.Text.Json
@using Contracts.Rcs.Tasks
@using Contracts.Rcs.Vehicle
@inject RcsApiClient Api
@inject RcsRealtimeHubClient Realtime
@inject IJSRuntime Js
@implements IAsyncDisposable

<PageTitle>RCS 任务管理</PageTitle>

<div class="rcs-tasks-page">
    <header class="tasks-header">
        <div><div class="tasks-kicker">RCS / TASK FLOW</div><h1>任务管理</h1>
            <p>统一查看上游任务信息、车辆分配和 RCS 执行阶段。</p></div>
        <div class="tasks-header-actions"><button class="tasks-refresh" @onclick="RefreshAsync" disabled="@_loading">↻ 刷新</button></div>
    </header>

    <section class="tasks-metrics">
        <div><span>任务组</span><strong>@UpstreamGroupCount</strong></div>
        <div><span>RCS 子任务</span><strong>@UpstreamTasksCount</strong></div>
        <div><span>待分配</span><strong>@_tasks.Values.Count(x => x.Status == RcsTaskStatus.Waiting)</strong></div>
        <div><span>执行中</span><strong>@_tasks.Values.Count(x => x.Status is RcsTaskStatus.Running or RcsTaskStatus.Paused or RcsTaskStatus.Cancelling)</strong></div>
    </section>

    <div class="tasks-toolbar">
        <label><span>搜索</span><input @bind="_search" @bind:event="oninput" placeholder="任务组、任务编号、车辆或容器" /></label>
        <label><span>任务状态</span><select @bind="_statusFilter"><option value="">全部状态</option><option value="WAITING">待分配</option><option value="RUNNING">执行中</option><option value="PAUSED">已暂停</option><option value="COMPLETED">已完成</option><option value="FAILED">失败</option><option value="CANCELLED">已取消</option><option value="INTERRUPTED">已中断</option></select></label>
        <small>@(Realtime.IsConnected ? "● 实时更新已连接" : "○ 等待实时连接") · 最近 500 条任务</small>
    </div>

    @if (_error != "") { <div class="tasks-error" role="alert">@_error</div> }
    @if (_loading && _tasks.Count == 0) { <div class="tasks-empty">正在读取 RCS 任务…</div> }
    else if (VisibleTasks.Count == 0) { <div class="tasks-empty">@(_tasks.Count == 0 ? "当前没有已接收的 RCS 任务。" : "没有符合搜索条件的任务。")</div> }
    else
    {
        <div class="unified-task-list">
            @foreach (var task in VisibleTasks)
            {
                var vehicle = _vehicles.GetValueOrDefault(task.VehicleId);
                var start = task.StationCode.FirstOrDefault() ?? "—";
                var end = task.StationCode.LastOrDefault() ?? "—";
                <details class="unified-task-card" @key="task.TaskId">
                    <summary class="unified-task-summary">
                        <div class="unified-task-id"><small>@(task.Source == RcsTaskSource.Manual ? "手动任务" : "上游原始任务") · @task.TaskType</small><strong title="@task.TaskId">@task.TaskId</strong></div>
                        <div class="summary-route"><small>起点 → 终点</small><strong title="@start → @end">@start <span>→</span> @end</strong></div>
                        <div class="summary-fact"><small>货物 / 托盘</small><strong title="@task.ContainerCode">@(task.ContainerCode == "" ? "—" : task.ContainerCode)</strong></div>
                        <div class="summary-fact"><small>执行车辆</small><strong>@(task.VehicleId == "" ? "待分配" : task.VehicleId)</strong></div>
                        <span class="task-status @StatusClass(task.Status)">@StatusText(task.Status)</span>
                        <span class="task-expand-mark" aria-hidden="true">⌄</span>
                    </summary>
                    <div class="unified-task-content">
                    @if (task.ExecutionStages.Count > 0)
                    {
                        <div class="unified-stage-section"><div class="section-caption">RCS 执行阶段 <span>@task.ExecutionStages.Count 个阶段</span></div>
                            <ol class="task-execution-stages">
                                @foreach (var stage in task.ExecutionStages.OrderBy(x => x.Sequence))
                                {
                                    <li class="@StageClass(stage.Status)">
                                        <div class="stage-mark">@(stage.Status == RcsTaskExecutionStageStatus.Completed ? "✓" : stage.Status == RcsTaskExecutionStageStatus.Failed ? "!" : stage.Sequence.ToString())</div>
                                        <div class="stage-main"><div class="stage-heading"><strong>@stage.Sequence · @stage.Name</strong><span class="task-status @StageStatusClass(stage.Status)">@StageStatusText(stage.Status)</span></div>
                                            <div class="stage-route">@stage.FromPointCode → @stage.ToPointCode @if (stage.Action != "") { <b>· @ActionText(stage.Action)</b> }</div>
                                            <small>车辆 @stage.VehicleId @if (stage.CommandId != "") { <span>· 命令 @stage.CommandId</span> }</small>
                                            <small>@if (stage.StartedAt is not null) { <span>开始 @stage.StartedAt</span> } @if (stage.FinishedAt is not null) { <span> · 结束 @stage.FinishedAt</span> }</small>
                                            @if (stage.Message != "") { <small class="stage-message">@stage.Message</small> }
                                        </div>
                                    </li>
                                }
                            </ol>
                        </div>
                    }
                    else
                    {
                        <div class="unified-stage-section"><div class="section-caption">任务进度 <span>实时状态</span></div>
                            <ol class="task-timeline">
                                @foreach (var step in Timeline(task, vehicle))
                                {
                                    <li class="@step.State"><span class="timeline-node">@(step.State == "done" ? "✓" : step.State == "failed" ? "!" : step.Number.ToString())</span><span class="timeline-copy"><strong>@step.Title</strong><small>@step.Detail</small></span></li>
                                }
                            </ol>
                        </div>
                    }
                    @if (task.Message != "")
                    {
                        <div class="internal-message">@task.Message</div>
                    }
                    <section class="original-payload">
                        <div class="section-caption">@(task.Source == RcsTaskSource.Manual ? "手动任务参数" : "上游系统原始报文")</div>
                        <pre>@TaskParameterJson(task)</pre>
                    </section>
                    </div>
                </details>
            }
        </div>
    }
</div>

@code {
    private static readonly JsonSerializerOptions PrettyJson = new() { WriteIndented = true };
    private readonly CancellationTokenSource _lifetime = new();
    private readonly Dictionary<string, RcsTaskDto> _tasks = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, VehicleStateDto> _vehicles = new(StringComparer.OrdinalIgnoreCase);
    private string _search = "", _statusFilter = "", _error = "";
    private bool _loading, _disposed;
    private List<TaskGroup> TaskGroups => _tasks.Values
        .GroupBy(x => (x.GroupId, x.MsgTime))
        .Select(group => new TaskGroup($"{group.Key.GroupId}|{group.Key.MsgTime}", group.Key.GroupId, group.Key.MsgTime,
            group.OrderBy(x => x.CreatedAt, StringComparer.Ordinal).ToArray()))
        .OrderByDescending(group => group.Tasks.Max(x => x.CreatedAt), StringComparer.Ordinal).ToList();
    private int UpstreamGroupCount => TaskGroups.Count;
    private int UpstreamTasksCount => _tasks.Count;
    private List<RcsTaskDto> VisibleTasks => _tasks.Values.Where(Matches)
        .OrderByDescending(x => x.CreatedAt, StringComparer.Ordinal).ToList();

    protected override async Task OnInitializedAsync()
    {
        try { var saved = await Js.InvokeAsync<string?>("localStorage.getItem", "rcs_backend_url"); if (!string.IsNullOrWhiteSpace(saved)) Api.SetBaseUrl(saved); } catch { }
        Realtime.TaskChanged += OnTaskChanged; Realtime.VehicleStateChanged += OnVehicleStateChanged;
        Realtime.VehiclesChanged += OnVehiclesChanged;
        Realtime.Reconnected += OnReconnected;
        await RefreshAsync();
        if (_disposed) return;
        Realtime.SetBaseUrl(Api.BaseUrl);
        try { await Realtime.StartAsync(); } catch { }
    }

    private async Task RefreshAsync()
    {
        if (_loading || _disposed) return;
        _loading = true; _error = "";
        try
        {
            var tasksRequest = Api.GetTasksAsync(500, _lifetime.Token);
            var vehiclesRequest = Api.GetVehiclesAsync(_lifetime.Token);
            var tasks = await tasksRequest;
            _tasks.Clear(); foreach (var task in tasks) _tasks[task.TaskId] = task;
            await InvokeAsync(StateHasChanged);
            var vehicles = await vehiclesRequest;
            _vehicles.Clear(); foreach (var vehicle in vehicles) _vehicles[vehicle.Id] = vehicle;
            if (!Realtime.IsConnected) { Realtime.SetBaseUrl(Api.BaseUrl); try { await Realtime.StartAsync(); } catch { } }
        }
        catch (OperationCanceledException) when (_disposed) { }
        catch (Exception ex) when (!_disposed) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private Task RefreshAsyncFromHub() => InvokeAsync(RefreshAsync);
    private void OnReconnected() => _ = RefreshAsyncFromHub();
    private void OnTaskChanged(RcsTaskDto task) => _ = InvokeAsync(() => { if (!_disposed) { _tasks[task.TaskId] = task; StateHasChanged(); } });
    private void OnVehicleStateChanged(VehicleStateDto vehicle) => _ = InvokeAsync(() => { if (!_disposed) { _vehicles[vehicle.Id] = vehicle; StateHasChanged(); } });
    private void OnVehiclesChanged(IReadOnlyList<VehicleStateDto> vehicles) => _ = InvokeAsync(() =>
    {
        if (_disposed) return;
        _vehicles.Clear(); foreach (var vehicle in vehicles) _vehicles[vehicle.Id] = vehicle;
        StateHasChanged();
    });
    private bool Matches(RcsTaskDto task) => (_statusFilter == "" || task.Status == _statusFilter)
        && (_search.Trim() == "" || string.Join(' ', task.GroupId, task.TaskId, task.VehicleId, task.RequestedVehicleId,
            task.ContainerCode, task.Warehouse, task.TaskType, string.Join(' ', task.StationCode), string.Join(' ', task.AreaCode))
            .Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));

    private static string StatusText(string status) => status switch
    {
        RcsTaskStatus.Waiting => "待分配", RcsTaskStatus.Running => "执行中", RcsTaskStatus.Paused => "已暂停",
        RcsTaskStatus.Cancelling => "取消中", RcsTaskStatus.Completed => "已完成", RcsTaskStatus.Failed => "失败",
        RcsTaskStatus.Cancelled => "已取消", RcsTaskStatus.Interrupted => "已中断", _ => status
    };
    private static string StatusClass(string status) => status switch
    {
        RcsTaskStatus.Completed => "status-done", RcsTaskStatus.Waiting => "status-waiting",
        RcsTaskStatus.Failed or RcsTaskStatus.Cancelled or RcsTaskStatus.Interrupted => "status-error",
        RcsTaskStatus.Paused or RcsTaskStatus.Cancelling => "status-paused", _ => "status-running"
    };

    private static string StageStatusText(string status) => status switch
    {
        RcsTaskExecutionStageStatus.Waiting => "待执行", RcsTaskExecutionStageStatus.Running => "执行中",
        RcsTaskExecutionStageStatus.Completed => "已确认", RcsTaskExecutionStageStatus.Failed => "失败",
        RcsTaskExecutionStageStatus.Cancelled => "已取消", _ => status
    };
    private static string StageStatusClass(string status) => status switch
    {
        RcsTaskExecutionStageStatus.Waiting => "status-waiting", RcsTaskExecutionStageStatus.Running => "status-running",
        RcsTaskExecutionStageStatus.Completed => "status-done", _ => "status-error"
    };
    private static string StageClass(string status) => status switch
    {
        RcsTaskExecutionStageStatus.Completed => "stage-done", RcsTaskExecutionStageStatus.Running => "stage-current",
        RcsTaskExecutionStageStatus.Failed or RcsTaskExecutionStageStatus.Cancelled => "stage-failed", _ => "stage-waiting"
    };
    private static string ActionText(string action) => action switch { "fetch" => "取货", "put" => "放货", _ => "移动" };
    private static string ActionCodeAt(RcsTaskDto task, int index, bool isEnd)
    {
        if (index < task.StationActions.Count && !string.IsNullOrWhiteSpace(task.StationActions[index]))
            return task.StationActions[index];
        if (task.TaskType is "INBOUND" or "OUTBOUND")
            return isEnd ? "put" : "fetch";
        return "move";
    }

    private static string TaskParameterJson(RcsTaskDto task)
    {
        if (task.Source != RcsTaskSource.Manual)
            return string.IsNullOrWhiteSpace(task.OriginalRequestJson)
                ? "该任务创建于原始报文留存功能启用前，数据库中没有保存上游原始报文。"
                : task.OriginalRequestJson;

        var startIndex = 0;
        var endIndex = Math.Max(0, task.StationCode.Count - 1);
        return JsonSerializer.Serialize(new
        {
            GroupId = task.GroupId,
            TaskId = task.TaskId,
            MsgTime = task.MsgTime,
            PriorityCode = task.PriorityCode,
            Warehouse = task.Warehouse,
            VehicleId = string.IsNullOrWhiteSpace(task.RequestedVehicleId) ? task.VehicleId : task.RequestedVehicleId,
            TaskType = task.TaskType,
            ContainerCode = task.ContainerCode,
            StartStationCode = task.StationCode.FirstOrDefault() ?? "",
            StartAction = ActionCodeAt(task, startIndex, isEnd: false),
            EndStationCode = task.StationCode.LastOrDefault() ?? "",
            EndAction = ActionCodeAt(task, endIndex, isEnd: true)
        }, PrettyJson);
    }

    private static IReadOnlyList<TimelineStep> Timeline(RcsTaskDto task, VehicleStateDto? vehicle)
    {
        var stops = task.StationCode;
        var start = stops.FirstOrDefault() ?? "";
        var end = stops.LastOrDefault() ?? "";
        var firstDone = vehicle?.CompletedStepIds.Contains($"{task.TaskId}:0", StringComparer.Ordinal) == true;
        var lastDone = vehicle?.CompletedStepIds.Contains($"{task.TaskId}:{Math.Max(0, stops.Count - 1)}", StringComparer.Ordinal) == true;
        var atStart = vehicle?.TaskId == task.TaskId && vehicle.PointCode == start;
        var atEnd = vehicle?.TaskId == task.TaskId && vehicle.PointCode == end;
        var terminal = task.Status is RcsTaskStatus.Completed or RcsTaskStatus.Failed or RcsTaskStatus.Cancelled or RcsTaskStatus.Interrupted;
        var current = task.Status == RcsTaskStatus.Waiting ? 0
            : task.VehicleId == "" ? 1
            : task.Status == RcsTaskStatus.Completed ? 6
            : task.RoutePointCodes.Count == 0 ? 1
            : !firstDone ? (atStart ? 3 : 2)
            : !lastDone ? (atEnd ? 5 : 4)
            : 6;
        if (task.Status == RcsTaskStatus.Cancelled && task.VehicleId == "") current = 1;
        var startAction = task.TaskType is "INBOUND" or "OUTBOUND" ? "取货动作" : "起点动作（move）";
        var endAction = task.TaskType is "INBOUND" or "OUTBOUND" ? "放货动作" : "终点动作（move）";
        var titles = new[] { "收到任务，等待分配", "分配给车辆", "车辆从当前位置前往起点", $"车辆在起点执行{startAction}", "车辆从起点前往终点", $"车辆在终点执行{endAction}", "任务完成" };
        var details = new[]
        {
            task.Status == RcsTaskStatus.Waiting ? "已接收，正在等待调度器分配。" : $"上游任务 {task.GroupId} 已被 RCS 接收。",
            task.VehicleId == "" ? "尚未分配车辆。" : $"已分配车辆 {task.VehicleId}。",
            start == "" ? "报文未提供起点站。" : vehicle is null ? $"目标起点 {start}，等待车辆状态。" : $"当前 {vehicle.PointCode} · 目标 {start}。",
            start == "" ? "无起点站动作。" : $"站点 {start} · {(task.TaskType is "INBOUND" or "OUTBOUND" ? "fetch" : "move")}。",
            start == "" || end == "" ? "报文未提供完整起终点。" : $"{start} → {end} · 路径 {task.RoutePointCodes.Count} 点。",
            end == "" ? "无终点站动作。" : $"站点 {end} · {(task.TaskType is "INBOUND" or "OUTBOUND" ? "put" : "move")}。",
            task.FinishedAt is null ? "等待车辆完成终点动作。" : $"完成时间 {task.FinishedAt}。"
        };
        return Enumerable.Range(0, 7).Select(index => new TimelineStep(index + 1, titles[index], details[index],
            task.Status == RcsTaskStatus.Completed || index < current ? "done"
            : index == current && task.Status == RcsTaskStatus.Failed ? "failed"
            : index == current && !terminal ? "current"
            : index == current && task.Status is RcsTaskStatus.Cancelled or RcsTaskStatus.Interrupted ? "failed" : "pending")).ToArray();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true; _lifetime.Cancel(); _lifetime.Dispose();
        Realtime.TaskChanged -= OnTaskChanged; Realtime.VehicleStateChanged -= OnVehicleStateChanged;
        Realtime.VehiclesChanged -= OnVehiclesChanged;
        Realtime.Reconnected -= OnReconnected;
        await Task.CompletedTask;
    }

    private sealed record TaskGroup(string Key, string GroupId, string MsgTime, RcsTaskDto[] Tasks)
    {
        public string Warehouse => Tasks.FirstOrDefault()?.Warehouse ?? "";
    }
    private sealed record TimelineStep(int Number, string Title, string Detail, string State);
}
