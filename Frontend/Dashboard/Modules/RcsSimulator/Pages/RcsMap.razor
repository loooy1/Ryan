@page "/rcs/map"
@using Contracts.Rcs.Inventory
@using Contracts.Rcs.Map
@using Contracts.Rcs.Route
@using Contracts.Rcs.Vehicle
@using Contracts.Rcs.Tasks
@using Dashboard.Modules.RcsSimulator.Components
@inject RcsApiClient Api
@inject RcsMapCacheService MapCache
@inject RcsRealtimeHubClient Realtime
@inject IJSRuntime Js
@implements IAsyncDisposable

<PageTitle>RCS 地图与路径</PageTitle>

<div class="rcs-runtime-page" @onpointerdown="ClosePickMenu" @onwheel="ClosePickMenu">
    <div class="runtime-header">
        <div><div class="runtime-kicker">RCS / MAP & ROUTE</div><h1>地图与路径</h1><p>选中运行中的车辆可查看完整任务路径和当前锁点；重合时可选对象。中键或右键拖动，滚轮缩放。</p></div>
        <div class="runtime-actions">
            <button @onclick="() => ReloadAsync(forceReload: true)" disabled="@(_saving || _vehicleBusy || _showMoveDialog)">↻ 刷新地图</button>
            <button @onclick="Preview" disabled="@(!CanCalculate || _showMoveDialog)">计算路径</button>
        </div>
    </div>
    <div class="runtime-layout">
        <section class="runtime-map">
            <div class="runtime-map-bar">
                <div><strong>@(_editor?.Name ?? "未加载地图")</strong><small>@(_editor is null ? "无当前地图" : $"{_editor.Points.Count} 个点 · {_editor.Lines.Count} 条路径")</small></div>
                <div class="runtime-zoom"><button @onclick="ZoomOut" title="缩小">−</button><button @onclick="FitMap" title="适应地图">⌂</button><button @onclick="ZoomIn" title="放大">＋</button></div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_inventoryError))
            {
                <div class="runtime-inventory-error" role="status">库存读取失败：@_inventoryError</div>
            }
            <div id="rcs-runtime-map-host" class="runtime-canvas-host">
                <canvas aria-label="RCS 地图与路径画布"></canvas>
                <svg aria-hidden="true"></svg>
                @if (_showMoveDialog && SelectedVehicle is { } movingCar)
                {
                    <RcsMoveTaskDialog @key="movingCar.Id" @ref="_moveTaskDialog" Vehicle="movingCar" Warehouse="@(_editor?.SceneName ?? "")" MapCode="@(_editor?.MapCode ?? "")" Points="VehiclePoints" Disabled="@(_saving || _dirty)"
                        PointsChanged="OnMovePointsChanged" BusyChanged="OnVehicleBusyChanged" Completed="OnMoveCompleted" CloseRequested="CloseMoveDialog" />
                }
                @if (_pickMenuOpen)
                {
                    <div class="runtime-pick-menu" style="@PickMenuStyle" role="menu" aria-label="选择地图元素" tabindex="-1" @ref="_pickMenu"
                         @onpointerdown:stopPropagation @onclick:stopPropagation @onwheel:stopPropagation @onkeydown="OnPickMenuKeyDown">
                        <div class="pick-menu-title">选择要操作的对象</div>
                        @foreach (var vehicle in PickVehicles)
                        {
                            <button role="menuitem" @onclick="() => SelectVehicle(vehicle.Id)"><span class="pick-icon vehicle">▰</span><span>选中车辆 @vehicle.Id<small>@vehicle.Name</small></span></button>
                        }
                        @foreach (var point in PickPoints)
                        {
                            <button role="menuitem" @onclick="() => OnMapEditorStationClicked(point.PointCode)"><span class="pick-icon station">◇</span><span>选中站点 @point.PointCode</span></button>
                        }
                        <button class="pick-cancel" role="menuitem" @onclick="ClosePickMenu">取消</button>
                    </div>
                }
                @if (_editor is null)
                {
                    <div class="runtime-empty">@(_loading ? "正在读取地图…" : "没有当前地图，请在编辑地图中保存已发布地图。")</div>
                }
            </div>
            <div class="runtime-legend"><span>空储位</span><span class="transfer">接驳位</span><span class="people">人工分拣台</span><span class="sorting">分拣台</span><span>路径点</span><span class="elevator">跨层点</span><span class="charging">充电点</span><span class="inventory-pallet">纯托盘</span><span class="inventory-cargo">纯货物</span><span class="inventory-loaded">货物在托盘上</span><span class="lock-point">锁定点与路径</span><span class="full-route">完整任务路径</span></div>
        </section>
        <aside class="runtime-side">
            @if (SelectedVehicle is { } car)
            {
                <section class="runtime-card selected-vehicle-card" aria-label="选中车辆操作">
                    <div class="runtime-card-title">车辆操作 <small>@VehicleStatus(car)</small></div>
                    <div class="selected-vehicle-title"><strong>@car.Id</strong><span>@car.Name</span></div>
                    <div class="vehicle-position"><span>当前位置</span><strong>@(car.PointCode == "" ? "未定位" : car.PointCode)</strong><small>X @car.X.ToString("0.##") · Y @car.Y.ToString("0.##") · 楼层 @car.Z.ToString("0")</small></div>
                    <div class="selected-vehicle-meta"><span>通讯状态</span><b class="@(car.IsOnline ? "telemetry-online" : "telemetry-offline")">@(car.IsOnline ? "在线" : "离线")</b><span>电量</span><b>@(car.BatteryPercent is { } battery ? $"{battery:0.#}%" : "暂无数据")</b><span>故障</span><b class="@(car.ErrorCode == "" ? "" : "telemetry-error")">@(car.ErrorCode == "" ? "无" : $"{car.ErrorCode} {car.ErrorMessage}".Trim())</b><span>当前任务</span><b>@(car.Status is "Running" or "Paused" ? car.TaskId : "—")</b><span>路径进度</span><b>@car.RouteIndex / @car.RouteLength</b><span>车上容器</span><b>@(car.LoadedContainerCode == "" ? "无" : car.LoadedContainerCode)</b></div>
                    <div class="vehicle-route-detail"><span>完整路径 · @(SelectedVehicleTask?.RoutePointCodes.Count ?? 0) 点</span><strong>@FormatPath(SelectedVehicleTask?.RoutePointCodes)</strong></div>
                    <div class="vehicle-route-detail locked"><span>当前锁定 · @car.LockedPointCodes.Count 点 / @car.LockedLineCodes.Count 段</span><strong>@FormatPath(car.LockedPointCodes)</strong></div>
                    <div class="vehicle-mode-control"><span>运行模式</span><strong class="@(car.OperatingMode == RcsOperatingMode.Manual ? "manual" : "automatic")">@(car.OperatingMode == RcsOperatingMode.Manual ? "手动" : "自动")</strong>
                        <button @onclick="ToggleVehicleModeAsync" disabled="@(_saving || _vehicleBusy || _showMoveDialog || car.Status is "Running" or "Paused")">切换为 @(car.OperatingMode == RcsOperatingMode.Manual ? "自动" : "手动")</button>
                    </div>
                    <RcsVehicleOperations Vehicle="car" Disabled="@(_saving || _showMoveDialog)" AllowMove="@(!_dirty && car.OperatingMode == RcsOperatingMode.Manual)"
                        MoveHint="@(car.OperatingMode == RcsOperatingMode.Manual ? "地图属性修改后请先保存，再下发移动任务。" : "该车处于自动模式，由调度器接收并执行任务。")" MoveRequested="OpenMoveDialog"
                        BusyChanged="OnVehicleBusyChanged" Completed="OnVehicleOperationCompleted" Failed="OnVehicleOperationFailed" />
                    <a class="vehicle-management-link" href="rcs/vehicles">车辆配置与管理 →</a>
                </section>
            }
            else if (_selectedPoint is not null || _selectedLine is not null)
            {
                <section class="runtime-card" aria-label="@(_selectedPoint is not null ? "站点操作" : "路径操作")">
                    <div class="runtime-card-title">@(_selectedPoint is not null ? "站点操作" : "路径操作") @if (_dirty) { <small>待保存</small> }</div>
                    <fieldset disabled="@_saving" class="runtime-properties">
                        <RcsElementProperties Point="_selectedPoint" Line="_selectedLine" RuntimeMode="true" Changed="OnPropertiesChanged" />
                    </fieldset>
                    @if (_selectedPoint is not null)
                    {
                        <div class="runtime-actions point-actions"><button @onclick="SetStart" disabled="@(!_selectedPoint.IsEnabled)">设为起点</button><button @onclick="SetEnd" disabled="@(!_selectedPoint.IsEnabled)">设为终点</button></div>
                        <RcsStationInventoryPanel MapCode="@_editor!.MapCode" Point="_selectedPoint" Points="@_editor!.Points" Changed="OnInventoryChanged" />
                    }
                    <button class="save-properties" @onclick="SavePropertiesAsync" disabled="@(!_dirty || _saving)">@(_saving ? "保存中…" : "保存属性")</button>
                </section>
            }
        </aside>
    </div>
    @if (!string.IsNullOrEmpty(_feedback)) { <div class="runtime-feedback @(_feedbackError ? "error" : "success")" role="status">@_feedback</div> }
</div>
